			<imageCheckBox name="vcapbloodPool_43" left="76" top="164" width="25" height="25" checked="true" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="vcapbloodPool_44" left="102" top="164" width="25" height="25" checked="true" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="vcapbloodPool_45" left="128" top="164" width="25" height="25" checked="true" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="vcapbloodPool_46" left="154" top="164" width="25" height="25" checked="true" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="vcapbloodPool_47" left="180" top="164" width="25" height="25" checked="true" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="vcapbloodPool_48" left="206" top="164" width="25" height="25" checked="true" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="vcapbloodPool_49" left="232" top="164" width="25" height="25" checked="true" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="vcapbloodPool_50" left="258" top="164" width="25" height="25" checked="true" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
		</layout>

		<!-- The rest of the band follows the pool at 218 (SPEC I189f, Q108.4): each box keeps its width
		     and re-centres its content in the 90 it gained - the turn number and the weakness text grow
		     by 90, the experience field moves 45 down - except the weakness box, stretched so the band
		     still closes on 1408, the third column's edge.

		     TWO STACKS since the 48th batch (SPEC I191f/g, user 2026-10-01): the second and the fourth
		     column are two boxes each, 106 + 5 + 107, on exactly the room the one box had, so nothing
		     around them moves (SPEC V533b). The blood a turn on top and MAX TRAIT LEVEL under it - the
		     generation's ceiling, the same number that locks the Disciplines and, for a vampire, the
		     attributes and abilities too; both come off vampGen() through renderVampCaps (SPEC V529b,
		     V536a). The titles that cannot hold one line at these widths wrap to two: wordWrap, and
		     "leading" so a one-line title still sits on the same y as its neighbours' (SPEC V16). -->
		<layout left="312" top="10" width="200" height="106">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="160" height="20" text="BLOOD PER TURN" horzTextAlign="center"/>
			<label name="dynBloodTurn" left="20" top="40" width="160" height="51" fontSize="28" horzTextAlign="center" vertTextAlign="center"/>
		</layout>

		<layout left="312" top="121" width="200" height="107">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="160" height="34" text="MAX TRAIT LEVEL" wordWrap="true" horzTextAlign="center" vertTextAlign="leading"/>
			<!-- The number sits where the one above sits (user 2026-10-02, SPEC I193g, V536a): the same
			     rect as dynBloodTurn on the same 15 foot. Its top runs into the tail of the title's
			     two-line rect, never into the text: the second line ends near 47 and the digits start
			     near 52. -->
			<label name="dynMaxTraitV" left="20" top="41" width="160" height="51" fontSize="28" horzTextAlign="center" vertTextAlign="center"/>
		</layout>

		<!-- The weakness of the vampire's CLAN since the 47th batch (SPEC I190j, user 2026-10-01): the
		     clan picked on the Main writes clanFamily, and renderRevWeakness hands this label the clan's
		     Weakness paragraph out of descClan_<lang>.lua. The Ghoul tab's copy keeps the revenant
		     FAMILY's (SPEC Q107.5). -->
		<layout left="517" top="10" width="755" height="218">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="715" height="20" text="CLAN/BLOODLINE WEAKNESS" horzTextAlign="center"/>

			<label name="dynRevWeaknessV" left="20" top="40" width="715" height="163" wordWrap="true" fontSize="12" horzTextAlign="center" vertTextAlign="center"/>
		</layout>

		<!-- Current and Spent, mirroring the Progress tab's two (SPEC I191g/h, user 2026-10-01). Spent
		     is authored LOCKED like edtSpentXP and xpPaint moves the lock with the storyteller's flag
		     on the same line for both (SPEC V245); typing here writes a manual line into the log
		     through xpSetSpent, never a second number (SPEC V246). -->
		<layout left="1277" top="10" width="131" height="106">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="91" height="34" text="CURRENT EXPERIENCE" wordWrap="true" horzTextAlign="center" vertTextAlign="leading"/>

			<rectangle name="bgCurrentXPVampire" left="20" top="60" width="91" height="25" color="#0A0A0A" xradius="6" yradius="6" cornerType="innerRound" hitTest="false"/>
			<edit name="edtCurrentXPVampire" type="number" decimalPlaces="0" left="20" top="60" width="91" height="25" horzTextAlign="center" vertTextAlign="center" fontSize="14" onUserChange="xpSetCurrent(self, self.edtCurrentXPVampire.text);" transparent="true"/>
		</layout>

		<layout left="1277" top="121" width="131" height="107">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="91" height="34" text="SPENT EXPERIENCE" wordWrap="true" horzTextAlign="center" vertTextAlign="leading"/>

			<rectangle name="bgSpentXPVampire" left="20" top="61" width="91" height="25" color="#0A0A0A" xradius="6" yradius="6" cornerType="innerRound" hitTest="false"/>
			<edit name="edtSpentXPVampire" type="number" decimalPlaces="0" left="20" top="61" width="91" height="25" readOnly="true" opacity="0.75" horzTextAlign="center" vertTextAlign="center" fontSize="14" transparent="true" onUserChange="xpSetSpent(self, self.edtSpentXPVampire.text);"/>
		</layout>

		<!-- The three columns stand at the Ghoul tab's x (0, 471, 942), 90 lower: the band above them
		     is 218 since the 46th batch (SPEC I189f, V533c). A row of nine keeps the row's 426: the ? at
		     0, the name 171 wide at 25, the dots from 201 to 426.

		     Each column is exactly as tall as what it holds - 601, two boxes of 151 + 5 + 445 or the one
		     of RITUALS - since the 50th batch (user 2026-10-02, SPEC I193h, V539, B193). The copy of the
		     Ghoul tab brought 680, and the scroll box scrolled the 79 nobody could see. -->
		<layout left="0" top="233" width="466" height="601">
			<template name="VDiscRow">
				<button name="btnQV$(field)" left="0" top="2" width="20" height="20" text="?" onClick="popOpen(self, 'Disc', sheet['$(field)'], nil, '$(field)');"/>
