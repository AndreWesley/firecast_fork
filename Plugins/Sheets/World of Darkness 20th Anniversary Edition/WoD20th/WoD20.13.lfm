<?xml version="1.0" encoding="UTF-8"?>
<form name="frmWoD20_13" align="client" theme="dark">
	<script>
		<![CDATA[
			-- The DESCRIPTION pane went with this wave (SPEC V365d, I118d): a pane leaves in the round
			-- its own family gets the `?`, and both families here got one. The pane was what read a
			-- MARKED row, which is why every row carried a radioButton on pathSel; with no reader left
			-- the radio went too and the `?` took the 0..20 it held (user 2026-08-31, ask B). Nothing
			-- else moved: entry still at 25, dots still at 375 (SPEC V26).
			--
			-- descPath_en.lua / descPath_pt.lua stay on disk and the `?` reads them through descFor,
			-- the one reader (SPEC V381, V365e). The TEXT did not go with the window.
			function renderPathButtons(form)
				if sheet == nil or form == nil then return; end;

				local names = {};

				-- DERIVED, never a literal: a bound typed out here goes stale the day the box grows a row
				-- and nothing says so - the button simply stops being painted (SPEC V383b, B112).
				local secLast = SEC_PATH_ROWS - SEC_PATH_FREE_ROWS;

				for i = 1, MAIN_PATH_ROWS, 1 do names["dynmainPath_" .. i] = true; end;
				for i = 1, secLast, 1 do names["dynsecPath_" .. i] = true; end;

				local found = {};

				xpFind(tabRootOf(form), names, found);

				local lang = (sheet.language == "pt") and "pt" or "en";

				for i = 1, MAIN_PATH_ROWS, 1 do
					mfLabel(found["dynmainPath_" .. i], sheet["mainPath_" .. i], "Select Main Path", lang);
				end;

				for i = 1, secLast, 1 do
					mfLabel(found["dynsecPath_" .. i], sheet["secPath_" .. i], "Select Secondary Path", lang);
				end;
			end;
		]]>
	</script>

	<scrollBox align="client">
		<image name="themePaper13" align="client" style="stretch" hitTest="false" visible="false"/>

		<!--
			MAIN PATHS carry dots that are DISPLAY ONLY (SPEC V179): no field, no onClick,
			autoChange off, dimmed like every other read-only widget on the sheet (SPEC V111).
			A main path's rating IS its blood sorcery's rating (SPEC V180) - the discipline is
			what was paid for, so charging for the path too would bill one dot twice.

			They are painted from the discipline by renderMainPaths, which arrives with the
			BLOOD_SORCERY table in SPEC T435/T439. Until then they simply sit dark.
		-->
		<template name="MainPathRow">
			<button name="btnQ$(field)" left="0" top="2" width="20" height="20" text="?" onClick="popOpen(self, 'Path', sheet['$(field)'], nil, '$(field)');"/>
			<button name="dyn$(field)" left="25" top="0" width="345" height="25" text="Select Main Path" onClick="mfOpen(self, '$(field)', 'mainPath', 'Path');"/>
			<edit name="edt$(field)" left="25" top="0" width="345" height="25" field="$(field)" visible="false" enabled="false"/>
			<imageCheckBox name="ro_$(field)_1" left="375" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.40"/>
			<imageCheckBox name="ro_$(field)_2" left="400" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.40"/>
			<imageCheckBox name="ro_$(field)_3" left="425" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.40"/>
			<imageCheckBox name="ro_$(field)_4" left="450" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.40"/>
			<imageCheckBox name="ro_$(field)_5" left="475" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.40"/>
		</template>

		<!-- Secondary paths ARE bought, at the Trilha price of SPEC I9, capped at the blood
		     sorcery's rating minus one (SPEC V183, enforced in xpClick at SPEC T441). -->
		<template name="SecPathRow">
			<button name="btnQ$(field)" left="0" top="2" width="20" height="20" text="?" onClick="popOpen(self, 'Path', sheet['$(field)'], nil, '$(field)');"/>
			<button name="dyn$(field)" left="25" top="0" width="345" height="25" text="Select Secondary Path" onClick="mfOpen(self, '$(field)', 'secPath', 'Path');"/>
			<edit name="edt$(field)" left="25" top="0" width="345" height="25" field="$(field)" visible="false" enabled="false"/>
			<imageCheckBox left="375" top="0" width="25" height="25" field="$(field)_1" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('$(field)_1', self);"/>
			<imageCheckBox left="400" top="0" width="25" height="25" field="$(field)_2" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('$(field)_2', self);"/>
			<imageCheckBox left="425" top="0" width="25" height="25" field="$(field)_3" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('$(field)_3', self);"/>
			<imageCheckBox left="450" top="0" width="25" height="25" field="$(field)_4" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('$(field)_4', self);"/>
			<imageCheckBox left="475" top="0" width="25" height="25" field="$(field)_5" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('$(field)_5', self);"/>
		</template>


		<!-- FOUR slots since T879 (user 2026-09-01), and the box is short ON PURPOSE: V181 gives one
		     main path per blood sorcery and BLOOD_SORCERY holds six, so the sheet was already one
		     slot short and is now two. The user decided it with that cost on the table, to buy this
		     column closing on the same y as column 1 (SPEC I118f).

		     The height comes from the box law of I118f - 41 title band + 25*4 rows + 20 foot = 161 -
		     and it is spelled that way rather than as a remembered sum: the comment that stood here
		     read "25 + 5*25 + 25 = 175" while the attribute said 186, so the arithmetic in the file
		     had been wrong for longer than anyone noticed. -->
		<layout left="0" top="20" width="565" height="161">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="20" width="525" height="20" text="MAIN PATHS" horzTextAlign="center"/>
			<layout left="32" top="41" width="501" height="25">
				<MainPathRow field="mainPath_1"/>
			</layout>
			<layout left="32" top="66" width="501" height="25">
				<MainPathRow field="mainPath_2"/>
			</layout>
			<layout left="32" top="91" width="501" height="25">
				<MainPathRow field="mainPath_3"/>
			</layout>
			<layout left="32" top="116" width="501" height="25">
				<MainPathRow field="mainPath_4"/>
			</layout>
		</layout>

		<layout left="0" top="186" width="565" height="451">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="20" width="525" height="20" text="SECONDARY PATHS" horzTextAlign="center"/>
			<layout left="32" top="41" width="501" height="25">
				<SecPathRow field="secPath_1"/>
			</layout>
			<layout left="32" top="66" width="501" height="25">
				<SecPathRow field="secPath_2"/>
			</layout>
			<layout left="32" top="91" width="501" height="25">
				<SecPathRow field="secPath_3"/>
			</layout>
			<layout left="32" top="116" width="501" height="25">
				<SecPathRow field="secPath_4"/>
			</layout>
			<layout left="32" top="141" width="501" height="25">
				<SecPathRow field="secPath_5"/>
			</layout>
			<layout left="32" top="166" width="501" height="25">
				<SecPathRow field="secPath_6"/>
			</layout>
			<layout left="32" top="191" width="501" height="25">
				<SecPathRow field="secPath_7"/>
			</layout>
			<layout left="32" top="216" width="501" height="25">
				<SecPathRow field="secPath_8"/>
			</layout>
			<layout left="32" top="241" width="501" height="25">
				<SecPathRow field="secPath_9"/>
			</layout>
			<layout left="32" top="266" width="501" height="25">
				<SecPathRow field="secPath_10"/>
			</layout>
			<layout left="32" top="291" width="501" height="25">
				<SecPathRow field="secPath_11"/>
			</layout>
			<layout left="32" top="316" width="501" height="25">
				<SecPathRow field="secPath_12"/>
			</layout>
			<layout left="32" top="341" width="501" height="25">
				<SecPathRow field="secPath_13"/>
			</layout>
			<layout left="32" top="366" width="501" height="25">
				<SecPathRow field="secPath_14"/>
			</layout>
			<layout left="32" top="391" width="501" height="25">
				<SecPathRow field="secPath_15"/>
			</layout>
		</layout>
	</scrollBox>

	<dataLink fields="{'language', 'sheetTheme', 'mainPath_1', 'mainPath_2', 'mainPath_3', 'mainPath_4', 'secPath_1', 'secPath_2', 'secPath_3', 'secPath_4', 'secPath_5', 'secPath_6', 'secPath_7', 'secPath_8', 'secPath_9', 'secPath_10', 'secPath_11', 'secPath_12', 'secPath_13', 'secPath_14', 'secPath_15'}" onChange="renderPathButtons(self);"/>

	<!--
		The four main path dots follow the Discipline, recomputed on every render and stored
		nowhere (SPEC V180), so this link watches what renderMainPaths actually READS and
		nothing else (SPEC V123): the four path slots, the nineteen Discipline slots, and the
		dots of those nineteen - the rating is the dots, so a bought dot has to reach here.

		It is a link of its own rather than fields bolted onto the description link above:
		that one repaints prose from `language` and the picker rows, and hanging ninety-five
		dot fields on it would repaint the description every time anyone bought anything
		(SPEC V123, the mistake B34 records).
	-->
	<dataLink fields="{'mainPath_1', 'mainPath_2', 'mainPath_3', 'mainPath_4', 'clanDisc_1', 'clanDisc_2', 'clanDisc_3', 'clanDisc_4', 'disc_1', 'disc_2', 'disc_3', 'disc_4', 'disc_5', 'disc_6', 'disc_7', 'disc_8', 'disc_9', 'disc_10', 'disc_11', 'disc_12', 'disc_13', 'disc_14', 'disc_15', 'clanDisc_1_1', 'clanDisc_1_2', 'clanDisc_1_3', 'clanDisc_1_4', 'clanDisc_1_5', 'clanDisc_2_1', 'clanDisc_2_2', 'clanDisc_2_3', 'clanDisc_2_4', 'clanDisc_2_5', 'clanDisc_3_1', 'clanDisc_3_2', 'clanDisc_3_3', 'clanDisc_3_4', 'clanDisc_3_5', 'clanDisc_4_1', 'clanDisc_4_2', 'clanDisc_4_3', 'clanDisc_4_4', 'clanDisc_4_5', 'disc_1_1', 'disc_1_2', 'disc_1_3', 'disc_1_4', 'disc_1_5', 'disc_2_1', 'disc_2_2', 'disc_2_3', 'disc_2_4', 'disc_2_5', 'disc_3_1', 'disc_3_2', 'disc_3_3', 'disc_3_4', 'disc_3_5', 'disc_4_1', 'disc_4_2', 'disc_4_3', 'disc_4_4', 'disc_4_5', 'disc_5_1', 'disc_5_2', 'disc_5_3', 'disc_5_4', 'disc_5_5', 'disc_6_1', 'disc_6_2', 'disc_6_3', 'disc_6_4', 'disc_6_5', 'disc_7_1', 'disc_7_2', 'disc_7_3', 'disc_7_4', 'disc_7_5', 'disc_8_1', 'disc_8_2', 'disc_8_3', 'disc_8_4', 'disc_8_5', 'disc_9_1', 'disc_9_2', 'disc_9_3', 'disc_9_4', 'disc_9_5', 'disc_10_1', 'disc_10_2', 'disc_10_3', 'disc_10_4', 'disc_10_5', 'disc_11_1', 'disc_11_2', 'disc_11_3', 'disc_11_4', 'disc_11_5', 'disc_12_1', 'disc_12_2', 'disc_12_3', 'disc_12_4', 'disc_12_5', 'disc_13_1', 'disc_13_2', 'disc_13_3', 'disc_13_4', 'disc_13_5', 'disc_14_1', 'disc_14_2', 'disc_14_3', 'disc_14_4', 'disc_14_5', 'disc_15_1', 'disc_15_2', 'disc_15_3', 'disc_15_4', 'disc_15_5'}" onChange="renderMainPaths(self);"/>

	<!--
		The picker guard (SPEC V181/V182/V185). It hangs off a dataLink and NOT off the
		comboBox onChange, because a write made inside a control's own dispatch does not
		survive it - that is how B36 and B38 both let a refusal be ignored (SPEC V186).

		Only the nineteen picker fields are watched. Taking a Discipline OFF the sheet does
		not come through here on purpose: it would clear rows the player already filled,
		and the main path dots going dark already show that something is missing (V180).

		renderVampPickers USED to ride along here, to rebuild what the dropdowns offered after
		a row changed (SPEC I25, V200, V181). It went with the wave: it walked cbo* names and
		there are no combos on this tab any more, so it would have swept an empty set forever -
		dead code that compiles and lies about what runs (SPEC I130e is the same lesson about
		templates). The picker box does that work now, rebuilding its pool on every open from
		PICKER_LIST plus whatever the row is holding, illegal or not (SPEC V200, V346b).
	-->
	<dataLink fields="{'mainPath_1', 'mainPath_2', 'mainPath_3', 'mainPath_4', 'secPath_1', 'secPath_2', 'secPath_3', 'secPath_4', 'secPath_5', 'secPath_6', 'secPath_7', 'secPath_8', 'secPath_9', 'secPath_10', 'secPath_11', 'secPath_12', 'secPath_13', 'secPath_14', 'secPath_15'}" onChange="guardPick(field, oldValue, newValue);"/>

	<!-- The description block paints when the tab is SHOWN (SPEC I26 / V206): onNodeReady fires
	     on every open and dragged the whole 754 KB module in with it (SPEC B47). The other two
	     stay: they write no book text and pay no parse, and a tab that opened with unpainted
	     main-path dots or an unfiltered picker would be showing the wrong thing, not a blank
	     box (SPEC V180, V181). -->
	<event name="onShow">
		wodTrace("WoD20.13.onShow");
		renderPathButtons(self);
	</event>

	<event name="onNodeReady">
		renderMainPaths(self);
	</event>
</form>
