			-- ERA_NAME (SPEC I22). Dormant this round: T469 is what puts it on a picker's `items`.
			--
			-- Keyed by the CANONICAL value (SPEC V24), so the saved data never moves when the theme
			-- does - a Tremere who bought Lure of Flames still owns Lure of Flames after the sheet
			-- turns medieval; only the words on the row change. That is the whole reason this is a
			-- display table and not a second set of values (SPEC B23 is what happens otherwise).
			--
			-- Only DIVERGENCES live here. A value with no entry displays itself, which is why 20 rows
			-- cover a picker of 386 - the Dark Ages renamed a handful of things and reprinted the rest.
			--
			-- One table for BOTH medieval themes, Dark Ages and Classical Age (SPEC C), so there is no
			-- per-era key to fall out of step with applyTheme.
			--
			-- Ritual keys carry their level prefix because the prefix belongs to the value (SPEC V184).
			-- Blood Contract is NOT here: the Dark Ages prints it as level one and the core as level
			-- five, and the core wins (SPEC C), so the row reads "5. Blood Contract" in every era.
			local ERA_NAME = {
				-- >>> ERA_NAME_BEGIN (generated - SPEC T468)
				-- Thaumaturgy paths: the Dark Ages gives them Latin names (Dark Ages pp. 297-302).
				["Lure of Flames"]      = "Creatio Ignis (The Creation of Fire)",
				["Movement of the Mind"] = "Potestas Motus (Power of Motion)",
				["Weather Control"]     = "Potestas Tempestatum (Power Over Storms)",
				["Elemental Mastery"]   = "Potestas Elementorum (The Power of the Elements)",
				["The Path of Blood"]   = "Potestas Vitae (The Power of Lifeblood)",

				-- Necromancy paths: same path, the article moved (Dark Ages pp. 279-291).
				["Bone Path"]              = "The Path of Bone",
				["Cenotaph Path"]          = "The Path of the Cenotaph",
				["Corpse in the Monster"]  = "The Path of the Corpse in the Monster",
				["Grave’s Decay"]          = "The Grave’s Decay",
				["Path of Haunting"]       = "The Path of Haunting",
				["Sepulchre Path"]         = "The Path of the Sepulchre",
				["Ash Path"]               = "The Path of Ash",
				["Vitreous Path"]          = "The Vitreous Path",

				-- Koldunic path. The Black Hand (p. 170) is what ties the two names together:
				-- "the Genius Loci (known to the modern koldun as the Way of Spirit)".
				["The Way of the Spirit"] = "Genius Loci",

				-- Rituals. Level prefix kept on both sides - it is part of the value.
				["1. Encrypt Missive"]         = "1. Encrypt/Decrypt Missive",
				["2. The Hand of Glory"]       = "2. Hand of Glory",
				["2. Recure of the Homeland"]  = "2. Cure of the Homeland",
				["3. Tempesta Scudo"]          = "3. Tempest Shield",
				["4. Bastone Diabolico"]       = "4. Bastone del Diavolo",
				["5. Escape to a True Friend"] = "5. Escape to a True Haven",
				-- <<< ERA_NAME_END
			};

			-- The only reader of ERA_NAME (SPEC I22, T469), exported as a global for the same
			-- reason ERA_ABILITIES is: the table belongs on the root form and the pickers are
			-- repainted over on WoD20.6.
			--
			-- Total over every canonical value - a value with no row displays ITSELF - so the
			-- caller never has to ask whether an entry exists, and the twenty rows cover a picker
			-- of three hundred and eighty-four.
			--
			-- Both medieval themes read the same rows (SPEC C); the two modern ones read none, so
			-- the era is asked for by name rather than assumed from the presence of a row.
			function eraName(v, era)
				if era ~= "Dark Ages" and era ~= "Classical Age" then return v; end;

				return ERA_NAME[v] or v;
			end;

			-- Box geometry, named rather than written into the height sum further down: PITCH is
			-- the distance between two rows in the .lfm files and PAD is the room above the first
			-- row plus the room under the last. The gate measures the real row spacing in the XML
			-- and fails if it stops matching PITCH (SPEC V49) - the same Lua-vs-XML drift that
			-- produced B12 and B16.
			HEALTH_ROW_PITCH = 27;
			HEALTH_BOX_PAD   = 57;

			local function markIndex(v)
				for i = 1, #HEALTH_MARKS, 1 do
					if HEALTH_MARKS[i] == v then return i; end;
				end;

				-- nil, a boolean from a sheet saved before the 6th round, or anything else:
				-- reads as the empty mark, so a click always continues the cycle (SPEC V42).
				return 1;
			end;

			-- The track is always grouped, worst damage first (SPEC V46): every aggravated, then
			-- every lethal, then every bashing, then the empty rows - and never a gap between
			-- two marks. HEALTH_MARKS runs from empty to worst, so walking it backwards IS the
			-- severity order and there is no second list to drift from it (SPEC V47).
			--
			-- This only ever moves marks around: the count of each symbol before and after is
			-- the same, so regrouping is not healing and cannot hide damage.
			function regroupHealthMarks()
				if sheet == nil then return; end;

				local n = tonumber(sheet.healthLevels) or 7;
				local counts = {};

				for m = 1, #HEALTH_MARKS, 1 do counts[m] = 0; end;

				for i = 1, n, 1 do
					local at = markIndex(sheet["health_" .. i]);
					counts[at] = counts[at] + 1;
				end;

				local row = 1;

				for m = #HEALTH_MARKS, 2, -1 do
					for k = 1, counts[m], 1 do
						setField("health_" .. row, HEALTH_MARKS[m]);
						row = row + 1;
					end;
				end;

				while row <= n do
					setField("health_" .. row, HEALTH_MARKS[1]);
					row = row + 1;
				end;
			end;

			-- Clearing a mark is HEALING, and healing always comes off the BOTTOM of the track
			-- (SPEC V44): whatever row the player clicks, the last marked row is the one that
			-- empties, and the clicked row keeps what it was showing. Damage goes in anywhere,
			-- healing only ever comes off the end.
			--
			-- Only rows the player can see are eligible (SPEC V45). A mark stranded above the
			-- current track length - marked at 10 levels, then the track shortened to 7 - would
			-- otherwise eat the click and look like nothing happened.
			function healHealthMark()
				if sheet == nil then return; end;

				local n = tonumber(sheet.healthLevels) or 7;

				for i = n, 1, -1 do
					if markIndex(sheet["health_" .. i]) > 1 then
						setField("health_" .. i, HEALTH_MARKS[1]);
						return;
					end;
				end;
			end;

			-- Both tabs call this. The argument is the row number because the field name is
			-- positional (health_1 .. health_10, SPEC I3) - the row IS the identity.
			function cycleHealthMark(n)
				if sheet == nil then return; end;

				local at = markIndex(sheet["health_" .. n]);

				if at == #HEALTH_MARKS then
					-- Next symbol would be the empty one, so this click is a heal: the clicked
					-- row is left alone and the bottom-most mark goes instead (SPEC V44).
					healHealthMark();
				else
					setField("health_" .. n, HEALTH_MARKS[at + 1]);
				end;

				-- Upgrading a mark in the middle of the stack, or starting a new one on an empty
				-- row further down, leaves the track out of order - regroup puts the worse
				-- damage back on top (SPEC V46). Healing cannot break the order: dropping the
				-- last mark of a sorted list leaves it sorted.
				regroupHealthMarks();
			end;

			-- `form` is the tab form; `prefix` names its ten rows: the layout `<prefix>rowN`
			-- holds the level label `<prefix>N` and the clickable mark box.
			-- The `dyn` prefix is what tells the WoD20.6 traversal to leave them alone.
			function renderHealthTrack(form, prefix)
				if sheet == nil then return; end;

				local n = tonumber(sheet.healthLevels) or 7;
				local levels = HEALTH_LEVELS[n];
				local lang = sheet.language or "en";

				-- The black box ends right under the last visible row instead of always being
				-- ten rows tall (SPEC V49). It only ever shrinks: the .lfm declares the ten-row
				-- height, and ten is the top of the combo.
				local box = form[prefix .. "box"];

				if box ~= nil then
					local boxH = n * HEALTH_ROW_PITCH + HEALTH_BOX_PAD;

					box.height = boxH;

					-- AFTER the height, and the measurement is HANDED OVER rather than read back
					-- (SPEC I72e, V285c). Asking the box how tall it is on this side of the write
					-- can still answer with the track the storyteller just left - the redraw then
					-- compares equal and skips, which is exactly what B62 shipped. The width is
					-- authored and never written, so reading it is safe.
					--
					-- This is the only section box on the sheet whose size moves at runtime, and
					-- both tabs carry one: the prefix is what reaches dynHealth_box AND
					-- dynHealth3_box (SPEC V284c).
					refreshOrnament(box, box.width, boxH);
				end;

				for i = 1, 10, 1 do
					-- A sheet saved before the 6th round has a boolean here, which the mark
					-- label would render as "true". Normalise it once, on the first render that
					-- sees it (SPEC V42). Hidden rows are normalised too, so growing the track
					-- later cannot expose a stale value.
					local mark = sheet["health_" .. i];

					if mark ~= nil and mark ~= HEALTH_MARKS[1] and markIndex(mark) == 1 then
						setField("health_" .. i, HEALTH_MARKS[1]);
					end;
				end;

				-- A sheet marked before the 8th round has its marks in click order, so the first
				-- render groups them (SPEC V46). Normalisation runs first: a leftover boolean
				-- would otherwise be counted as a mark. This only moves marks, never drops one.
				regroupHealthMarks();

				for i = 1, 10, 1 do
					local row = form[prefix .. "row" .. i];
					local text = form[prefix .. i];

					if row ~= nil and text ~= nil then
						local canon = nil;

						if levels ~= nil then canon = levels[i]; end;

						if canon == nil then
							-- Rows past the chosen length, or an out-of-range value: hide the
							-- whole row, label and mark box together.
							row.visible = false;
						else
							row.visible = true;

							if lang == "pt" then
								text.text = HEALTH_PT[canon] or canon;
							else
								text.text = canon;
							end;
						end;
					end;
				end;
			end;

			-- ---- Era ability lists (SPEC I7 / V74 / V75, 21st round) --------------------
			--
			-- Each era shows its own ten abilities per column. A NAME is a trait: it owns one
			-- field and no other name shares it (SPEC V74), so two dots in Enigmas can never
			-- surface as two dots in Computer - that was B24, and before it B23.
			--
			-- The row is a SLOT. The renderer puts the era's name on it and rebinds the five
			-- dots to that name's field (SPEC V76); `imageCheckBox.field` has a setter in the
			-- SDK (SPEC R28), so nothing here needs Lua-owned dots or hidden rows.
			--
			-- Eleven of these fields are new in the 21st round and exist only at runtime: the
			-- XML authors the Victorian list, which is what a sheet shows if the renderer never
			-- runs - the base era, coherent, rather than half-bound (SPEC V19).
			--
			-- These live on the ROOT form for the same reason the health track does: the Combat
			-- tab reads them too, and a local in WoD20.6 does not cross forms (SPEC R.9 / B.9).
			THEME_DEFAULT = "Modern Nights";

			ABILITY_FIELD = {
				-- talents
				["Alertness"]     = "alertness",
				["Athletics"]     = "athletics",
				["Awareness"]     = "awareness",
				["Brawl"]         = "brawl",
				["Empathy"]       = "empathy",
				["Expression"]    = "expression",
				["Intimidation"]  = "intimidation",
				["Leadership"]    = "leadership",
				["Legerdemain"]   = "legerdemain",
				["Streetwise"]    = "streetwise",
				["Subterfuge"]    = "subterfuge",

				-- skills
				["Animal Ken"]    = "animalKen",
				["Archery"]       = "archery",
				["Commerce"]      = "commerce",
				["Crafts"]        = "crafts",
				["Drive"]         = "drive",
				["Etiquette"]     = "etiquette",
				["Firearms"]      = "firearms",
				["Larceny"]       = "larceny",
				["Melee"]         = "melee",
				["Performance"]   = "performance",
				["Ride"]          = "ride",
				["Stealth"]       = "stealth",
				["Survival"]      = "survival",

				-- knowledges
				["Academics"]     = "academics",
				["Computer"]      = "computer",
				["Enigmas"]       = "enigmas",
				["Finance"]       = "finance",
				["Hearth Wisdom"] = "hearthWisdom",
				["Investigation"] = "investigation",
				["Law"]           = "law",
				["Medicine"]      = "medicine",
				["Occult"]        = "occult",
				["Philosophy"]    = "philosophy",
				["Politics"]      = "politics",
				["Religion"]      = "religion",
				["Ritual"]        = "ritual",
				["Science"]       = "science",
				["Seneschal"]     = "seneschal",
				["Technology"]    = "technology",
				["Theology"]      = "theology",
			};

			-- Ten names per column per era, in reading order (alphabetical). The lists are the
			-- user's, from the 19th round; the 21st only stopped expressing them as renames of
			-- rows, which is what made ratings walk between traits.
			local BASE_TALENTS = {"Alertness", "Athletics", "Awareness", "Brawl", "Empathy", "Expression", "Intimidation", "Leadership", "Streetwise", "Subterfuge"};

			ERA_ABILITIES = {
				["Modern Nights"] = {
					talents    = BASE_TALENTS,
					skills     = {"Animal Ken", "Crafts", "Drive", "Etiquette", "Firearms", "Larceny", "Melee", "Performance", "Stealth", "Survival"},
					knowledges = {"Academics", "Computer", "Finance", "Investigation", "Law", "Medicine", "Occult", "Politics", "Science", "Technology"},
				},
				["Victorian Era"] = {
					talents    = BASE_TALENTS,
					skills     = {"Animal Ken", "Crafts", "Etiquette", "Firearms", "Larceny", "Melee", "Performance", "Ride", "Stealth", "Survival"},
					knowledges = {"Academics", "Enigmas", "Finance", "Investigation", "Law", "Medicine", "Occult", "Politics", "Science", "Technology"},
				},
				["Dark Ages"] = {
					talents    = {"Alertness", "Athletics", "Awareness", "Brawl", "Empathy", "Expression", "Intimidation", "Leadership", "Legerdemain", "Subterfuge"},
					skills     = {"Animal Ken", "Archery", "Commerce", "Crafts", "Etiquette", "Melee", "Performance", "Ride", "Stealth", "Survival"},
					knowledges = {"Academics", "Enigmas", "Hearth Wisdom", "Investigation", "Law", "Medicine", "Occult", "Politics", "Seneschal", "Theology"},
				},
				["Classical Age"] = {
					talents    = BASE_TALENTS,
					skills     = {"Animal Ken", "Archery", "Commerce", "Crafts", "Etiquette", "Melee", "Performance", "Ride", "Stealth", "Survival"},
					knowledges = {"Academics", "Hearth Wisdom", "Investigation", "Law", "Medicine", "Occult", "Philosophy", "Politics", "Religion", "Ritual"},
				},
			};

			-- The era in force, with the same fallback the palette uses (SPEC V52): a sheet
			-- saved before the 19th round carries `Modern` or `Classical Era`, neither of which
			-- is a key any more.
			function currentTheme()
				local v = nil;

				if sheet ~= nil then v = sheet.sheetTheme; end;
				if v == nil or ERA_ABILITIES[v] == nil then return THEME_DEFAULT; end;

				return v;
			end;

			-- The ranged skill of the era in force. Read off the era's own list rather than
			-- from a second table, so there is nothing to fall out of step with it (the same
			-- reason HEALTH_MARKS is declared once, SPEC V41). Dark Ages and the Classical Age
			-- fight with Archery; the other two carry Firearms.
			function eraRangedName()
				local list = ERA_ABILITIES[currentTheme()].skills;

				for i = 1, #list, 1 do
					if list[i] == "Firearms" or list[i] == "Archery" then return list[i]; end;
				end;

				return "Firearms";
			end;

			-- ---- Storyteller gate (SPEC I8a / V79 / V80, 27th round) --------------------
			--
			-- The Storyteller tab is the one place on this sheet a player must not reach, so
			-- the check fails CLOSED: no room (a sheet opened from the local library), no
			-- player object, or an API that raises all read as "not the storyteller" and the
			-- tab stays hidden. A gate that opened on error would leak the whole tab.
			--
			-- `Firecast.getMesaDe(sheet)` is what the Anime 5E sheet in this repo calls from
			-- inside a sheet .lfm, and `isMestre` is what the AfkBot plugin reads (SPEC R29).
			function isStoryteller()
				if sheet == nil then return false; end;

				local ok, res = pcall(function()
					local mesa = Firecast.getMesaDe(sheet);

					if mesa == nil then return false; end;

					local me = mesa.meuJogador;

					if me == nil then return false; end;

					return me.isMestre == true;
				end);

				return ok and res == true;
			end;

			-- Tabs are found by walking from the root and matching names, not by form.<name>:
			-- the calls come from WoD20.10 (the checkboxes) and WoD20.6 (the language switch), and a
			-- tab form cannot reach its siblings (SPEC R.9 / B.9).
			local function tabRootOf(ctrl)
				local p = ctrl;

				while true do
					local up = p:getParent();

					if up == nil then return p; end;

					p = up;
				end;
			end;


			-- SPEC I8b / V89. Numina reads `~= false` and the other two read `== true`: a
			-- sheet saved before this round has nil in all three, and Numina was always
			-- visible on it - defaulting it off would take away a tab the player already had.
			--
			-- Since the 78th round this paints the strip as well as gating it (SPEC I32). The two
			-- jobs are one function on purpose: "allowed" and "open" both decide whether a pane is
			-- on screen, and splitting them across two writers is how they end up disagreeing about
			-- the same control.
			function applyTabVisibility(from)
				if sheet == nil then return; end;

				-- Three managed tabs since the 39th round (SPEC V128): Magika was an empty
				-- window that Mage-only content was never going to fill on a mortal sheet, so
				-- the user had it removed. `stShowMagika` is a burned name from here on
				-- (SPEC I3, orphans) - nothing reads it and nothing may reuse it.
				local shown = {
					tabNumina      = sheet.stShowNumina ~= false,
					tabDisciplines = sheet.stShowDisciplines == true,
					tabStoryteller = isStoryteller(),
				};

				-- One sweep of the tree for all three names per tab, through the one finder there is
				-- (SPEC V143). collectTabs is gone with the <tab> it matched on class.
				local names = {};

				for i = 1, #TAB_LIST, 1 do
					names["tab" .. TAB_LIST[i]]    = true;
					names["btnTab" .. TAB_LIST[i]] = true;
					names["tabOn" .. TAB_LIST[i]]  = true;
				end;

				local found = {};

				xpFind(tabRootOf(from), names, found);

				-- SPEC V217, which revokes V93: recalculating visibility moves nobody. The jump to
				-- Main was paid on EVERY toggle by the one person who can toggle - the checkboxes
				-- live on the Storyteller tab (SPEC I8, V95), so hiding Numina threw the storyteller
				-- off the tab they were working on - to cover the rare reader who happened to be there
				-- on the tab as it went. That reader now stays put and finds the body EMPTY, never
				-- holding denied content. One click on any other tab leaves it.
				--
				-- SPEC R33 said there was no way to know which tab was open. That was true of the
				-- native strip and stopped being true when the strip became ours: `activeTab` is the
				-- answer now. The rule does not change - the user asked for never jumping - but it is
				-- a choice again rather than a limit.
				-- The cursor the reflow walks (SPEC I36, V232). It starts at the strip's left
				-- margin and only advances past a tab that is SHOWN, which is the whole of what
				-- "no hole" means here.
				local x = STRIP_X0;

				for i = 1, #TAB_LIST, 1 do
					local nm   = "tab" .. TAB_LIST[i];
					local want = shown[nm];

					if want == nil then want = true; end;

					local pane = found[nm];
					local btn  = found["btnTab" .. TAB_LIST[i]];
					local on   = found["tabOn" .. TAB_LIST[i]];

					-- The pane is the tab's contents, so hiding it hides everything inside - which is
					-- what V92 asks for, now by construction instead of by walking children. A denied
					-- tab loses its button too, which the native strip never let us promise (SPEC R31).
					local live = want and (nm == activeTab);

					if btn  ~= nil then btn.visible  = want; end;
					if on   ~= nil then on.visible   = live; end;
					if pane ~= nil then pane.visible = live; end;

					-- Where it sits and whether it is there are written in the SAME breath, the
					-- shape V112/V162 ask for everywhere else on this sheet: a button parked over
					-- the slot of a neighbour that went away is a hole with no visible cause.
					if want then
						if btn ~= nil then btn.left = x; end;
						if on  ~= nil then on.left  = x; end;

						x = x + TAB_W[i] + STRIP_GAP;
					end;
				end;
			end;

			-- Down here, not up beside TAB_LIST where it would read better, for the reason B51
			-- cost a whole round (SPEC V223): both of these call `tabRootOf`, which is a `local`
			-- declared further down, and Lua resolves a non-local name at COMPILE time - a body
			-- written above that line gets a GETGLOBAL and calls nil. V223 caught it the same day
			-- it was written.
			-- Both strips, every call (SPEC I58). Painting the one that did not change costs six
			-- lookups that find nothing when its form is not loaded, and it buys the caller not
			-- having to know which strip its button belongs to - the same trade selectTab makes
			-- one line below.
			--
			-- A THIRD name family since the 107th round (SPEC I76c, V300): note<X> is a caption
			-- that belongs to pane tab<X> but cannot live inside it. The affinity note is the one
			-- there is - the Hedge panes have no free band for it, which is why the 91st round put
			-- it on the strip - and a caption standing over the pane it does not explain is what
			-- the user reported. It is hidden HERE and by nothing in the XML, in the same line of
			-- the same loop that lights the pill, so the two cannot come apart. A pane with no
			-- note costs one lookup that finds nothing, which is the trade the paragraph above
			-- already makes for the strip that did not change.
			-- A FOURTH and FIFTH family since the 109th round (SPEC I78c, V305): lbl<X> is the sub-tab's
			-- word CLOSED - italic, in the theme's own text colour - and lblOn<X> is the same word OPEN,
			-- roman and in the era's accent. Two labels and not one word restyled: fontColor belongs to
			-- applyTheme and a Lua write there is undone on the next repaint (SPEC V57), so the state is
			-- carried by `visible` - which is what tabOn<X> has always been for the pill. Lit in the same
			-- loop and from the same `live`, so word, rule and pane cannot come apart.
			function renderSubTabs(from)
				local names = {};

				for s = 1, #SUB_TABS, 1 do
					local list = SUB_TABS[s].list;

					for i = 1, #list, 1 do
						names["tab" .. list[i]]   = true;
						names["tabOn" .. list[i]] = true;
						names["note" .. list[i]] = true;
						names["lbl" .. list[i]]   = true;
						names["lblOn" .. list[i]] = true;
					end;
				end;

				local found = {};

				xpFind(tabRootOf(from), names, found);

				for s = 1, #SUB_TABS, 1 do
					local grp = SUB_TABS[s];

					for i = 1, #grp.list, 1 do
						local live = ("tab" .. grp.list[i]) == grp.active;
						local pane = found["tab" .. grp.list[i]];
						local on   = found["tabOn" .. grp.list[i]];
						local note = found["note" .. grp.list[i]];
						local lbl   = found["lbl" .. grp.list[i]];
						local lblOn = found["lblOn" .. grp.list[i]];

						if on   ~= nil then on.visible   = live; end;
						if pane ~= nil then pane.visible = live; end;
						if note ~= nil then note.visible = live; end;
						if lbl   ~= nil then lbl.visible   = not live; end;
						if lblOn ~= nil then lblOn.visible = live; end;
					end;
				end;
			end;

			-- Setting the tab and painting the strip are the same act, so they cannot come apart
			-- (the shape V112/V162 ask for on enabled+opacity). One entry point for both strips:
			-- the XML says selectTab everywhere and this decides which strip the name belongs to,
			-- rather than the caller having to know.
			function selectTab(name, from)
				for s = 1, #SUB_TABS, 1 do
					local grp = SUB_TABS[s];

					for i = 1, #grp.list, 1 do
						if ("tab" .. grp.list[i]) == name then
							grp.active = name;
							renderSubTabs(from);
							return;
						end;
					end;
				end;

				activeTab = name;
				applyTabVisibility(from);
			end;
			-- Aqui, e nao la em cima ao lado de GEN_MAX e maxDiscLevel onde ele LERIA melhor, por um
			-- motivo so (SPEC B51, V223): ele chama `tabRootOf`, `local function` declarada ACIMA
			-- desta linha. Lua resolve nome nao-local em tempo de COMPILACAO, entao corpo escrito
			-- acima daquela declaracao compila GETGLOBAL e chama nil - e `rdk -l` sai 0 nisso e os
			-- 443 checks passaram verdes enquanto o label nunca pintou, nos DOIS caminhos.
			function renderMaxDisc(from)
				if from == nil then return; end;

				local found = {};

				xpFind(tabRootOf(from), { lblMaxDisc = true }, found);

				local c = found["lblMaxDisc"];

				if c == nil then return; end;

				local m = maxDiscLevel();

				c.text = (m == nil) and "-" or tostring(m);
			end;


			-- ---- First paint (SPEC I15 / V166 / V167 / B40, 49th round) -----------------
			--
			-- The host draws the sheet before any hook of ours runs (SPEC R47), so for about a
			-- second every open showed the sheet exactly as the XML authors it: black boxes, the
			-- host font, white dots, no parchment, HEALTH with no labels and abilities off their
			-- era. That look is nobody's choice - since the 16th round every value the theme
			-- combo offers repaints, so there is no way back to it (SPEC C). It was dead state
			-- on display at every single open, and the user asked for it gone.
			--
			-- The fix is not to show it. The tabControl is authored hidden and this is the one
			-- place in the sheet that lights it (SPEC V166).
			--
			-- Idempotent, and deliberately reachable two ways (SPEC V167): the theme paint calls
			-- it when it is done, and onNodeReady arms a timer that calls it whatever happens. A
			-- paint that never runs has to leave the sheet ugly, never blank - hiding it forever
			-- is worse than showing it raw, which is the mirror of the mistake B26 made when it
			-- left hidden tabs authored visible.
			--
			-- Found by name from the root, through the one finder there is (SPEC V143): this is
			-- called from WoD20.6, and a tab form cannot reach its siblings (SPEC R.9 / B.9).
			function sheetReveal(from)
				local tc = xpFind(tabRootOf(from), { sheetBody = true }, {}).sheetBody;

				if tc ~= nil and tc.visible ~= true then tc.visible = true; end;
			end;

			-- A write the sheet makes to ITSELF is not a click by the player, and an
			-- imageCheckBox has no onUserChange to tell the two apart (SPEC R37) - so the code
			-- says which is which. Whatever writes a batch of fields raises this first and
			-- lowers it after.
			--
			-- Without it the sheet froze on load (SPEC B30): the era renderer rebinds 150 dots,
			-- twice, and each rebind was costing two full walks of the ledger.
			xpQuiet = false;

			-- ---- Experience ledger (SPEC I9 / I10 / V83 / V85 / V86, 27th round) --------
			--
			-- The log is DERIVED: every render diffs the saved initial character against the
			-- sheet as it stands now (SPEC V83). Nothing is journalled, so unticking a dot
			-- takes its line back out and a mis-click never has to be edited away by hand.
			--
			-- The baseline is the whole sheet in one XML string, written once (SPEC R32/V81).
			-- It is parsed on demand and cached against the string it came from: the ledger
			-- re-renders on every dot click, and re-parsing that each time would be waste.
			local baselineXML, baselineNode;

			local function baselineOf()
				if sheet == nil then return nil; end;

				local xml = sheet.baseline;

				if xml == nil or xml == "" then return nil; end;

				if xml ~= baselineXML then
					local node = ndb.newMemNodeDatabase();
					ndb.importXML(node, xml);

					baselineXML  = xml;
					baselineNode = node;
				end;

				return baselineNode;
			end;

			-- SPEC V85: ONE reading, used for both sides of the diff. Attributes and virtues
			-- draw their first dot as fixed art, so their fields start at _2 and the rating is
			-- one above the count. Willpower counts the DOTS (willpower_1..10) and never the
			-- boxes (willpower_c1..c10) - those are spent points, not rating.
			function traitLevel(node, base, first, last, fixed)
				local n = fixed;

				for i = first, last, 1 do
					if node[base .. "_" .. i] == true then n = n + 1; end;
				end;

				return n;
			end;

			-- The sheet as it WOULD be if the click were allowed (SPEC V136). Pricing a dot
			-- must not write it: what kept the guard from ever making a refusal stick was
			-- that it let the mark happen and argued afterwards (SPEC B38).
			--
			-- Only the live sheet is simulated. The baseline is the character the storyteller
			-- froze, and it goes on being read through traitLevel directly.
			local simTrait, simField, simValue;

			local function liveLevel(base, first, last, fixed)
				local n = traitLevel(sheet, base, first, last, fixed);

				-- One dot, one trait: a pending click moves the count by one at most, and only
				-- for the trait the dot belongs to.
				if simTrait == base and (sheet[simField] == true) ~= simValue then
					if simValue then n = n + 1; else n = n - 1; end;
				end;

				return n;
			end;

			-- SPEC I9. Every ACTIVE rule sits here exactly once (SPEC V86). The dormant ones -
			-- Discipline, Path, Sphere, Arete - are in the spec but deliberately NOT written:
			-- the Disciplines tab is empty and Magika is gone altogether (SPEC V128), so no
			-- field can produce that row and a cost nothing can reach is dead code.
			-- What a speciality costs at this moment (SPEC I9/I49/V154/V254). ONE field carries both
			-- halves of the storyteller's answer: a number 0..5 is the price and the door is open,
			-- the sentinel is the door shut.
			--
			-- ZERO IS A PRICE. The two-flag version could not say 'free' and 'not for sale' apart -
			-- both were 'specCost() == 0' - so the door has its own reader now, and xpClick asks
			-- THAT one (SPEC V254b). Reading the closed door as cost 0 is deliberate on the ledger
			-- side: a specialty already bought when the storyteller shuts the door prices at zero
			-- rather than at three, which is what the flags did before this round.
			--
			-- nil lands on 3, the same default the dataLink declares in WoD20.10 (SPEC V254c):
			-- defaultValue does not WRITE the field, so a sheet saved before this round arrives
			-- empty and the two places that answer for it must not disagree (the healthLevels pair).
			-- The sentinel is the ENGLISH TEXT of the item, not a code word (SPEC I52, V257c,
			-- 88th round). It reads odd stored in a field and it is the whole point: a cmb* list
			-- has no second list to keep in step, so `items` are rebuilt from `values` at every
			-- language switch, and that only works while the value IS the English string.
			-- Whatever is written here has to be the same literal WoD20.10 authors, or the door
			-- never reads as shut (SPEC V12).
			local SPEC_FORBIDDEN = "Purchase Forbidden";

			-- The 87th round stored the shut door as `forbidden`; the 88th made the value the
			-- English text itself. A sheet saved in between still carries the old literal, and a
			-- door the storyteller SHUT must not open by itself when the sheet is next opened -
			-- so the old word is still read as shut (SPEC V80, fail-closed). It is only read, it
			-- is never written: the moment the storyteller touches the combo the field is one of
			-- the seven current values, and this line stops mattering for that sheet.
			local SPEC_FORBIDDEN_OLD = "forbidden";

			local function specForbidden()
				if sheet == nil then return true; end;

				return sheet.stSpecCost == SPEC_FORBIDDEN or sheet.stSpecCost == SPEC_FORBIDDEN_OLD;
			end;

			local function specCost()
				if sheet == nil then return 0; end;
				if specForbidden() then return 0; end;

				return tonumber(sheet.stSpecCost) or 3;
			end;

			local function xpCost(kind, from, ctx)
				if kind == "Attribute" then return from * 4; end;
				if kind == "Ability"   then if from == 0 then return 3; end; return from * 2; end;
				if kind == "Virtue"    then return from * 2; end;
				if kind == "Humanity"  then return from * 2; end;
				if kind == "Willpower" then return from; end;

				if kind == "Background" then
					-- A PRICE since the 88th round, where a flag used to sit (SPEC I51, I9).
					-- Same shape Ability and Numina already use: the first dot costs the price
					-- flat and every later one costs rating times price.
					--
					-- Zero comes out of the ARITHMETIC, not out of a guard: `stBackgroundCost`
					-- at 0 prices every rise at 0, which is what the unticked flag did, and the
					-- rise still SHOWS at zero - it happened, and the storyteller is who reads
					-- this table. 3 reproduces the old ticked price byte for byte.
					if from == 0 then return ctx.backgroundCost; end;

					return from * ctx.backgroundCost;
				end;

				-- One dot, so there is no rating to price off: a speciality costs whatever the
				-- storyteller opened the door at (SPEC I9). A purchase never reaches here with
				-- both boxes off (SPEC V154); a line bought while one was on reads zero after
				-- it is turned off, which is what the background flag has always done.
				if kind == "Specialty" then return specCost(); end;

				-- SPEC I9, dormant since the 27th round and awake now that the fields exist. What
				-- makes a discipline "clan" is that it SITS in a clan slot at the moment of the
				-- click (SPEC C) - not which box bought it, and not the CLANS table, which stays
				-- asleep while `clan` is invisible (SPEC V173/V174).
				if kind == "Discipline" then
					if from == 0 then return 20; end;
					if ctx.inClan then return from * 15; end;
					return from * 25;
				end;

				-- Secondary paths only. The main path is not bought (SPEC V179).
				--
				-- The five vampire prices are the table's own, not the book's (SPEC I9, 2026-08-22).
				-- Nothing here stores what a dot COST when it was bought: Spent is the sum of a ledger
				-- rebuilt from the diff on every render (SPEC V83, V100), so changing a price reprices
				-- every sheet that already owns those dots, and Current can go negative with nobody
				-- clicking anything. That is a known consequence, not a bug to fix here (SPEC C).
				if kind == "Path" then
					if from == 0 then return 20; end;
					return from * 15;
				end;

				-- One experience per level, flat: a level 3 ritual costs 3 and a homebrew taken to
				-- two dots costs 2 (user 2026-08-23, SPEC I9). There is no ladder to climb here -
				-- the caller charges the difference between the level reached and the level the
				-- baseline held, one line for the whole ritual (SPEC V269c).
				if kind == "Ritual" then return 1; end;

				if kind == "Numina" then
					if from == 0 then
						-- The 21 is the first point of a KIND the character did not have -
						-- static magic, psychic, true faith - not merely a numina they did not
						-- have (SPEC V87).
						if ctx.newType then return 21; end;

						return 7;
					end;

					if ctx.affinity then return from * 6; end;

					return from * 7;
				end;

				return 0;
			end;

			-- One line per POINT: 2 -> 4 is two lines, each costed off the rating it was bought
			-- from (SPEC I10).
			--
			-- `field` is here for the free-dot stamp and nothing else (SPEC V139). The stamp
			-- keys off the rating the point REACHED, never off the dot that was clicked:
			-- strength_5 clicked with two dots lit is level 3, and keying off the field is the
			-- mistake that made the 34th round's version charge for stamped points (SPEC B31).
			local function pushRise(rows, kind, name, from, to, ctx, field)
				for lvl = from + 1, to, 1 do
					local cost = xpCost(kind, lvl - 1, ctx);

					-- A stamp DISCOUNTS a price the table already worked out; it is not a second
					-- table (SPEC V86/V139). A free point does not make the next one cheaper -
					-- the price reads the rating reached, not how many were paid for.
					if string.find(ctx.free, "|" .. field .. "#" .. lvl .. "|", 1, true) ~= nil then cost = 0; end;

					-- The key the ORDER stamp is looked up by (SPEC I56). Same shape the free
					-- stamp is keyed on, built from the same two parts a line away: one grammar
					-- for both stamps, so a point that can be found in one can be found in the
					-- other (SPEC V138, V260b).
					rows[#rows + 1] = { kind = kind, name = name, level = lvl, cost = cost, key = field .. "#" .. lvl };

					-- 21 buys the FIRST point of the new kind and nothing after it.
					ctx.newType = false;
				end;
			end;

			local XP_ATTRS = {
				{"Strength", "strength"}, {"Dexterity", "dexterity"}, {"Stamina", "stamina"},
				{"Charisma", "charisma"}, {"Manipulation", "manipulation"}, {"Appearance", "appearance"},
				{"Perception", "perception"}, {"Inteligence", "inteligence"}, {"Wits", "wits"},
			};

			local XP_VIRTUES = { {"Conscience", "conscience"}, {"Self-Control", "selfControl"}, {"Courage", "courage"} };

			local XP_CUSTOM = { "customTalent_1", "customTalent_2", "customSkill_1", "customSkill_2", "customKnowledge_1", "customKnowledge_2" };

			-- The 41 ability names, sorted so the ledger is in the same order every render.
			-- ABILITY_FIELD is a bijection (SPEC V74), so the name identifies the trait no
			-- matter which era is showing.
			local XP_ABILITIES = {};

			for name in pairs(ABILITY_FIELD) do XP_ABILITIES[#XP_ABILITIES + 1] = name; end;

			table.sort(XP_ABILITIES);

			-- How many rows each numina list draws, and how many of those the player TYPES
			-- instead of picking (SPEC I59, I60, V263). Declared ONCE and read by every loop
			-- that walks them - declareTrait, the ledger, and the type-in-use test below - for
			-- the same reason BACKGROUND_ROWS is: a row added to the XML and to only one of the
			-- loops is a dot that costs nothing and never reaches the log (SPEC B46).
			--
			-- The typed rows are the LAST ones, so every reader is 'picker = total - typed' and
			-- no list of indices exists to drift from these numbers (SPEC V255, V263b).
			NUMINA_ROWS       = 17;
			NUMINA_FREE_ROWS  = 5;
			PSYCHIC_ROWS      = 24;
			PSYCHIC_FREE_ROWS = 5;

			-- The rituals of static magic, on the Rituals sub-tab of Hedge Magic (SPEC I65, 91st
			-- round). Same contract as the four above: the total covers BOTH kinds of row and the
			-- typed ones are the LAST, so every reader is "picker = total - typed" and no list of
			-- indices exists to drift from these two numbers (SPEC V204, V263b).
			--
			-- A ritual is KNOWN, not rated: only the five TYPED rows carry dots of their own, and
			-- only they are declared as traits below (SPEC V269b).
			HEDGE_RITUAL_ROWS      = 17;
			HEDGE_RITUAL_FREE_ROWS = 5;

			local XP_NUMINA = {
				{ kind = "hedge",   base = "numina",  count = NUMINA_ROWS },
				{ kind = "psychic", base = "psychic", count = PSYCHIC_ROWS },
			};

			-- How many background rows the sheet draws (SPEC V145). Declared ONCE and read by
			-- both loops that walk them - the one that lets experience buy them and the one
			-- that prices them for the log. The count was written out twice as `9` until the
			-- 46th round moved the box to the Traits tab and doubled it; a twenty-first row
			-- added to the XML and to only one of the two loops would be a background nothing
			-- charges for and nothing shows in the log (SPEC I3, I9).
			BACKGROUND_ROWS = 21;

			-- How many of those the storyteller TYPES instead of picking (SPEC I50, V255, user
			-- 2026-08-22). The LAST five, so every reader is 'picker = total - typed' and no list of
			-- indices exists to drift from this number.
			BACKGROUND_FREE_ROWS = 5;


			-- How many speciality rows the box on the Main tab draws (SPEC V147). Same reason
			-- as BACKGROUND_ROWS: both the loop that lets experience buy them and the loop that
			-- prices them for the log read this, so a tenth row added to the XML alone would be
			-- a dot nothing charges for and nothing shows.
			SPECIALITY_ROWS = 10;

			-- How many of those the storyteller TYPES instead of picking (SPEC I50, V255, user
			-- 2026-08-22). Same contract as the three on the Ghoul tab: they are the LAST rows, so
			-- the picker count is the total minus these and no reader carries a list of indices.
			SPECIALITY_FREE_ROWS = 3;

			-- Rows of the Vampire tab (SPEC I16). Same contract as BACKGROUND_ROWS above: the loop
			-- that lets experience buy a dot and the loop that prices it for the log both read
			-- these, so a row added to the XML alone would be a dot nothing charges for.
			-- MAIN_PATH_ROWS and RITUAL_ROWS buy nothing - a main path mirrors its discipline
			-- (SPEC V179/V180) and a ritual has no dots at all (SPEC C) - so neither is declared
			-- as a trait; they are here so the count lives in one place per box.
			--
			-- RITUAL_ROWS said 20 for three rounds while WoD20.14 drew 25 (SPEC B46). Nothing read
			-- it, so nothing broke and the gate stayed green over a wrong number; the picker
			-- filter is its first reader and would have left five rows unfiltered without a
			-- word. The gate now measures every one of these against the XML (SPEC V204).
			CLAN_DISC_ROWS = 4;
			DISC_ROWS      = 15;
			MAIN_PATH_ROWS = 5;
			SEC_PATH_ROWS  = 15;
			RITUAL_ROWS    = 20;

			-- How many of those rows the storyteller TYPES instead of picking (SPEC I45, V248,
			-- user 2026-08-22). They are always the LAST ones, so the picker count is the total
			-- minus these and there is no second list of indices to drift from the first.
			DISC_FREE_ROWS     = 3;
			SEC_PATH_FREE_ROWS = 3;
			RITUAL_FREE_ROWS   = 5;

			-- The first typed row of each box, keyed by field root. Built from the two counts
			-- above rather than typed out again: a row moved in the XML changes one number here
			-- and every reader follows (SPEC V204).
			local TYPED_ROW_FROM = {
				disc       = DISC_ROWS - DISC_FREE_ROWS + 1,
				speciality = SPECIALITY_ROWS - SPECIALITY_FREE_ROWS + 1,
				background = BACKGROUND_ROWS - BACKGROUND_FREE_ROWS + 1,
				secPath    = SEC_PATH_ROWS - SEC_PATH_FREE_ROWS + 1,
				ritual     = RITUAL_ROWS - RITUAL_FREE_ROWS + 1,

				-- The two Numina boxes since the 91st round (SPEC I62): their last rows have
				-- been typed since the 90th, and now they answer isTypedRow like every other
				-- typed row, so the description block opens for the storyteller on them too.
				-- Derived from the counts for the same reason as the five above - a row that
				-- changes kind in the XML changes one number here (SPEC V204, V263b).
				numina     = NUMINA_ROWS - NUMINA_FREE_ROWS + 1,
				psychic    = PSYCHIC_ROWS - PSYCHIC_FREE_ROWS + 1,

				-- The homebrew rituals of the 91st round. isTypedRow answering for them is what
				-- gives their DESCRIPTION to the storyteller (SPEC I62) and what tells the level
				-- reader to count dots instead of reading a prefix that is not there (SPEC V269d).
				hedgeRitual = HEDGE_RITUAL_ROWS - HEDGE_RITUAL_FREE_ROWS + 1,
			};

			-- Is this field one of the typed rows? GLOBAL because three other files ask it: the
			-- picker guard here, the three description renderers on WoD20.12/13/14, and the sort
			-- on WoD20.14 (SPEC V223 - global is the convention for a function called across
			-- .lfm boundaries).
			--
			-- `isTypedRow` and NOT `isFreeRow`: that name is taken, by the speciality stamp two
			-- thousand lines down (SPEC V160), and a second global of the same name would have
			-- silently replaced it - the whole free-specialty ledger answering a question about
			-- ritual rows. The gate caught it on the first run. FREE means free of CHARGE
			-- everywhere else on this sheet (xpFree, stFreeBuy, Free dots), so these rows are
			-- TYPED here even though SPEC V248 still calls their counts *_FREE_ROWS.
			--
			-- `clanDisc_2` answers false and has to: the clan box is picked from the same list
			-- as `disc_*` (SPEC V178) and only the fifteen open rows have typed ones at the end.
			function isTypedRow(field)
				if field == nil then return false; end;

				local base, n = string.match(field, "^(%a+)_(%d+)$");

				if base == nil then return false; end;

				local from = TYPED_ROW_FROM[base];

				return from ~= nil and tonumber(n) >= from;
			end;

			-- Where a typed row keeps the text the storyteller wrote for it (SPEC I45): the
			-- row's own name with `Desc` inside it, so `disc_13` holds its description in
			-- `discDesc_13` and the two cannot end up pointing at different rows. Derived and
			-- never listed out, for the same reason the counts above are derived.
			--
			-- These eleven fields are written by Lua ALONE - the description block owns no
			-- `field` and never will (SPEC V29, V249b) - so they are Lua-owned in the sense
			-- SPEC I3 uses, and nothing but the block itself reads them.
			function descFieldOf(field)
				if field == nil then return nil; end;

				local base, n = string.match(field, "^(%a+)_(%d+)$");

				if base == nil then return nil; end;

				return base .. "Desc_" .. n;
			end;

			-- The description block writes its own text, and gui.TextEditor has onChange and no
			-- onUserChange (rrpgGUI.lua:667-675) - so the renderer's write comes back through
			-- the same door the storyteller's typing does. This says which is which, exactly as
			-- xpQuiet does for a batch of field writes (SPEC V107, V249d).
			--
			-- Raised and lowered around ONE write, with no return in between: a flag stuck true
			-- would mute the storyteller's keyboard for the rest of the session (SPEC B39).
			descQuiet = false;

			-- Which traits hand out a free speciality, and at which rating (SPEC I14/V149).
			-- DERIVED from the two tables that already name every attribute and every ability,
			-- never typed out again: the picker on WoD20.1 offers exactly these fifty names, and
			-- the gate compares the two sides rather than trusting them to stay in step
			-- (SPEC V148, the failure B23/B24 were made of).
			--
			-- Custom ability rows are deliberately absent. They are not in the picker, so a
			-- grant on one would write a value the combo has no item for (SPEC V13).
			SPEC_TRAIT = {};

			for i = 1, #XP_ATTRS, 1 do SPEC_TRAIT[XP_ATTRS[i][2]] = { name = XP_ATTRS[i][1], free = 4 }; end;
			for name, field in pairs(ABILITY_FIELD) do SPEC_TRAIT[field] = { name = name, free = 4 }; end;

			-- The five that come with a speciality at the FIRST dot - and get nothing at the
			-- fourth, which is the whole point of listing them (the user's second request).
			local SPEC_FREE_AT_ONE = { "crafts", "expression", "performance", "academics", "technology" };

			for i = 1, #SPEC_FREE_AT_ONE, 1 do SPEC_TRAIT[SPEC_FREE_AT_ONE[i]].free = 1; end;

			-- Field -> how to read that trait's rating, for every trait experience can buy
			-- (SPEC I12). Built from the SAME lists the ledger walks, so a trait cannot be in
			-- one and missing from the other (SPEC V86): the guard refuses moves on exactly
			-- the traits the log prices.
			--
			-- It holds no cost of its own. Prices live in xpCost and nowhere else - the guard
			-- reads what a move did to the LOG rather than pricing the move itself.
			XP_TRAIT = {};

			local function declareTrait(field, first, last, fixed)
				XP_TRAIT[field] = { first = first, last = last, fixed = fixed };
			end;

			for i = 1, #XP_ATTRS, 1 do declareTrait(XP_ATTRS[i][2], 2, 5, 1); end;

			-- Appearance is the attribute whose first dot can be switched off (SPEC I3).
			declareTrait("appearance", 1, 5, 0);

			for name, field in pairs(ABILITY_FIELD) do declareTrait(field, 1, 5, 0); end;
			for i = 1, #XP_CUSTOM, 1 do declareTrait(XP_CUSTOM[i], 1, 5, 0); end;
			for i = 1, #XP_VIRTUES, 1 do declareTrait(XP_VIRTUES[i][2], 2, 5, 1); end;

			declareTrait("humanity", 1, 10, 0);
			declareTrait("willpower", 1, 10, 0);

			for i = 1, BACKGROUND_ROWS, 1 do declareTrait("background_" .. i, 1, 5, 0); end;

			-- One dot per row, so first and last are both 1 (SPEC V147). The row is a trait like
			-- any other from here on: the same click path prices it, refuses it and sells it.
			for i = 1, SPECIALITY_ROWS, 1 do declareTrait("speciality_" .. i, 1, 1, 0); end;

			for g = 1, #XP_NUMINA, 1 do
				for i = 1, XP_NUMINA[g].count, 1 do declareTrait(XP_NUMINA[g].base .. "_" .. i, 1, 5, 0); end;
			end;

			declareTrait("faith", 1, 5, 0);

			-- The rituals declare from their FIRST TYPED row up (SPEC I65, V269b). The twelve
			-- picked ones carry no dot field at all - their level is the book's, shown in art the
			-- painter drives - so declaring them would hand xpClick a range of widgets that do
			-- not exist and leave V99/V134 measuring a ghost.
			for i = TYPED_ROW_FROM.hedgeRitual, HEDGE_RITUAL_ROWS, 1 do declareTrait("hedgeRitual_" .. i, 1, 5, 0); end;

			for i = 1, CLAN_DISC_ROWS, 1 do declareTrait("clanDisc_" .. i, 1, 5, 0); end;
			for i = 1, DISC_ROWS, 1 do declareTrait("disc_" .. i, 1, 5, 0); end;
			for i = 1, SEC_PATH_ROWS, 1 do declareTrait("secPath_" .. i, 1, 5, 0); end;

			local function numinaTypeInUse(node, base, count)
				for i = 1, count, 1 do
					if traitLevel(node, base .. "_" .. i, 1, 5, 0) > 0 then return true; end;
				end;

				return false;
			end;

			-- A row the player named carries that name; one they only put dots on carries the
			-- field id, which is at least honest about which line it is.
			local function slotName(field)
				local v = sheet[field];

				if v == nil or v == "" then return field; end;

				return v;
			end;

			-- The level of a ritual, and it is READ, never stored (SPEC I65, V269d). A PICKED
			-- ritual carries it in the item text - "3. Name of the Ritual", the same grammar the
			-- vampire rituals use and pickRefusal already reads - and a TYPED one carries it in
			-- the dots the storyteller marked, because homebrew has no prefix to read.
			--
			-- `node` is the baseline when the caller wants the frozen side of the diff; without
			-- it the live sheet answers, through liveLevel, so a dot being priced counts before
			-- it is written (SPEC V136).
			-- GLOBAL, and for the reason V223 gives: the dot painter on WoD20.7 reads it too, so
			-- the "<n>. " grammar is written ONCE and the art on screen cannot drift from the price
			-- in the log (SPEC V269d).
			function hedgeRitualLevel(field, value, node)
				if isTypedRow(field) then
					if node == nil then return liveLevel(field, 1, 5, 0); end;

					return traitLevel(node, field, 1, 5, 0);
				end;

				return tonumber(string.match(value or "", "^(%d+)%. ")) or 0;
			end;

			-- Returns the rows, or nil when no initial character has been saved yet - the
			-- caller shows a state text for that instead of an empty table (SPEC V33).
			--
			-- `clickFree` is the stamp the click being priced WOULD leave if it is allowed
			-- (SPEC V140). It is handed in rather than written first, because pricing a click
			-- writes nothing at all (SPEC V136): the row comes out at zero here, and the stamp
			-- reaches the sheet only on the way through xpClick.
			--
			-- `clickOrder` is the same arrangement for the ORDER stamp (SPEC I56): the key the
			-- click would leave, handed in so the line it is about to create sorts to the top of
			-- the log in the very repaint that click pays for. Without it the row just bought
			-- comes up at the BOTTOM until something else redraws the sheet - nothing breaks,
			-- the build is green, and the player watches it happen (SPEC B6, V260d).
			function xpLedgerRows(clickField, clickValue, clickFree, clickOrder)
				local base = baselineOf();

				if base == nil then return nil; end;

				-- Set after the baseline check and cleared before the one way out, so nothing
				-- later is priced under a click that has already been answered (SPEC V136).
				simField, simValue = clickField, clickValue;
				simTrait = clickField ~= nil and string.match(clickField, "^(.+)_%d+$") or nil;

				-- The stamps, read ONCE per walk (SPEC V125). Bars on both sides of every key
				-- so that a search for |a_3#4| cannot match inside |numina_3#4|.
				-- The 0 here and the defaultValue="0" on WoD20.10 are the pair that answers for
				-- a sheet which never touched the combo (SPEC I51, V12): defaultValue does not
				-- WRITE the field, so a sheet saved before the 88th round arrives empty and the
				-- two places must not disagree. `stBackgroundsXP` is an ORPHAN (SPEC I3, V2).
				local ctx  = {
					backgroundCost = tonumber(sheet.stBackgroundCost) or 0,
					free           = (sheet.xpFree or "") .. "|" .. (clickFree or "") .. "|",
				};

				-- The ORDER stamp, read once per walk like the price stamp beside it (SPEC I56,
				-- V125). It is not in `ctx`: pricing never reads it - a point costs what the
				-- table says whether it was bought first or last - and putting it there would
				-- hand the order to xpCost, which has no business with it.
				--
				-- The click being priced is appended LAST, which is exactly what puts its line on
				-- top. Pricing still writes nothing (SPEC V136): this string is local, and the
				-- sheet learns about the stamp only on the way through xpClick.
				local ord = (sheet.xpOrder or "") .. "|" .. (clickOrder or "") .. "|";

				local rows = {};

				for i = 1, #XP_ATTRS, 1 do
					local nome, field = XP_ATTRS[i][1], XP_ATTRS[i][2];
					local first, fixed = 2, 1;

					-- Appearance is the one attribute whose first dot can be switched off
					-- (SPEC I3), so it counts from _1 with nothing fixed.
					if field == "appearance" then first, fixed = 1, 0; end;

					pushRise(rows, "Attribute", nome,
						traitLevel(base, field, first, 5, fixed),
						liveLevel(field, first, 5, fixed), ctx, field);
				end;

				for i = 1, #XP_ABILITIES, 1 do
					local nome  = XP_ABILITIES[i];
					local field = ABILITY_FIELD[nome];

					pushRise(rows, "Ability", nome,
						traitLevel(base, field, 1, 5, 0),
						liveLevel(field, 1, 5, 0), ctx, field);
				end;

				for i = 1, #XP_CUSTOM, 1 do
					local field = XP_CUSTOM[i];

					pushRise(rows, "Ability", slotName(field),
						traitLevel(base, field, 1, 5, 0),
						liveLevel(field, 1, 5, 0), ctx, field);
				end;

				for i = 1, #XP_VIRTUES, 1 do
					local nome, field = XP_VIRTUES[i][1], XP_VIRTUES[i][2];

					pushRise(rows, "Virtue", nome,
						traitLevel(base, field, 2, 5, 1),
						liveLevel(field, 2, 5, 1), ctx, field);
				end;

				pushRise(rows, "Humanity", "Humanity",
					traitLevel(base, "humanity", 1, 10, 0),
					liveLevel("humanity", 1, 10, 0), ctx, "humanity");

				pushRise(rows, "Willpower", "Willpower",
					traitLevel(base, "willpower", 1, 10, 0),
					liveLevel("willpower", 1, 10, 0), ctx, "willpower");

				for i = 1, BACKGROUND_ROWS, 1 do
					local field = "background_" .. i;

					pushRise(rows, "Background", slotName(field),
						traitLevel(base, field, 1, 5, 0),
						liveLevel(field, 1, 5, 0), ctx, field);
				end;

				-- Which kinds the character already had when the storyteller froze the sheet.
				-- Buying into a kind that is not in here costs 21 for its first point, once.
				-- Walked off XP_NUMINA rather than written out per kind, and the counts come off
				-- the same table: they were a literal `10` twice, correct only by accident, which
				-- is the shape of B46 (SPEC V263c). A third numina kind now lands here for free.
				local unlocked = { faith = traitLevel(base, "faith", 1, 5, 0) > 0 };

				for g = 1, #XP_NUMINA, 1 do
					unlocked[XP_NUMINA[g].kind] = numinaTypeInUse(base, XP_NUMINA[g].base, XP_NUMINA[g].count);
				end;

				for g = 1, #XP_NUMINA, 1 do
					local grp = XP_NUMINA[g];

					for i = 1, grp.count, 1 do
						local field = grp.base .. "_" .. i;
						local from  = traitLevel(base, field, 1, 5, 0);
						local to    = liveLevel(field, 1, 5, 0);

						if to > from then
							-- SPEC V88: the affinity path is the FIRST hedge row, always. It is
							-- the ROW that is cheap, not whichever numina currently sits on it.
							ctx.affinity = (field == "numina_1");
							ctx.newType  = (from == 0) and not unlocked[grp.kind];

							pushRise(rows, "Numina", slotName(field), from, to, ctx, field);

							unlocked[grp.kind] = true;
						end;
					end;
				end;

				-- True Faith is a numina like the others; the combo beside it picks a religion,
				-- not a power (SPEC V50), so the ledger names the numina.
				local ff = traitLevel(base, "faith", 1, 5, 0);
				local ft = liveLevel("faith", 1, 5, 0);

				if ft > ff then
					ctx.affinity = false;
					ctx.newType  = (ff == 0) and not unlocked.faith;

					pushRise(rows, "Numina", "True Faith", ff, ft, ctx, "faith");
				end;

				-- Static magic rituals (SPEC I65, V269c, user 2026-08-23). This is the ONE
				-- aggregated category of the log: a ritual is known or it is not, it has one level
				-- and it is paid once, so it gets ONE line saying the level reached - not
				-- pushRise's line per point, which is the shape every rated trait above uses.
				--
				-- The stamp is still read per LEVEL, with the same key grammar as everything else
				-- (SPEC V138, V139): a point the storyteller gave away costs nothing here either,
				-- and the line simply comes out cheaper.
				for i = 1, HEDGE_RITUAL_ROWS, 1 do
					local field = "hedgeRitual_" .. i;
					local live  = sheet[field];

					if live ~= nil and live ~= "" then
						local to = hedgeRitualLevel(field, live);

						-- A row holding a DIFFERENT ritual than the one the storyteller froze is a
						-- ritual nobody had: it pays from zero. Swapping a level one for a level
						-- three is not a two-point rise, and pricing it as one would sell the two
						-- top levels of a ritual at the price of a swap (SPEC I65).
						local from = 0;

						if base[field] == live then from = hedgeRitualLevel(field, live, base); end;

						if to > from then
							local cost = 0;

							for lvl = from + 1, to, 1 do
								if string.find(ctx.free, "|" .. field .. "#" .. lvl .. "|", 1, true) == nil then cost = cost + xpCost("Ritual", lvl - 1, ctx); end;
							end;

							rows[#rows + 1] = { kind = "Ritual", name = slotName(field), level = to, cost = cost, key = field .. "#" .. to };
						end;
					end;
				end;

				-- Disciplines and paths (SPEC I10b), between the numina and the specialities.
				--
				-- A discipline is priced as CLAN when the discipline itself sits in one of the four
				-- clan slots (SPEC C). Read once, off the live sheet, so the same discipline picked
				-- in an open slot is priced the same as in its clan slot - it is one discipline,
				-- and which box it was typed into is not what the book charges for.
				local inClan = {};

				for i = 1, CLAN_DISC_ROWS, 1 do
					local v = sheet["clanDisc_" .. i];
					if v ~= nil and v ~= "" then inClan[v] = true; end;
				end;

				for i = 1, CLAN_DISC_ROWS, 1 do
					local field = "clanDisc_" .. i;

					ctx.inClan = true;

					pushRise(rows, "Discipline", slotName(field),
						traitLevel(base, field, 1, 5, 0),
						liveLevel(field, 1, 5, 0), ctx, field);
				end;

				for i = 1, DISC_ROWS, 1 do
					local field = "disc_" .. i;
					local v     = sheet[field];

					ctx.inClan = (v ~= nil and v ~= "" and inClan[v] == true);

					pushRise(rows, "Discipline", slotName(field),
						traitLevel(base, field, 1, 5, 0),
						liveLevel(field, 1, 5, 0), ctx, field);
				end;

				-- Only the secondary paths: a main path rides its blood sorcery and was paid for
				-- when the discipline was (SPEC V179/V180), so it owns no field and no line here.
				for i = 1, SEC_PATH_ROWS, 1 do
					local field = "secPath_" .. i;

					pushRise(rows, "Path", slotName(field),
						traitLevel(base, field, 1, 5, 0),
						liveLevel(field, 1, 5, 0), ctx, field);
				end;

				-- Specialities close the order (SPEC I10). The Trait column carries the TRAIT
				-- the row belongs to, not the text the player typed into it: that column is
				-- translated (SPEC V70) and free text is not - the storyteller reads what was
				-- written on the sheet itself.
				for i = 1, SPECIALITY_ROWS, 1 do
					local field = "speciality_" .. i;

					pushRise(rows, "Specialty", slotName(field),
						traitLevel(base, field, 1, 1, 0),
						liveLevel(field, 1, 1, 0), ctx, field);
				end;

				-- The storyteller's own correction, LAST of all (SPEC I44, V246). It is a line
				-- in the log and not a second number beside it: Spent stays the sum of what the
				-- log shows (SPEC I11, V100), so the figure the storyteller typed and the lines
				-- the player is reading cannot come apart.
				--
				-- It has no category in the price table and no slot index. That used to be why it
				-- closed the order; since the 90th round the order is the STAMP, so it sorts by
				-- when the storyteller typed it like every other line (SPEC I56). Level is the
				-- word and not a rating: nothing was raised - the number was.
				--
				-- One line means one key, and `#0` is a rating no trait can reach, so it cannot
				-- collide with a real one (SPEC V138, V260b).
				local manual = tonumber(sheet.xpManual) or 0;

				if manual ~= 0 then
					rows[#rows + 1] = { kind = "MANUAL", name = "MANUAL", level = "MANUAL", cost = manual, key = "xpManual#0" };
				end;

				simTrait, simField, simValue = nil, nil, nil;

				-- Newest purchase on top (SPEC I56, user 2026-08-23). The rows above are a DIFF
				-- of the frozen character against this one, and a diff carries no history: the
				-- order can only come from the stamp, which is why answering this at all took a
				-- saved field. Everything the log SHOWS is still derived - the stamp says when,
				-- never what or how much (SPEC V100).
				--
				-- A row with no stamp is what a sheet saved before this round is made of. Those
				-- keep the order they were built in - category, then slot - BELOW everything
				-- bought since. There is no chronology to seed them from, and writing one would
				-- put a lie where an absence is.
				--
				-- Decorated with the build index and sorted on it as the tie-break, because
				-- table.sort is NOT stable. On the day of the update every line is unstamped, so
				-- an unstable sort is not a corner case here: it would deal the whole log a
				-- different way round on every single render (SPEC V260f).
				for i = 1, #rows, 1 do
					rows[i].seq = i;
					rows[i].at  = string.find(ord, "|" .. rows[i].key .. "|", 1, true);
				end;

				table.sort(rows, function(a, b)
					if a.at ~= b.at then
						if a.at == nil then return false; end;
						if b.at == nil then return true; end;

						return a.at > b.at;
					end;

					return a.seq < b.seq;
				end);

				return rows;
			end;

			-- Controls by name, in ONE pass (SPEC V143). `form.<name>` does not cross an
			-- <import>, which is why the boxes and the log used to hand their forms to a
			-- registry (SPEC V133, 41st round) - and a registry filled at onNodeReady is a
			-- promise nobody could see being kept: a tab never opened never registered, and
			-- the failure was silent (SPEC B39). Walking from the root DOES cross the import;
			-- it is how the era rebind reaches WoD20.1's dots from WoD20.6 and how the translation
			-- reaches all eleven tabs (SPEC V21 / B9).
			function xpFind(node, names, out)
				local children = node:getChildren();

				if children == nil then return out; end;

				for i = 1, #children, 1 do
					local c  = children[i];
					local nm = c:getName();

					if nm ~= nil and names[nm] == true then out[nm] = c; end;

					xpFind(c, names, out);
				end;

				return out;
			end;

			-- The three numbers, wherever they are drawn (SPEC I11): the Progress tab has all
			-- three, the Main tab has the balance only. One is stored and two are worked out,
			-- which is what stops any of them from disagreeing with the log (SPEC V100).
			local XP_BOXES = { edtTotalXP = true, edtSpentXP = true, edtCurrentXP = true, edtCurrentXPMain = true };

			-- The painting itself. No xpQuiet here (SPEC V142): the flag exists to keep the
			-- sheet's OWN writes from dragging a repaint along (SPEC V107), and a flag left
			-- stuck true would otherwise mute every number on the sheet for the rest of the
			-- session with nothing to show for it (SPEC B39). The callers that need silencing
			-- ask for it themselves, just below.
			local function xpPaint(node, spent)
				if sheet == nil then return; end;

				-- The guard has usually just worked this out; walking the ledger a second time
				-- for the same click is the other half of what froze the sheet (SPEC V108).
				spent = spent or xpSpent();

				-- One-shot migration (SPEC I11/V102). A sheet from before this round kept its
				-- balance in `experience`; seeding the total with balance + log leaves the
				-- rendered balance exactly where the player left it. `spentXP` is not read -
				-- that was the player's own arithmetic, and the log counts from here on.
				if sheet.xpTotal == nil then
					-- Quiet, because the links watching xpTotal would call straight back into
					-- here and walk the ledger again for a number this call already has
					-- (SPEC V107).
					xpQuiet = true;
					setField("xpTotal", math.max(0, tonumber(sheet.experience) or 0) + spent);
					xpQuiet = false;
				end;

				local total = tonumber(sheet.xpTotal) or 0;
				local box   = xpFind(node, XP_BOXES, {});

				if box.edtTotalXP       ~= nil then box.edtTotalXP.text       = tostring(total); end;

				-- Spent is the one box whose lock moves (SPEC I44, V245). `== true` and not
				-- truthiness: a sheet saved before this round answers nil and has to read as
				-- LOCKED, the same fail-closed reading every other storyteller flag takes
				-- (SPEC V80, V89, V175).
				--
				-- readOnly and opacity are written on the SAME line, like every other runtime
				-- lock on this sheet (SPEC V112, V162): a box that looks free and refuses the
				-- key is the lie those two exist to stop. 0.75 because an edit is TEXT
				-- (SPEC V244).
				if box.edtSpentXP ~= nil then
					local stEdit = (sheet.stEditSpentXP == true);

					box.edtSpentXP.text = tostring(spent);
					box.edtSpentXP.readOnly = not stEdit; box.edtSpentXP.opacity = stEdit and 1 or 0.75;
				end;
				if box.edtCurrentXP     ~= nil then box.edtCurrentXP.text     = tostring(total - spent); end;
				if box.edtCurrentXPMain ~= nil then box.edtCurrentXPMain.text = tostring(total - spent); end;
			end;

			-- What a dataLink, an onShow or an onNodeReady calls: it paints its own tab, and
			-- it stands down while the sheet is writing to itself (SPEC V107).
			function renderXPBoxes(form, spent)
				if xpQuiet then return; end;

				xpPaint(form, spent);
			end;

			-- What a CLICK calls (SPEC V133/V142). Buying a dot never writes xpTotal - Spent
			-- and Current are worked out (SPEC V100) - so no dataLink wakes up and this is the
			-- only thing that moves a number on the screen. It climbs to the sheet root, so
			-- every box on every loaded tab follows a purchase made on any of them, and it
			-- never asks xpQuiet: a player's click is not a batch of the sheet's own writes.
			function renderAllXPBoxes(from, spent)
				if from == nil then return; end;

				xpPaint(tabRootOf(from), spent);
			end;

			-- Both refusals the sheet can hand the player - no balance left for a dot, and a
			-- balance typed below zero - come out through here (SPEC V129/V131). Authored in
			-- English and shown through the sheet's own translation (SPEC V70/V130); the
			-- Settings tab owns that map, and on a sheet where it has not loaded the English
			-- is still the right thing to read.
			local function xpWarn(msg)
				local txt = msg;

				if translateSheetText ~= nil then
					txt = translateSheetText(msg, (sheet ~= nil and sheet.language) or "en");
				end;

				Dialogs.showMessage(txt);
			end;

			-- The player types the BALANCE, never the total (SPEC I11): the storyteller hands
			-- out 10 experience, the number in that box goes up by 10, and the total behind it
			-- follows. Spending moves the same box down on its own, through the log.
			function xpSetCurrent(form, typed)
				if sheet == nil then return; end;

				local n = tonumber(typed) or 0;

				-- SPEC V131: experience never goes below zero. The typed number is REFUSED,
				-- not clamped - clamping would write xpTotal = Spent, and one mistyped minus
				-- sign would cost the player every point they had earned. Nothing is written,
				-- so the box simply comes back to the balance that is stored.
				if n < 0 then
					renderAllXPBoxes(form);
					xpWarn("Experience cannot go below zero");
					return;
				end;

				setField("xpTotal", n + xpSpent());

				-- The whole sheet, not the tab that was typed on: the balance is drawn twice
				-- (SPEC I11) and one of the two would otherwise sit on the old number until
				-- something else happened to redraw it (SPEC V133).
				renderAllXPBoxes(form);
			end;

			-- The experience log lives on the Progress tab, which owns the four columns and
			-- their widths. It is handed the sheet ROOT rather than its own form (SPEC V133):
			-- the renderer finds its columns by name from whatever node it is given, so the
			-- log follows a purchase made on any tab without anyone having registered
			-- anything (SPEC B39). Called with the rows the caller already built - walking the
			-- ledger again for the same click is the waste the 39th round removed (SPEC B34).
			--
			-- The guard stays: on a sheet where the Progress tab never loaded there is no
			-- renderer and nothing to draw on - nothing here raises.
			local function xpLedgerRefresh(from, rows)
				if from ~= nil and renderXPLedger ~= nil then
					renderXPLedger(tabRootOf(from), rows);
				end;
			end;

			-- The storyteller types SPENT, and what that writes is a LINE in the log (SPEC I44,
			-- V246): `xpManual` carries the difference between the figure typed and what the log
			-- already adds up to, so reading the box back gives exactly what was typed, and a
			-- dot bought afterwards still moves it. An absolute override would have frozen the
			-- number and let the log disagree with it in front of the player (SPEC V100).
			--
			-- It does not sit beside xpSetCurrent, where it belongs by subject: it calls
			-- xpLedgerRefresh, and a body written above a `local function` compiles a GETGLOBAL
			-- and calls nil (SPEC B51, V223).
			function xpSetSpent(form, typed)
				if sheet == nil then return; end;

				local rows = xpLedgerRows();

				-- No snapshot means no log, and a correction to a log that does not exist would
				-- be a number nothing on the sheet could show. Refused out loud, in the sentence
				-- the log itself uses for this state (SPEC V33, V129).
				if rows == nil then
					renderAllXPBoxes(form);
					xpWarn("Initial character not saved yet");
					return;
				end;

				local n = tonumber(typed) or 0;

				-- SPEC V246d: refused, not clamped - the same call V131 makes for the balance.
				-- Nothing is written, so the box comes straight back to what the log adds up to.
				if n < 0 then
					renderAllXPBoxes(form);
					xpWarn("Experience cannot go below zero");
					return;
				end;

				-- What the log says WITHOUT the correction, so the correction can be worked out
				-- against it. Reading xpSum(rows) alone would fold the old adjustment into the
				-- new one and the box would drift by its own value on every second edit.
				local logged = xpSum(rows) - (tonumber(sheet.xpManual) or 0);

				setField("xpManual", n - logged);

				-- The correction is a LINE (SPEC I44), so it takes a place in the order like any
				-- other: at the top, the moment it is typed (SPEC I56). One line means one key -
				-- the old stamp comes out before the new one goes in, or the string ends up
				-- carrying two copies of a row that only ever exists once.
				--
				-- Back to no stamp at all when the adjustment is zero, because that is the state
				-- in which the row is not drawn: read off the field just written rather than the
				-- arithmetic above it, so what is stamped and what is shown answer to one number.
				local ord = (string.gsub(sheet.xpOrder or "", "|xpManual#0|", "|"));

				if (tonumber(sheet.xpManual) or 0) ~= 0 then ord = ord .. "|xpManual#0|"; end;

				setField("xpOrder", ord);

				renderAllXPBoxes(form);
				xpLedgerRefresh(form);
			end;

			-- The dot that fired, found by the field it is bound to. onChange hands over the
			-- form, not the control (SPEC R39 - the event carries no arguments), and naming all
			-- sixty-four dots in the XML would touch ten templates to answer a question nobody
			-- asks except on a refused click (SPEC V132).
			local function findDot(node, field)
				local children = node:getChildren();

				if children == nil then return nil; end;

				for i = 1, #children, 1 do
					local c = children[i];

					if c.field == field then return c; end;

					local found = findDot(c, field);

					if found ~= nil then return found; end;
				end;

				return nil;
			end;

			-- The mark itself, made in one step: the field the sheet is saved from and the
			-- control the player is looking at (SPEC V135). With autoChange="false" the dot
			-- writes neither of them on its own, so both are this function's job.
			local function markDot(form, field, v)
				setField(field, v);

				local dot = findDot(form, field);

				if dot ~= nil then dot.checked = v; end;
			end;

			-- The free speciality (SPEC I14). A trait reaching four - or one, for the five
			-- abilities the book hands a speciality to straight away - fills the next empty row
			-- with that trait's name, lights its dot and stamps it free. The text box is left
			-- alone: what the speciality IS is the player's to write (SPEC V152).
			--
			-- It hangs off the click that REACHES the rating and nowhere else (SPEC V150): no
			-- observer, no sweep at load. A sheet that already stood at four before this version
			-- is given nothing, because nothing recorded what was granted before the stamp
			-- existed to record it.
			--
			-- Returns whether it wrote anything, so the caller knows its ledger rows are stale.
			-- Is THIS row a gift? One question, one line, and the primitive under all three
			-- places that ask about the stamp: the lock, the dedup and the revoke (SPEC V160).
			function isFreeRow(field)
				return string.find(sheet.xpFree or "", "|" .. field .. "#1|", 1, true) ~= nil;
			end;

			-- Where is the gift for this trait? A row only counts as the gift if it carries the
			-- stamp as well as the name (SPEC V151/V160): a speciality the player PAID for on
			-- the same trait neither uses the free one up nor gets taken away with it.
			local function freeRowOf(name)
				for i = 1, SPECIALITY_ROWS, 1 do
					if sheet["speciality_" .. i] == name and isFreeRow("speciality_" .. i) then return i; end;
				end;

				return nil;
			end;

			local function grantSpeciality(form, trait, reached)
				local t = SPEC_TRAIT[trait];

				if t == nil or reached ~= t.free then return false; end;
				if freeRowOf(t.name) ~= nil then return false; end;

				local stamps = sheet.xpFree or "";
				local slot   = nil;

				-- The slot the gift takes is a PICKER row (SPEC V255d): a typed row is locked by nothing,
				-- so a granted specialty written into one could be typed over and the stamp would stay.
				for i = 1, SPECIALITY_ROWS - SPECIALITY_FREE_ROWS, 1 do
					local v = sheet["speciality_" .. i];

					if slot == nil and (v == nil or v == "") then slot = i; end;
				end;

				-- The gift fails on its own (SPEC V153): the dot that earned it stays bought,
				-- because the player asked for that one and got it.
				if slot == nil then
					xpWarn("No free specialty slot");
					return false;
				end;

				-- Name, mark and stamp in one step - exactly what a free purchase writes
				-- (SPEC V152). The line is then priced at zero by the rule that prices any
				-- stamped dot (SPEC V139), so no second cost table exists to disagree with it.
				setField("speciality_" .. slot, t.name);
				markDot(form, "speciality_" .. slot .. "_1", true);
				setField("xpFree", stamps .. "|speciality_" .. slot .. "#1|");

				return true;
			end;

			-- The mirror of the grant (SPEC V158): the gift exists exactly while the trait
			-- stands at the rating that gave it. Expression hands one over at the first dot, so
			-- selling from four down to one takes nothing away and selling the LAST point does;
			-- Medicine hands one over at the fourth, so the first sale takes it.
			--
			-- The whole row goes back to the pool - trait, text, dot and stamp together (SPEC
			-- V159). Half a row, with the trait still showing and the dot out, would hold a slot
			-- for ever and say nothing. The typed text goes with it: that is what losing the
			-- gift costs.
			local function revokeSpeciality(form, trait, reached)
				local t = SPEC_TRAIT[trait];

				if t == nil or reached >= t.free then return false; end;

				local slot = freeRowOf(t.name);

				if slot == nil then return false; end;

				setField("speciality_" .. slot, "");
				setField("specialityName_" .. slot, "");
				markDot(form, "speciality_" .. slot .. "_1", false);
				setField("xpFree", (string.gsub(sheet.xpFree or "", "|speciality_" .. slot .. "#1|", "|")));

				return true;
			end;

			-- The gift, both ways, from the one rating the click lands on (SPEC V158): buying
			-- into the rating that grants hands one over, selling out of it takes it back. Both
			-- accepted paths through xpClick ask this and nothing else, so the two directions
			-- cannot drift apart.
			--
			-- Says whether the sheet was written to, which is what tells the caller its ledger
			-- rows are stale and the box needs repainting.
			local function specialityMoved(form, trait, want, level)
				if want then return grantSpeciality(form, trait, level + 1); end;

				return revokeSpeciality(form, trait, level - 1);
			end;

			-- A gift is not the player's to change (SPEC V161): the trait combo of a stamped row
			-- is switched off, so the only way to lose the speciality is to lower the trait that
			-- handed it over. The dot is refused inside xpClick instead - it carries an onClick,
			-- which is what tells the sheet a dot is editable (SPEC V111), so it must not be
			-- dimmed. The typed text stays the player's on every row (SPEC V163).
			--
			-- enabled and opacity are written in the same breath, so a row cannot look locked
			-- while it is open, or the other way round (SPEC V162, the same rule the Save button
			-- follows on WoD20.10).
			--
			-- Controls are found with the one walker (SPEC V143/V164): this runs on the root
			-- form, and `form.<name>` does not cross the <import> into WoD20.1.
			-- Which blood sorcery owns a path, DERIVED from BLOOD_SORCERY at load (SPEC V191).
			-- Not a second table: BLOOD_SORCERY reads Discipline-to-paths because that is how
			-- the books print it, and every reader here needs the arrow the other way round.
			-- Building it costs one pass and cannot fall out of step with its source.
			--
			-- The value is a LIST because a path can have two owners - the core (p. 440) hands
			-- Movement of the Mind and Hands of Destruction to Assamite Sorcery as well as to
			-- Thaumaturgy - the same shape RITUAL_DISC uses for the same reason.
			local PATH_DISC = {};

			for disc, paths in pairs(BLOOD_SORCERY) do
				for i = 1, #paths, 1 do
					local p = paths[i];

					if PATH_DISC[p] == nil then PATH_DISC[p] = {}; end;

					PATH_DISC[p][#PATH_DISC[p] + 1] = disc;
				end;
			end;

			-- What every Discipline on THIS sheet stands at, as one map, built in ONE pass over
			-- the nineteen rows. Both boxes are walked: the four clan slots and the fifteen open
			-- ones hold the same kind of thing and are offered the same list (SPEC V178), so a
			-- Discipline typed into an open slot counts exactly as much as one sitting in its
			-- clan slot - the same reading the ledger takes when it prices a dot (SPEC I9b).
			--
			-- Highest wins if the same Discipline was typed twice. The sheet does not stop the
			-- player doing that, and answering with the lower of the two would silently take a
			-- path away from someone who owns it.
			--
			-- A MAP and not a per-name lookup, because the picker filter (SPEC I25) asks this
			-- question once per ITEM: twenty-five ritual combos times 284 items times nineteen
			-- rows times five dots of field reading, on every click of a Discipline dot, is a
			-- tab that locks up with no error for anyone to see (SPEC V205). The map is built
			-- once per render and handed down, so there is nothing to cache between renders and
			-- nothing to go stale.
			--
			-- Global because WoD20.6 builds it before its own traversals (SPEC I25).
			function discLevels()
				local levels = {};

				if sheet == nil then return levels; end;

				local function scan(f)
					local name = sheet[f];

					if name == nil or name == "" then return; end;

					local n = traitLevel(sheet, f, 1, 5, 0);

					if levels[name] == nil or n > levels[name] then levels[name] = n; end;
				end;

				for i = 1, CLAN_DISC_ROWS, 1 do scan("clanDisc_" .. i); end;
				for i = 1, DISC_ROWS, 1 do scan("disc_" .. i); end;

				return levels;
			end;

			-- The level each hedge magic PATH stands at, as a map (SPEC I83d, V310d). Same shape
			-- and same reasons as discLevels above it: built once per render and handed down,
			-- because the ritual filter asks the question once per ITEM and seventeen rows of
			-- five dots per item is the tab that locks up with no error for anyone to see
			-- (SPEC V205).
			--
			-- All SEVENTEEN rows, the five TYPED ones included - the same reading discLevels
			-- takes of clanDisc and disc together. A path the storyteller wrote by hand holds
			-- its dots like any other, and it simply matches no key in HEDGE_RITUAL_PATH, so it
			-- unlocks nothing. That is the right answer and not an oversight (SPEC I71).
			--
			-- A map of its OWN and not discLevels reused, and this is the leg that gives no
			-- symptom when it is wrong: `Necromancy` and `Weather Control` are BOTH a hedge magic
			-- path and a vampire Discipline/path. WoD20.6 already measures that collision for the
			-- era axis. One shared map would let Necromancy the DISCIPLINE, at five, open the
			-- rituals of Necromancy the hedge PATH (SPEC B15, V34 - one name, two senses).
			--
			-- Highest wins if the same path was named twice, for the reason discLevels gives:
			-- answering with the lower would take away a level the player owns.
			--
			-- Global because WoD20.6 builds it inside the picker memo (SPEC I83f).
			function hedgePathLevels()
				local levels = {};

				if sheet == nil then return levels; end;

				for i = 1, NUMINA_ROWS, 1 do
					local f    = "numina_" .. i;
					local name = sheet[f];

					if name ~= nil and name ~= "" then
						local n = traitLevel(sheet, f, 1, 5, 0);

						if levels[name] == nil or n > levels[name] then levels[name] = n; end;
					end;
				end;

				return levels;
			end;

			-- The level a path stands at: the rating of its own blood sorcery (SPEC V180). A path
			-- with two owners takes the higher - the player reaches it through whichever of the
			-- two Disciplines he actually bought.
			--
			-- An empty row, or a value no Discipline claims, answers 0. That is what keeps a
			-- blank main path row dark instead of inheriting the row above it (SPEC V180).
			local function pathLevel(path, levels)
				local owners = (path ~= nil and path ~= "") and PATH_DISC[path] or nil;

				if owners == nil then return 0; end;

				local best = 0;

				for i = 1, #owners, 1 do
					local n = levels[owners[i]] or 0;

					if n > best then best = n; end;
				end;

				return best;
			end;

			-- The five main path rows (SPEC V180). Their dots are read-only art - no field, no
			-- click (SPEC V179) - so this writes `checked` on the control and NOTHING to the
			-- sheet. That is the whole point: the level is worked out at every render from the
			-- Discipline, so there is no second number saved anywhere that could disagree with
			-- the first (the same reason the experience boxes are derived, SPEC V100).
			--
			-- Found through xpFind from the tab root, the one finder this sheet has (SPEC V143):
			-- `form.<name>` does not cross the <import> from WoD20.11 into WoD20.13 (SPEC B9).
			function renderMainPaths(from)
				if sheet == nil or from == nil then return; end;

				local names = {};

				for i = 1, MAIN_PATH_ROWS, 1 do
					for d = 1, 5, 1 do names["ro_mainPath_" .. i .. "_" .. d] = true; end;
				end;

				local found = {};

				xpFind(tabRootOf(from), names, found);

				-- One pass over the Disciplines for the whole render, not one per row
				-- (SPEC V205).
				local levels = discLevels();

				for i = 1, MAIN_PATH_ROWS, 1 do
					local n = pathLevel(sheet["mainPath_" .. i], levels);

					for d = 1, 5, 1 do
						local c = found["ro_mainPath_" .. i .. "_" .. d];

						if c ~= nil then c.checked = (d <= n); end;
					end;
				end;
			end;

			-- Do two paths answer to the same blood sorcery? Both sides are LISTS, because a
			-- path can have two owners (core p. 440), so the question is whether the two lists
			-- share anything at all - not whether they are equal.
			local function sharesDisc(a, b)
				if a == nil or b == nil then return false; end;

				for i = 1, #a, 1 do
					for j = 1, #b, 1 do
						if a[i] == b[j] then return true; end;
					end;
				end;

				return false;
			end;

			-- Why a picked value cannot sit in the row it landed in, or nil when it can. The
			-- reason comes back as the message itself: a refusal that does not say which rule
			-- it is enforcing is the complaint the 40th round was opened to answer (SPEC V129).
			--
			-- The empty item is ALWAYS legal (SPEC V15). That is not a courtesy - it is what
			-- makes the revert below terminate.
			--
			-- `levels` comes from discLevels() and is asked for by the CALLER, once per render
			-- (SPEC V205). Reading it here per call is what the filter cannot afford, and an
			-- argument the caller must pass is a cache nobody has to remember to invalidate.
			--
			-- This is the ONE place that knows what is legal (SPEC V199). The guard below reverts
			-- what it refuses; the picker filter never offers it in the first place. Both ask the
			-- same function, so a list cannot offer what the guard would throw back.
			local function pickRefusal(field, value, levels)
				if field == nil or value == nil or value == "" then return nil; end;

				-- A TYPED row answers to no table (SPEC I45, V248d): there is no list it came
				-- from, so there is nothing to check it against and nothing to send back. Without
				-- this the storyteller could not write a secondary path at all - a name no blood
				-- sorcery claims is exactly what V182 refuses.
				if isTypedRow(field) then return nil; end;

				local isMain = string.match(field, "^mainPath_%d+$") ~= nil;

				if isMain or string.match(field, "^secPath_%d+$") ~= nil then
					-- SPEC V182: the path's own blood sorcery has to be on the sheet. Koldunic
					-- Sorcery at four opens no Thaumaturgy path, however high it is.
					if pathLevel(value, levels) < 1 then
						return "That path needs its blood sorcery on the sheet";
					end;

					-- SPEC V181: one main path per blood sorcery. Secondary rows are not capped
					-- this way - that is what makes them secondary.
					if isMain then
						local mine = PATH_DISC[value];

						for i = 1, MAIN_PATH_ROWS, 1 do
							local f = "mainPath_" .. i;

							if f ~= field and sheet[f] ~= nil and sheet[f] ~= "" then
								if sharesDisc(mine, PATH_DISC[sheet[f]]) then
									return "That blood sorcery already has a main path";
								end;
							end;
						end;
					end;

					return nil;
				end;

				if string.match(field, "^ritual_%d+$") ~= nil then
					local owners = RITUAL_DISC[value];

					-- A value no table claims is left alone. Refusing what we cannot price would
					-- make a typo unrecoverable, and the picker only offers what the tables know.
					if owners == nil then return nil; end;

					-- The level is read off the NAME (SPEC V184), never from a second table that
					-- could disagree with it. Abyss Mysticism runs past five, so the prefix is
					-- one digit but not one of 1..5.
					local need = tonumber(string.match(value, "^(%d+)%. ")) or 0;
					local best = 0;

					for i = 1, #owners, 1 do
						local n = levels[owners[i]] or 0;

						if n > best then best = n; end;
					end;

					-- SPEC V185: absent Discipline frees no level at all, and the two refusals
					-- are told apart because "you do not have it" and "you do not have enough of
					-- it" are different problems with different fixes.
					if best < 1 then return "That ritual needs its blood sorcery on the sheet"; end;
					if best < need then return "That ritual is above what its blood sorcery allows"; end;
				end;

				return nil;
			end;

			-- The picker guard (SPEC V181/V182/V185). Reached from a dataLink, never from the
			-- comboBox's own onChange (SPEC V186): a write made inside a control's dispatch does
			-- not survive it, which is how B36 and B38 both got their refusals ignored.
			--
			-- The revert goes back to oldValue only when oldValue is ITSELF legal. It usually is
			-- - it was accepted once - but not always: the Discipline that allowed it may have
			-- come off the sheet since, and reverting into a second refusal is how a link starts
			-- bouncing between two illegal values forever. Falling through to the empty item
			-- always terminates, because the empty item always passes.
			function guardPick(field, oldValue, newValue)
				if sheet == nil or field == nil then return; end;

				local levels = discLevels();
				local why = pickRefusal(field, newValue, levels);

				if why == nil then return; end;

				local back = (pickRefusal(field, oldValue, levels) == nil) and oldValue or "";

				setField(field, back);
				xpWarn(why);
			end;

			-- Does the affiliation on the sheet leave this value on offer (SPEC I67, I68)? A key
			-- the table does not hold means "filters nothing", so `Lone Practitioner` and the
			-- unanswered empty item open the whole list rather than an empty one (SPEC V271d,
			-- V272e). The affiliation is read RAW: one typed by hand behind the storyteller's
			-- flag matches no key and therefore prunes nothing, which is the right answer and
			-- not an accident (SPEC I71).
			--
			-- Declared above pickAllowed rather than below it: a local called from above its own
			-- declaration compiles to a GETGLOBAL that finds nil at runtime, with rdk exiting 0
			-- (SPEC V223, B51).
			-- Does the sheet carry the path this ritual comes from, at the ritual's own level
			-- (SPEC I83a, V310)? The level is read off the item text and nowhere else, the same
			-- `<n>. ` grammar hedgeRitualLevel prices with (SPEC V269d).
			--
			-- A value HEDGE_RITUAL_PATH does not know is left alone, exactly as the two
			-- affiliation filters leave an unlisted affiliation alone (SPEC V271d, V272e). While
			-- the ritual list is still empty this is the branch every call takes, and a `false`
			-- here would open twelve blank dropdowns instead of doing nothing.
			--
			-- `levels` is the map hedgePathLevels() builds, handed in by the caller so it is
			-- built once per render and not once per item (SPEC V205, I83f). Without it there is
			-- nothing to measure against, so nothing is pruned.
			--
			-- Declared above pickAllowed, not below: a local called from above its own
			-- declaration compiles to a GETGLOBAL that finds nil at runtime (SPEC V223, B51).
			local function hedgeRitualAllows(value, levels)
				if value == nil or value == "" or levels == nil then return true; end;

				local path = HEDGE_RITUAL_PATH[value];

				if path == nil then return true; end;

				local need = tonumber(string.match(value, "^(%d+)%. ")) or 0;

				return (levels[path] or 0) >= need;
			end;

			local function hedgeAllows(t, value)
				if value == nil or value == "" then return true; end;

				local ok = t[(sheet ~= nil and sheet.hedgeAffiliation) or ""];

				if ok == nil then return true; end;

				for i = 1, #ok, 1 do
					if ok[i] == value then return true; end;
				end;

				return false;
			end;

			-- The one door the picker filter has to the rule (SPEC I25, V199). It is the same
			-- body the guard above asks, phrased as a yes: the filter has no message to show, it
			-- simply leaves the item out. A second test written for the list is how the list and
			-- the guard start disagreeing about what is legal, which is why there is not one.
			--
			-- The two affiliation branches answer HERE and not inside pickRefusal, and the split
			-- is the point (SPEC I67, T605): pickRefusal is what guardPick REVERTS with, and a
			-- path that stopped being favoured must not be thrown off the sheet - it simply stops
			-- being offered (SPEC V200). Nothing guards these two fields, so there is no second
			-- opinion for the list to disagree with.
			--
			-- `numina_1` alone, never `numina`: the Affinity Path is ONE row, and the book has the
			-- magician choose one from the list (M20 Sorcerer p. 8). `hedgeAttr` is a SINGLETON
			-- and carries no row number at all (SPEC I68).
			--
			-- The ritual branch is the OPPOSITE scope and by the same rule (SPEC I83g, V203): all
			-- twelve picked rows answer to one question - does the sheet carry the path, at the
			-- level - so it is matched by ROW, `^hedgeRitual_%d+$`, and not by a name. The five
			-- typed rows never reach here: they carry an `edt` and the walk asks for `cbo`
			-- (SPEC V248c).
			--
			-- `hedge` is the FOURTH argument and it is the hedge path map, not the Discipline
			-- one. Nothing guards these fields, so - like the two above - a ritual whose path
			-- came DOWN stays on its row and simply stops being offered (SPEC V200, I83h).
			function pickAllowed(field, value, levels, hedge)
				if field == "numina_1" then return hedgeAllows(AFFINITY, value); end;
				if field == "hedgeAttr" then return hedgeAllows(CASTING_ATTR, value); end;
				if field ~= nil and string.match(field, "^hedgeRitual_%d+$") ~= nil then
					return hedgeRitualAllows(value, hedge);
				end;

				return pickRefusal(field, value, levels) == nil;
			end;

			-- The four clan slots are the storyteller's to open (SPEC I8g, V175). Locked is the
			-- DEFAULT and nil counts as locked, the same fail-closed reading the Show flags use
			-- (SPEC V89, V80): a sheet saved before the flag existed must not find the box open.
			--
			-- `enabled` and `opacity` are written on the SAME line (SPEC V162): a combo that looks
			-- locked and is not - or the reverse - is the exact failure V111 exists to stop. Found
			-- through xpFind from the tab root, the one finder this sheet has (SPEC V143).
			function renderClanDiscLock(from)
				if sheet == nil or from == nil then return; end;

				local names = {};

				for i = 1, CLAN_DISC_ROWS, 1 do names["cboclanDisc_" .. i] = true; end;

				local found = {};

				xpFind(tabRootOf(from), names, found);

				-- Open when the storyteller says so, and ALSO when the clan itself settles nothing:
				-- six of the sixty entries carry a `choice` or an `open` instead of a settled trio,
				-- and those slots have nobody to fill them but the table (SPEC I37, V236d). A clan
				-- that DOES settle its trio is still fail-closed behind the flag (SPEC V175, V89).
				local entry   = CLANS[sheet.clanFamily or ""];
				local settled = entry ~= nil and entry.choice == nil and entry.open == nil;
				local open    = (sheet.stEditClanDisc == true) or not settled;

				for i = 1, CLAN_DISC_ROWS, 1 do
					local c = found["cboclanDisc_" .. i];

					if c ~= nil then
						-- `enabled` and nothing else (SPEC I41, V241, user 2026-08-22). `opacity` lives on
						-- gui.Control and dims the WHOLE control, the text with it, and a comboBox has no
						-- text-only opacity to reach for - so a locked dropdown was unreadable, which is
						-- the opposite of what a lock is for. What it looks like disabled is the HOST's
						-- call now, and only the Firecast can answer that (SPEC R98).
						c.enabled = open;
					end;
				end;
			end;


			-- The domitor's clan says which Disciplines are in-clan, and filling Clan/Family is what
			-- says the domitor's clan (SPEC I37, user 2026-08-22). A ghoul learns what that clan
			-- teaches, and learns it from ZERO - so this writes NAMES and never a dot.
			--
			-- It lives on the ROOT form for the reason B26 cost a round: the four slots are drawn in
			-- WoD20.12, inside a MANAGED tab that a table with Show Ghoul off never opens, and a tab
			-- that may not be there cannot be what keeps the sheet correct (SPEC V95).
			--
			-- `clan` - the dormant combo on the Main tab - is NOT written here and stays asleep
			-- (SPEC V173). What plays the part of the clan today is `clanFamily` (SPEC B50): one
			-- field, not two mirroring each other into disagreement.
			function renderClanDisc(from)
				if sheet == nil or from == nil then return; end;

				-- CLANS (SPEC I17) was frozen from the books by T430 and sat dormant for fifty
				-- rounds. The 82nd re-extracted the same sixty entries into a second table before
				-- noticing (SPEC B55); this reads the one that was already here, and it carries the
				-- better shape: `fixed` is what the clan settles, `choice` enumerates a third the
				-- book leaves open, `open` counts slots that come from the sire and can be anything.
				local entry = CLANS[sheet.clanFamily or ""];

				if entry ~= nil then
					local fixed = entry.fixed or {};

					for i = 1, CLAN_DISC_ROWS, 1 do
						local field = "clanDisc_" .. i;
						local name  = fixed[i];

						-- Past what the clan settles, who owns the slot depends on WHY it is open:
						--   `open`   - anything is legal, so nothing here can tell a leftover from a
						--              pick, and the slot is left exactly as the table left it;
						--   `choice` - the legal values are enumerated, so a leftover from the clan
						--              before IS recognisable and goes, while a legal pick stays;
						--   neither  - the clan settles every slot, so the rest is emptied.
						if name == nil then
							if entry.open ~= nil then name = nil;
							-- `choiceN` says how many slots come out of `choice`, and ABSENT means one
							-- (SPEC I17). Only Keskinen declares it, with two - without the count a
							-- family that fixes one Discipline would leave every remaining slot open
							-- and hand out picks the book never gave.
							elseif entry.choice ~= nil and i <= #fixed + (entry.choiceN or 1) then
								name = "";

								for c = 1, #entry.choice, 1 do
									if sheet[field] == entry.choice[c] then name = nil; break; end;
								end;
							else name = ""; end;
						end;

						if name ~= nil then
							-- Only a slot whose NAME changes is touched, which is what makes reopening a
							-- sheet cost nothing: the dots of a slot that already reads Auspex are
							-- somebody's purchase and they stay where they are (SPEC V237).
							if sheet[field] ~= name then
								setField(field, name);

								-- The name and the dots go in the SAME pass (SPEC V237): a dot bought
								-- under Auspex is not a dot of Celerity, and the ledger prices by the
								-- name it finds (SPEC I9, I10b) - so leaving them would surface weeks
								-- later as an experience total nobody can account for.
								for d = 1, 5, 1 do setField(field .. "_" .. d, false); end;
							end;
						end;
					end;
				end;

				renderClanDiscLock(from);
			end;

			function renderSpecialities(from)
				if sheet == nil or from == nil then return; end;

				-- Only the PICKER rows: the last three are typed and have no combo to find, let alone
				-- to lock (SPEC I50, V255d).
				local names = {};

				for i = 1, SPECIALITY_ROWS - SPECIALITY_FREE_ROWS, 1 do names["cboSpeciality" .. i] = true; end;

				local found = {};

				xpFind(tabRootOf(from), names, found);

				for i = 1, SPECIALITY_ROWS - SPECIALITY_FREE_ROWS, 1 do
					local c = found["cboSpeciality" .. i];

					if c ~= nil then
						local locked = isFreeRow("speciality_" .. i);

						-- Same as the clan slots: the lock is `enabled`, and the text stays legible
						-- (SPEC I41, V241). A free speciality is one the trait handed out, and reading
						-- WHICH one is the whole point of showing the row.
						c.enabled = not locked;
					end;
				end;
			end;

			-- Every dot that costs experience calls this when it is CLICKED (SPEC I13/V99).
			-- The dot is autoChange="false" (SPEC V134), so nothing has happened yet: the mark
			-- is this function's to make, and it is made only if the rules allow it.
			--
			-- Three rounds tried letting the mark happen and taking it back (SPEC B36/B38). A
			-- write made from inside the dot's own onChange - to the field or to the control -
			-- does not survive the end of the dispatch, so no undo could ever stick. Deciding
			-- first is not a way around that; it is what the sheet should have done all along.
			--
			-- It writes no experience at all (SPEC V100): a purchase pays for itself the moment
			-- the dot reaches the log, and taking the dot back off refunds by the same
			-- subtraction.
			--
			-- The ability rows hand in the field their dot is bound to RIGHT NOW, because the
			-- era rebinds those five dots to another ability's field (SPEC V76) - the name
			-- written in the .lfm is only the Victorian one.
			function xpClick(field, form)
				if sheet == nil or field == nil or field == "" then return; end;

				-- What the click is ASKING for. The dot cannot flip itself, so this is a
				-- request, not a fact.
				local want = not (sheet[field] == true);
				local base = baselineOf();

				local trait = string.match(field, "^(.+)_%d+$");
				local t     = trait ~= nil and XP_TRAIT[trait] or nil;

				-- The rating the trait stands at right now. The click moves it by one, either
				-- way, so this is both the level a purchase REACHES and the level a sale leaves
				-- behind (SPEC V138/V141).
				local level = (t ~= nil) and traitLevel(sheet, trait, t.first, t.last, t.fixed) or 0;

				-- The speciality rows answer to rules of their own, and they are settled before
				-- anything else because one of them holds while the character is still being
				-- built (SPEC V161): a gift is never the player's to take off. The storyteller's
				-- door is the exception - it only means anything once the sheet is frozen, so it
				-- waits for the baseline (SPEC V101).
				--
				-- Every refusal here speaks. A refusal with no reason on screen is the complaint
				-- the 40th round was opened to answer (SPEC V129/V130).
				if trait ~= nil and string.match(trait, "^speciality_%d+$") ~= nil then
					if not want and isFreeRow(trait) then
						xpWarn("Free specialties are lost only by lowering the trait");
						return;
					end;

					if want and (sheet[trait] == nil or sheet[trait] == "") then
						xpWarn("Choose a trait first");
						return;
					end;

					-- Written flat rather than nested under a purchase block: the balance branch
					-- further down opens the same way, and two of them read as one.
					if want and base ~= nil and specForbidden() then
						xpWarn("Specialties cannot be bought");
						return;
					end;
				end;

				-- A secondary path is capped by its OWN blood sorcery (SPEC V183): a Discipline
				-- at four allows three, and only at five does the ceiling come off and let a
				-- secondary path reach five as well. `pathLevel` is the same reading the main
				-- path dots use (SPEC V180), so the ceiling and the lit dots cannot disagree.
				--
				-- Tested HERE, before anything is written - not after. A guard that lets the
				-- mark happen and argues afterwards is the failure the 38th round spent three
				-- rounds chasing (SPEC V135, B38). Nothing below this point runs on a refusal,
				-- so there is no field to put back and no dot to flicker.
				--
				-- Only a PURCHASE is capped. A dot going out cannot break a ceiling, and
				-- selling back is already governed by the baseline (SPEC V103).
				if want and trait ~= nil and string.match(trait, "^secPath_%d+$") ~= nil then
					if sheet[trait] == nil or sheet[trait] == "" then
						xpWarn("Choose a path first");
						return;
					end;

					local n   = pathLevel(sheet[trait], discLevels());
					local cap = (n >= 5) and 5 or (n - 1);

					if (level + 1) > cap then
						xpWarn("That path is above what its blood sorcery allows");
						return;
					end;
				end;

				-- The domitor's generation caps every Discipline on the sheet (SPEC I29, V220). Same
				-- shape and same place as the path ceiling above, on purpose: one refusal path for two
				-- rules, tested BEFORE anything is written, and it speaks (SPEC V129, V135, B38).
				--
				-- No generation means NO ceiling, which is not a ceiling of zero: a mortal with no
				-- domitor is not a fourteenth-generation ghoul (SPEC V220a).
				--
				-- Only the PURCHASE is asked. A dot already lit above the ceiling stays lit, so lowering
				-- the generation never takes away what the player had already bought (SPEC V220c, V187).
				if want and trait ~= nil and (string.match(trait, "^clanDisc_%d+$") ~= nil or string.match(trait, "^disc_%d+$") ~= nil) then
					local genCap = maxDiscLevel();

					if genCap ~= nil and (level + 1) > genCap then
						xpWarn("That Discipline is above what the dominator's generation allows");
						return;
					end;
				end;

				-- Nothing is priced while the character is being built: the rule starts when
				-- the storyteller freezes the sheet (SPEC V101).
				--
				-- The free speciality moves here as well, both ways: it is not a price, it is
				-- what the book hands out at that rating, and a character built to four before
				-- the sheet was frozen earned it just the same (SPEC V150/V158).
				if base == nil then
					markDot(form, field, want);

					if t ~= nil and specialityMoved(form, trait, want, level) then renderSpecialities(form); end;

					renderAllXPBoxes(form);
					return;
				end;

				-- Willpower's spent boxes (willpower_c1..c10) and anything else that is not a
				-- rating cost nothing, so they simply happen.
				if t == nil then markDot(form, field, want); return; end;

				-- SPEC V137: `Free dots` is read HERE, at the click, and in no other place on
				-- the sheet. That is what makes "free only if the box was ticked at the moment
				-- of purchase" true by construction: ticking it later cannot reach a price that
				-- was already settled, and unticking it cannot take back one that was not
				-- charged. The stamp carries the answer from here on (SPEC V138).
				local free = want and sheet.stFreeBuy == true;
				local key  = free and (trait .. "#" .. (level + 1)) or nil;

				-- The key this click would leave in the ORDER (SPEC I56). Same grammar as the
				-- price stamp above and built one line from it on purpose: two stamps that drift
				-- into two key shapes is what burned `freeDots` for good (SPEC V138, V260b).
				--
				-- A purchase reaches level+1; a sale gives back the level the dot is standing on
				-- right now. Same reading the sale of the price stamp already takes.
				local okey = trait .. "#" .. (want and (level + 1) or level);

				-- ONE walk, of the sheet as it WOULD be (SPEC V125/V135/V136): the balance
				-- boxes take the sum and the log takes the rows, and both already describe the
				-- state this click is about to create. A free click is priced with its stamp in
				-- hand, so the new line is already worth zero.
				local rows  = xpLedgerRows(field, want, key, want and okey or nil);
				local spent = xpSum(rows);

				if want then
					-- SPEC V135: refused BEFORE the mark. Nothing was written, so there is
					-- nothing to put back and nothing to flicker.
					--
					-- A free point skips the balance outright (SPEC V140) rather than passing it
					-- on the arithmetic: `spent` does not move, but a sheet already in the red -
					-- the storyteller can put it there by charging for backgrounds after the
					-- fact (SPEC C, 40th round) - would refuse a point that costs nothing.
					if not free and ((tonumber(sheet.xpTotal) or 0) - spent) < 0 then
						xpWarn("Not enough experience to buy that dot");
						return;
					end;
				else
					-- SPEC V103: only a point that is IN the log can be sold back. Below the
					-- baseline is the storyteller's character, not the player's purchase. The
					-- dot being switched off is on, so this would leave the trait one lower.
					local after = level - 1;

					if after < traitLevel(base, trait, t.first, t.last, t.fixed) then return; end;
				end;

				markDot(form, field, want);

				-- The stamp moves with the mark and only with it (SPEC V140/V141): written when
				-- a free purchase goes through, dropped when the point it paid for is sold. A
				-- sold point that is bought again obeys the flag of THAT click, which is the
				-- whole rule. Nothing here is written on a refusal - there is no refusal left
				-- to write on.
				if key ~= nil then
					setField("xpFree", (sheet.xpFree or "") .. "|" .. key .. "|");
				elseif not want and sheet.xpFree ~= nil then
					setField("xpFree", (string.gsub(sheet.xpFree, "|" .. trait .. "#" .. level .. "|", "|")));
				end;

				-- The ORDER stamp goes down with the same mark, on the line below the one that
				-- carries the price (SPEC V260a). Written apart from each other they drift, and
				-- what drift looks like here is a point sitting on top of the log with no price
				-- against it, or a price with no place in the order.
				--
				-- EVERY purchase stamps, the free one included, which is why this is a branch of
				-- its own instead of a line inside the one above: a point that cost nothing still
				-- happened, and the log shows it (SPEC I10, V120). Written after the mark and
				-- never on a refusal - there is no refusal left below this point (SPEC V140).
				if want then
					setField("xpOrder", (sheet.xpOrder or "") .. "|" .. okey .. "|");
				elseif sheet.xpOrder ~= nil then
					setField("xpOrder", (string.gsub(sheet.xpOrder, "|" .. okey .. "|", "|")));
				end;

				-- The gift, if this click earned one or lost one (SPEC I14/V158). Either way it
				-- writes a dot of its own, so the rows priced above no longer describe the sheet
				-- - a click that moves the gift walks the ledger a second time, and only that
				-- click does (SPEC V125).
				if specialityMoved(form, trait, want, level) then
					rows  = xpLedgerRows();
					spent = xpSum(rows);

					renderSpecialities(form);
				end;

				renderAllXPBoxes(form, spent);
				xpLedgerRefresh(form, rows);
			end;


			-- What the character has spent, straight off the log (SPEC I11). Not stored: a
			-- second copy of this number is the one thing that could disagree with the lines
			-- the player is reading (SPEC V100).
			-- Split from xpSpent so a caller holding the rows can total them without walking
			-- the ledger again (SPEC V125). nil is what xpLedgerRows returns when no initial
			-- character has been saved, and nothing has been spent against one that is not
			-- there.
			function xpSum(rows)
				if rows == nil then return 0; end;

				local sum = 0;

				for i = 1, #rows, 1 do sum = sum + rows[i].cost; end;

				return sum;
			end;

			function xpSpent()
				return xpSum(xpLedgerRows());
			end;
		]]>
	</script>
	<!--
		Eleven tabs (SPEC I1b / I1c). Disciplines sits next to Numina because both are power
		tabs, and Storyteller closes the row. Magika sat between them until the 39th round,
		when the user had the empty window removed: the content that would have filled it is
		Mage-only and stays off a mortal sheet (SPEC C, V128).

		Every tab carries a `name` because three of them are switched at runtime (SPEC I8b):
		the two power tabs answer to the storyteller's checkboxes and the Storyteller tab
		answers to the gate, so a player opens eight of these eleven.

		Each of those three is authored in the state its flag defaults to (SPEC V94, 28th
		round): Disciplines and Storyteller start hidden, Numina starts visible.
		The 27th round authored them all visible and left the hiding to the renderer, and a
		fresh sheet with every checkbox unticked opened with all three on show (SPEC B26) -
		so the static state fails CLOSED too, not just the gate in Lua.

		The whole control is authored HIDDEN and stays that way until sheetReveal lights it
		(SPEC I15, V166, B40): the host paints before any hook of ours runs (SPEC R47), and
		what it painted was the sheet as the XML authors it - a look no theme has offered
		since the 16th round. A second of nothing beats a second of the wrong sheet.

		This is a different mechanism from the three tabs above and they do not meet: this
		one is the whole control and is written once, on load; those are individual <tab>s
		and are written by applyTabVisibility every time the sheet is shown (SPEC V96).
	-->
	<!--
		The tab strip is OURS since the 78th round (SPEC I32). It is not a preference: the
		native strip has no look to change - gui.TabItem exposes text/title/activate and what
		it inherits from Control, gui.TabControl adds tabIndex, and putting color= on a <tab>
		makes rdk exit 1 with no message and delete the .rpk (SPEC B19, B49). A rectangle and
		a label are the one pair applyTheme reaches on both ends - THEME_SHAPES is rectangle
		only, and <button> is in THEME_TEXTS for its fontColor alone, so its face would stay
		host-drawn and the tabs would go on clashing (SPEC V226).
	
		The panes are N align="client" siblings with exactly one visible - PROVED in Firecast
		before a line of this was written (SPEC T521, R95). B41 does not forbid it: there the
		two siblings were both VISIBLE (the theme paper lit OVER the tabControl), so it was
		overlap, never sizing.
	
		Active is a rectangle that is SHOWN, never a colour written from Lua: applyTheme
		repaints a shape from the colour the XML authored (SPEC V57), so a Lua write here
		would be overwritten on the next repaint, or would have to join the ledger. Toggling
		`visible` contends with nothing and keeps the palette in charge of the palette.
	
		Authored hidden, like the tabControl it replaces: the host paints before any hook of
		ours runs (SPEC R47) and sheetReveal is still the one thing that lights it (V166).
	-->
	<layout name="sheetBody" align="client" visible="false">
		<layout name="tabStrip" align="top" height="40">
			<rectangle align="client" color="black" strokeColor="#00000000"/>

			<rectangle name="tabOnMain" left="30" top="5" width="99" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabMain" left="30" top="5" width="99" height="30" color="#00000000"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabMain', self);">
				<label left="0" top="0" width="99" height="20" text="Main" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>

			<rectangle name="tabOnTraits" left="133" top="5" width="79" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabTraits" left="133" top="5" width="79" height="30" color="#00000000"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabTraits', self);">
				<label left="0" top="0" width="79" height="20" text="Traits" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>

			<rectangle name="tabOnNumina" left="216" top="5" width="79" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabNumina" left="216" top="5" width="79" height="30" color="#00000000"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabNumina', self);">
				<label left="0" top="0" width="79" height="20" text="Numina" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>

			<rectangle name="tabOnDisciplines" left="299" top="5" width="92" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabDisciplines" left="299" top="5" width="92" height="30" color="#00000000" visible="false"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabDisciplines', self);">
				<label left="0" top="0" width="92" height="20" text="Ghoul" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>

			<rectangle name="tabOnCombat" left="395" top="5" width="86" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabCombat" left="395" top="5" width="86" height="30" color="#00000000"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabCombat', self);">
				<label left="0" top="0" width="86" height="20" text="Combat" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>

			<rectangle name="tabOnInventory" left="485" top="5" width="105" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabInventory" left="485" top="5" width="105" height="30" color="#00000000"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabInventory', self);">
				<label left="0" top="0" width="105" height="20" text="Inventory" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>

			<rectangle name="tabOnBackground" left="594" top="5" width="105" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabBackground" left="594" top="5" width="105" height="30" color="#00000000"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabBackground', self);">
				<label left="0" top="0" width="105" height="20" text="Background" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>

			<rectangle name="tabOnProgress" left="703" top="5" width="112" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabProgress" left="703" top="5" width="112" height="30" color="#00000000"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabProgress', self);">
				<label left="0" top="0" width="112" height="20" text="Experience" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>

			<rectangle name="tabOnNotes" left="819" top="5" width="99" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabNotes" left="819" top="5" width="99" height="30" color="#00000000"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabNotes', self);">
				<label left="0" top="0" width="99" height="20" text="Notes" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>

			<rectangle name="tabOnSettings" left="922" top="5" width="125" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabSettings" left="922" top="5" width="125" height="30" color="#00000000"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabSettings', self);">
				<label left="0" top="0" width="125" height="20" text="Settings" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>

			<rectangle name="tabOnStoryteller" left="1051" top="5" width="112" height="30" color="#00000000" strokeColor="#00000000"
			           xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
			<rectangle name="btnTabStoryteller" left="1051" top="5" width="112" height="30" color="#00000000" visible="false"
			           strokeColor="#00000000" strokeSize="1" xradius="14" yradius="14" cornerType="innerRound" hitTest="true" cursor="handPoint"
			           onClick="selectTab('tabStoryteller', self);">
				<label left="0" top="0" width="112" height="20" text="Storyteller" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
			</rectangle>
		</layout>

		<layout name="tabMain" align="client" visible="false">
			<import file="WoD20.1.lfm"/>
		</layout>

		<layout name="tabTraits" align="client" visible="false">
			<import file="WoD20.2.lfm"/>
		</layout>

		<layout name="tabNumina" align="client" visible="false">
			<import file="WoD20.7.lfm"/>
		</layout>

		<layout name="tabDisciplines" align="client" visible="false">
			<import file="WoD20.11.lfm"/>
		</layout>

		<layout name="tabCombat" align="client" visible="false">
			<import file="WoD20.3.lfm"/>
		</layout>

		<layout name="tabInventory" align="client" visible="false">
			<import file="WoD20.8.lfm"/>
		</layout>

		<layout name="tabBackground" align="client" visible="false">
			<import file="WoD20.4.lfm"/>
		</layout>

		<layout name="tabProgress" align="client" visible="false">
			<import file="WoD20.9.lfm"/>
		</layout>

		<layout name="tabNotes" align="client" visible="false">
			<import file="WoD20.5.lfm"/>
		</layout>

		<layout name="tabSettings" align="client" visible="false">
			<import file="WoD20.6.lfm"/>
		</layout>

		<layout name="tabStoryteller" align="client" visible="false">
			<import file="WoD20.10.lfm"/>
		</layout>
	</layout>

	<!--
		The tab switch is driven from HERE, though the checkboxes that feed it live on the
		Storyteller tab (SPEC V95, 28th round). That tab is one of the three this hides, and a
		hidden tab cannot be trusted to run the code that hides its neighbours - that is how a
		fresh sheet came up with all three power tabs on show (SPEC B26).
	-->
	<!--
		Filling Clan/Family fills the four clan Discipline slots (SPEC I37). Watched from HERE
		and not from WoD20.12, where the slots are drawn: that file is inside a managed tab,
		and a sheet whose table never turned Show Ghoul on would keep whatever the last clan
		left behind (SPEC V95, B26).
	-->
	<dataLink field="clanFamily">
		<event name="onChange">
			renderClanDisc(self);
		</event>
	</dataLink>

	<dataLink fields="{'stShowNumina', 'stShowDisciplines'}">
		<event name="onChange">
			applyTabVisibility(self);
		</event>
	</dataLink>

	<!--
		Shown again, asked again (SPEC V96). Nothing tells the sheet that its reader's role in
		the room changed - neither `jogador` nor `mesa` publishes an event, they are getters
		only (SPEC R34) - so the single answer taken at load would freeze: a storyteller who
		had opened this sheet as a player came back to it with no Storyteller tab, and the
		checkboxes that could have switched it back are ON that tab (SPEC B27). Leaving the
		sheet and opening it again is the way back.
	-->
	<event name="onShow">
		wodTrace("root.onShow");
		applyTabVisibility(self);
	</event>

	<event name="onNodeReady">
		wodTrace("root.onNodeReady");
		-- Everything seeded here is the sheet writing to itself, so it is written quietly: the
		-- Appearance dot would otherwise put the guard through a full walk of the ledger before
		-- the sheet is even on screen (SPEC V107).
		xpQuiet = true;

		-- A sheet saved before the 27th round has nil here and was showing Numina all along,
		-- so the flag is written true once rather than left nil: the renderer already treats
		-- nil as visible (SPEC V89), and this keeps the checkbox from reading unticked beside
		-- a tab that is plainly there.
		if sheet ~= nil and sheet.stShowNumina == nil then setField("stShowNumina", true); end;

		-- Appearance is the one attribute drawn without a fixed first dot, so that a character
		-- can be at zero (SPEC I3). Zero is not the DEFAULT though - a new sheet starts at one
		-- like the other eight (SPEC V104), and only a dot the player switched off keeps it at
		-- zero. nil means nobody has touched it yet; false is a decision and is left alone.
		if sheet ~= nil and sheet.appearance_1 == nil then setField("appearance_1", true); end;

		-- A ghoul opens with ten of twenty (SPEC I29). Seeded once, keyed on nil exactly like the
		-- dot above: nil is "nobody has touched this yet" and false is a decision, so a player who
		-- spends blood down to zero and closes the sheet does not find it refilled on the way back.
		if sheet ~= nil and sheet.bloodPool_1 == nil then
			for i = 1, 10, 1 do setField("bloodPool_" .. i, true); end;
		end;

		-- The Game box is locked (SPEC V109), so a value outside its three would sit there
		-- with nobody able to clear it: one of the four longer names this sheet used to offer,
		-- or nothing at all (SPEC V110). It runs here rather than on the Settings tab because
		-- that tab may never be opened - the same reason V95 moved the tab switch up here.
		if sheet ~= nil then
			local g = sheet.game;

			if g ~= "Vampire" and g ~= "Mortal" and g ~= "Mage" then
				setField("game", "Mortal");
			end;
		end;

		-- Before xpQuiet drops: this can write four names and up to twenty dots on a sheet
		-- that was saved under a clan whose trio has since changed, and every one of those
		-- writes would otherwise walk the ledger on the way in (SPEC B30, B34).
		renderClanDisc(self);

		xpQuiet = false;

		applyTabVisibility(self);

		-- The floor under the reveal (SPEC V167, I15). The theme paint is what normally
		-- lights the sheet, and it is the last load paint there is - but which of this
		-- event, a tab's dataLink and a tab's own onNodeReady runs first is unknown
		-- (SPEC R47), and a paint that throws or never fires would leave the player
		-- staring at nothing. A timer cannot fire early and cannot depend on the paint,
		-- which is exactly the two properties this needs. setTimeout is only
		-- asynchronous with a positive interval (SPEC R44).
		setTimeout(function() sheetReveal(self); end, 1500);
	</event>
</form>
