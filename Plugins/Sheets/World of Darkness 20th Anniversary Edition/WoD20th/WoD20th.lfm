					"Curbstomp", "Dagger", "Death Strike", "Deflecting Block", "Disarm", "Disarm (Mage)", "Dodge",
					"Dragon Tail Sweep", "Elbow/Knee Strike", "Flamethrower", "Flank/Rear Attack", "Flogger", "Flying Kick",
					"Full-Auto", "Grand Klaive", "Grapple", "Great Axe", "Great Blow", "Great Sword", "Greatsword",
					"Hail of Arrows", "Halberd", "Hand Ax", "Hand Claws (large)", "Hand Claws (small)", "Hard/Soft Strike",
					"Hatchet", "Hatchet (Dark Ages)", "Haymaker", "Head Butt", "Heavy Crossbow", "HIT Mark Chain-Gun",
					"Hold", "Hook Sword(s)", "Huge Spiked Club", "Hunting Bow", "Impale", "Iron Staff", "Jab Pistol",
					"Javelin", "Joint Lock", "Katana", "Katar", "Kick", "Kick (Mage)", "Klaive", "Knife",
					"Knife (Dark Ages)", "Knife (Mage)", "Knife, Thrown", "Kusarigama", "Lance (Mounted)", "Long Bow",
