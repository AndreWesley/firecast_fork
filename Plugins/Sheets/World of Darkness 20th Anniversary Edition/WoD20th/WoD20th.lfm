					"Inteligence", "Wits", "Academics", "Alertness", "Animal Ken", "Archery", "Athletics", "Awareness",
					"Brawl", "Commerce", "Computer", "Crafts", "Drive", "Empathy", "Enigmas", "Etiquette", "Expression",
					"Finance", "Firearms", "Hearth Wisdom", "Intimidation", "Investigation", "Larceny", "Law", "Leadership",
					"Legerdemain", "Medicine", "Melee", "Occult", "Performance", "Philosophy", "Politics", "Religion",
					"Ride", "Ritual", "Science", "Seneschal", "Stealth", "Streetwise", "Subterfuge", "Survival",
					"Technology", "Theology",
				},
				["background"] = {
					"", "Allies", "Alternate Identity", "Ancestors", "Arcane", "Armory", "Avatar", "Backup",
					"Base of Operations", "Certification", "Chantry", "Contacts", "Cult", "Demesne", "Destiny", "Domain",
					"Dream", "Enhancement", "Fame", "Familiar", "Fetish", "Generation", "Guide", "Herd", "Influence",
