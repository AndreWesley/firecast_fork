			-- Three ALIASES, by IDENTITY and not by copy (SPEC V211c, V208): the pairs below are
			-- one authored list each. Nature and Demeanour pick from the same archetypes; a clan
			-- Discipline is a Discipline; a secondary path is a path.
			PICKER_LIST["demeanor"] = PICKER_LIST["nature"];
			PICKER_LIST["clanDisc"] = PICKER_LIST["disc"];
			PICKER_LIST["secPath"]  = PICKER_LIST["mainPath"];

			-- The fourth key stopped being an alias in the 107th round (SPEC I29b, T510). Clan and
			-- family are two AUTHORED lists now - the clan picker is going to be shown somewhere
			-- else without the families - and only this dropdown offers both, so what it gets is
			-- their UNION, built once here and never written again.
			--
			-- Three invariants all say the same thing about the shape. V201 wants PICKER_LIST
			-- constant: this is born in the constructor and nothing writes it afterwards, which is
			-- exactly as constant as the two lists standing behind it. V208 forbids two tables with
			-- the same content: the union holds neither list's content. V211c calls an alias
			-- identity, and that is why the families are NOT appended to `clan` - a push there
			-- would grow the Main tab's clan picker with them, which is what B50 already paid for
			-- once.
			--
			-- The local is the point: writing straight into PICKER_LIST["clanFamily"][n] would be a
			-- table growing inside the map, and V294c reads the source for exactly that shape.
			-- >>> CLANFAMILY_UNION_BEGIN (SPEC V294 - the gate finds this region by MARKER)
			local clanFamilyUnion = {};
			local clanFamilyCount = 0;

			for i = 1, #PICKER_LIST["clan"], 1 do
				clanFamilyCount = clanFamilyCount + 1;
				clanFamilyUnion[clanFamilyCount] = PICKER_LIST["clan"][i];
			end;

			for i = 1, #PICKER_LIST["family"], 1 do
				clanFamilyCount = clanFamilyCount + 1;
				clanFamilyUnion[clanFamilyCount] = PICKER_LIST["family"][i];
			end;

			PICKER_LIST["clanFamily"] = clanFamilyUnion;
			-- <<< CLANFAMILY_UNION_END

			-- Which hedge paths an affiliation FAVOURS, and it is the same block of the book the
			-- casting attribute comes from - `Favored Attributes:` and `Favored Paths:` are two
			-- lines of one entry (SPEC I67, R105). One Affinity Path is chosen from this list, so
			-- what filters is the FIRST hedge row and not the seventeen (M20 Sorcerer p. 8).
			--
			-- ABSENCE of a key means "filters nothing", never "offers nothing". `Lone Practitioner`
			-- and the empty item of V15 have no entry here on purpose: the unaligned magician picks
			-- from everything (SPEC V271d). A key holding an EMPTY table would be the blank dropdown
			-- of B6 arriving through another door, which is why the gate refuses one.
			--
			-- NORMALISED to the sheet's own spelling, and the normalisation is MEASURED rather than
			-- tidied: the three books write six names outside it (SPEC I67) - `Summon, Binding, and
			-- Warding` and `Summoning/Binding/Warding` -> `Summoning, Binding, and Warding`,
			-- `Shadowcasting` and hedge `Shadow` -> `Shadows`, `Ephemera (Ghosts)` -> `Ephemera`,
			-- `Mana Manipulation` -> `Quintessence Manipulation`, `Spirit Chasing` ->
			-- `Spirit-Chasing`, and `Herbalism` -> `Alchemy`, which M20 Sorcerer p. 18 says in
			-- print it folded into (SPEC R106). A value the numina picker does not carry is a
			-- filter that blanks the whole row.
			--
			-- `Mogen HaLev` carries BOTH of its book lists - the body's and the `Female Auxiliary`
			-- one - because this sheet has no sex field and inventing one to prune three paths is
			-- outside what was asked.
			AFFINITY = {
				["The Ancient Order of The Aeon Rites"] = { "Conjuration", "Divination", "Enchantment", "Summoning, Binding, and Warding" },
				["The Arcanum"] = { "Alchemy", "Conveyance", "Enchantment", "Summoning, Binding, and Warding" },
				["Balamo’ob"] = { "Alchemy", "Healing", "Shapeshifting", "Summoning, Binding, and Warding" },
				["The Children of Osiris"] = { "Alchemy", "Ephemera", "Healing", "Oneiromancy" },
				["The Cult of Isis"] = { "Divination", "Fascination", "Fortune", "Healing" },
				["The Cult of Mercury"] = { "Conjuration", "Conveyance", "Divination", "Fortune" },
				["The Dozen Priests of the Pythian Order"] = { "Divination", "Healing", "Shapeshifting", "Weather Control" },
				["The Fenian"] = { "Fascination", "Shapeshifting", "Weather Control" },
				["Forn Jafnaðr"] = { "Divination", "Enchantment", "Hellfire", "Summoning, Binding, and Warding" },
				["Maison Liban"] = { "Fortune", "Quintessence Manipulation", "Shadows", "Summoning, Binding, and Warding" },
				["Mogen HaLev"] = { "Divination", "Ephemera", "Fortune", "Healing", "Summoning, Binding, and Warding", "Weather Control" },
				["Nebuu-Afef, The Order of The Golden Fly"] = { "Conjuration", "Hellfire", "Shadows", "Shapeshifting" },
				["The Nephite Priesthood"] = { "Divination", "Enchantment", "Hellfire", "Summoning, Binding, and Warding", "Weather Control" },
				["The Seven Thunders"] = { "Divination", "Fortune", "Healing", "Hellfire" },
				["The Silver Portal"] = { "Ephemera", "Fascination", "Oneiromancy", "Shadows" },
				["The Society of Enlightened Altruistic Ideologies (SEAI)"] = { "Alchemy", "Conjuration", "Conveyance", "Enchantment" },
				["The Star Council"] = { "Enchantment", "Healing", "Quintessence Manipulation", "Shadows" },
				["Thal’hun"] = { "Conjuration", "Fortune", "Hellfire", "Quintessence Manipulation" },
				["U.S. Government (Project Twilight)"] = { "Divination", "Fortune", "Hellfire" },
				["Uzoma"] = { "Alchemy", "Healing", "Quintessence Manipulation", "Summoning, Binding, and Warding" },
				["The Society of Leopold"] = { "Via Geniorum", "Via Necromantiae" },
				["Followers of Set"] = { "Fascination", "Illusion", "Shapeshifting" },
				["Giovanni"] = { "Divination", "Shadows", "Summoning, Binding, and Warding" },
				["Path-Dancers"] = { "Alchemy", "Healing", "Shapeshifting", "Spirit-Chasing", "Summoning, Binding, and Warding" },
				["The Crystal Circle"] = { "Dowsing", "Enchantment", "Oneiromancy", "Quintessence Manipulation" },
			};

			-- The casting Attribute the same book entry favours (SPEC I68, R105). TWENTY keys and
			-- not twenty-five: only the M20 Sorcerer affiliations carry a `Favored Attributes:`
			-- line, always two names. The five that come from the other two books declare no
			-- attribute at all (SPEC R107, R108), so they have no key and open all nine - the same
			-- nil that means "filters nothing" above. Inventing two attributes for them would be
			-- data with no source.
			--
			-- The names are the NINE of PICKER_LIST["hedgeAttr"], in the sheet's own spelling:
			-- `Inteligence` has been the field name since SPEC I3, and correcting it here alone
			-- would break the bijection V264a measures in both directions.
			CASTING_ATTR = {
				["The Ancient Order of The Aeon Rites"] = { "Inteligence", "Wits" },
				["The Arcanum"] = { "Inteligence", "Wits" },
				["Balamo’ob"] = { "Stamina", "Wits" },
				["The Children of Osiris"] = { "Inteligence", "Wits" },
				["The Cult of Isis"] = { "Charisma", "Manipulation" },
				["The Cult of Mercury"] = { "Charisma", "Stamina" },
				["The Dozen Priests of the Pythian Order"] = { "Charisma", "Inteligence" },
				["The Fenian"] = { "Manipulation", "Appearance" },
				["Forn Jafnaðr"] = { "Dexterity", "Wits" },
				["Maison Liban"] = { "Inteligence", "Manipulation" },
				["Mogen HaLev"] = { "Inteligence", "Perception" },
				["Nebuu-Afef, The Order of The Golden Fly"] = { "Strength", "Stamina" },
				["The Nephite Priesthood"] = { "Stamina", "Wits" },
				["The Seven Thunders"] = { "Charisma", "Manipulation" },
				["The Silver Portal"] = { "Charisma", "Perception" },
				["The Society of Enlightened Altruistic Ideologies (SEAI)"] = { "Inteligence", "Manipulation" },
				["The Star Council"] = { "Perception", "Inteligence" },
				["Thal’hun"] = { "Inteligence", "Wits" },
				["U.S. Government (Project Twilight)"] = { "Dexterity", "Wits" },
				["Uzoma"] = { "Charisma", "Wits" },
			};

			-- Which hedge magic PATH each ritual belongs to (SPEC I83b, user 2026-08-26). It is
			-- the table the level filter reads: a ritual is offered only while the path it comes
			-- from stands at its level or above, and a path the sheet does not carry answers zero,
			-- so it opens nothing at all - not even its first level (SPEC I83a).
			--
			-- The LEVEL is not in here. It is read off the item text, `<n>. <name>`, the same
			-- grammar the vampire rituals use and hedgeRitualLevel already reads for the price
			-- (SPEC V269d, V310c). Two sources for one number is what would let the dots on
			-- screen say three while the filter measured four.
			--
			-- ONE path per ritual, a string and not a list. If a book turns out to print a ritual
			-- under two paths (SPEC R114 has that open), the value becomes a list and the read
			-- becomes a max, which is what pathLevel already does for a path with two owners -
			-- three lines, in one place. Writing the list shape now would be flexibility nobody
			-- asked for, on data nobody has read yet.
			--
			-- It opens EMPTY because PICKER_LIST["hedgeRitual"] opens empty (SPEC V269e): the
			-- powers are entered in a round of their own (SPEC T690). This is NOT the dead data
			-- of B55 - that was a table with no READER, and this one is born with its reader in
			-- the same pass (SPEC T688 is atomic for the reason T605 was).
			HEDGE_RITUAL_PATH = {
				["1. Death Curse"] = "Fortune",
				["1. Deathsight"] = "Necromancy",
				["1. Eldritch Mark"] = "Enchantment",
				["1. Face Theft"] = "Shapeshifting",
				["1. Healing Slumber"] = "Healing",
				["1. Lifting Shadows"] = "Shadows",
				["1. Sprint"] = "Conveyance",
				["1. Symbol Interpretation"] = "Oneiromancy",
				["2. Bedtime Story"] = "Oneiromancy",
				["2. Cruel Whispers"] = "Illusion",
				["2. Enhance Craftsmanship"] = "Enchantment",
				["2. Fire's Weal"] = "Hellfire",
				["2. Hellblade"] = "Hellfire",
				["2. Jolt"] = "Healing",
				["2. Object Permanence"] = "Conjuration",
				["2. Quintessence Infusion"] = "Quintessence Manipulation",
				["2. Rest in Peace"] = "Maelstroms",
				["2. Step on a Crack"] = "Fortune",
				["2. Teleport Ward"] = "Conveyance",
				["3. Always Armed"] = "Conjuration",
				["3. Bashert"] = "Fortune",
				["3. Belle/Beau/Bright of the Ball"] = "Fascination",
				["3. Calm Above, Hell Below"] = "Maelstroms",
				["3. Get Me the Heck Outta Here!"] = "Conveyance",
				["3. Grip of Shades"] = "Shadows",
				["3. Hard-Light Constructs"] = "Illusion",
				["3. Invade Demesne"] = "Oneiromancy",
				["3. Mike's Cure-All"] = "Healing",
				["3. Purification of the Inferno"] = "Hellfire",
				["3. Shape Quintessence"] = "Quintessence Manipulation",
				["3. Shitstorm"] = "Conjuration",
				["3. Shroud Bubble"] = "Necronics",
				["3. Shut It Down"] = "Necronics",
				["3. Wrapped in a Shroud"] = "Necromancy",
				["4. Doxxing"] = "Necronics",
				["4. Dream Scream"] = "Oneiromancy",
				["4. Extraction"] = "Conjuration",
				["4. Fix the True Form"] = "Shapeshifting",
				["4. Forced Medium"] = "Necromancy",
				["4. Freudian Slip"] = "Fortune",
				["4. Humor Alignment"] = "Healing",
				["4. Information Superhighway"] = "Conveyance",
				["4. Instant Feast"] = "Illusion",
				["4. Love Potion Number 9"] = "Fascination",
				["5. Generational Wealth"] = "Fortune",
				["5. Megafauna Transformation"] = "Shapeshifting",
				["5. Oubliette"] = "Illusion",
				["5. Overwrite"] = "Necronics",
				["5. Shelter for the Dead"] = "Maelstroms",
				["5. Smoldering Ruin"] = "Hellfire",
				["5. Steal Life"] = "Necromancy",
				["5. Teleportal"] = "Conveyance",
			};

			-- >>> TAB_LIST_BEGIN (SPEC I32, V228: one list, every reader on it)
			-- The eleven tabs, in the order the strip draws them. Every name in the XML is built
			-- from these mechanically - pane `tab<X>`, button `btnTab<X>`, fill `tabOn<X>` - so the
			-- list and the sheet cannot drift into disagreeing about which tabs exist.
			TAB_LIST = {
				"Main", "Traits", "Numina", "Disciplines", "Combat", "Inventory",
				"Background", "Progress", "Notes", "Settings", "Storyteller",
			};
			-- <<< TAB_LIST_END

			-- >>> TAB_W_BEGIN (SPEC I36, V232: one width, both readers)
			-- How wide each tab button is, in TAB_LIST order, and the two numbers that lay the
			-- eleven of them out. The strip REFLOWS: a tab the storyteller turned off loses its
			-- button and the ones to its right slide left, so the bar has no hole in the middle
			-- of it (SPEC I36, user 2026-08-22). Numina and Ghoul are the two that can go, and
			-- both sit in the MIDDLE, which is why this could not stay a matter of authored left.
			--
			-- The widths live here instead of being read back off the control because WRITING
			-- geometry from Lua is proved on this sheet - WoD20.9 has written width and height
			-- since the 27th round - and READING it is not: a nil coming back would scatter an
			-- invalid left across twenty-two rectangles in silence, and the fallback that would
			-- guard against it costs the very second copy this table already is. The gate welds
			-- the table to the XML instead, the same weld V49 puts on HEALTH_ROW_PITCH.
			TAB_W = {
				99, 79, 79, 92, 86, 105, 105, 112, 99, 125, 112,
			};
			STRIP_X0  = 30;
			STRIP_GAP = 4;
			-- <<< TAB_W_END

			-- Which tab is open is SESSION state and must never become a field (SPEC V227): a field
			-- syncs to every client of the table, so the player clicking Combat would drag the
			-- storyteller off whatever they were reading. It is also for ever - a field name cannot
			-- be renamed without dropping what is saved under it (SPEC I3, V2).
			activeTab = "tabMain";

			-- The sub-tab strips, one entry per strip (SPEC I58). They carry no gating of their
			-- own: nothing hides a sub-tab, so there is no `shown` map for them.
			--
			-- ONE table and one renderer for BOTH strips since the 90th round, when the Numina
			-- tab got a strip of its own. It is not generalisation for its own sake - there are
			-- two readers TODAY - and the alternative is two functions of the same twelve lines
			-- with nothing measuring that they stay in step, which is the shape of B12 and B13.
			--
			-- `active` lives IN the entry, so the open sub-tab is still plain Lua session state
			-- that no field syncs to the table (SPEC V227), exactly as activeVampTab was.
			SUB_TABS = {
				{ list = { "Disc", "Paths", "Rituals" }, active = "tabDisc" },
				{ list = { "Hedge", "Psychic", "Faith" }, active = "tabHedge" },

				-- The Hedge Magic pane splits in two from the 91st round (SPEC I64). The names
				-- carry "Hedge" and they HAVE to: renderSubTabs builds one map keyed by NAME and
				-- selectTab matches a name against every group, so a second "tabPaths" here would
				-- make a click on the Numina tab flip the Ghoul tab's sub-tab instead - green
				-- gate, rdk 0, and the symptom two tabs away from its cause (SPEC V268a).
				{ list = { "HedgePaths", "HedgeRituals" }, active = "tabHedgePaths" },
			};
			-- >>> GEN_MAX_BEGIN (SPEC I29, V218: one map, both readers)
			-- The ceiling a domitor's generation puts on a ghoul's Disciplines. Keyed by the VALUE the
			-- combo stores ("4".."14"), which is why that value is a plain number and the ordinal is
			-- only what the item READS (SPEC I29). Read by renderMaxDisc for the label and by xpClick
			-- for the refusal - a second copy is how the number shown and the number charged diverge.
			GEN_MAX = {
				["4"] = 5, ["5"] = 4, ["6"] = 3, ["7"] = 2,
				["8"] = 1, ["9"] = 1, ["10"] = 1, ["11"] = 1, ["12"] = 1, ["13"] = 1,
				["14"] = 0,
			};
			-- <<< GEN_MAX_END

			-- nil means NO ceiling, and that is not the same as zero: a mortal with no domitor is not a
			-- ghoul with a fourteenth-generation one (SPEC V220a).
			function maxDiscLevel()
				if sheet == nil then return nil; end;

				local g = sheet.dominatorGen;

				if g == nil or g == "" then return nil; end;

				return GEN_MAX[tostring(g)];
			end;

			-- `renderMaxDisc` NAO fica aqui, e a ausencia e deliberada (SPEC B51, V223). Ele anda da
			-- raiz por `tabRootOf`, que e um `local function` declarado ~1050 linhas ABAIXO deste
			-- ponto, e Lua resolve nome nao-local em tempo de COMPILACAO: corpo escrito acima do
			-- `local` vira GETGLOBAL e acha nil rodando. Foi exatamente o erro que o label deu ao
			-- user. Ele mora logo abaixo de `applyTabVisibility`, o outro global que anda da raiz.
			-- Nao devolver p/ ca ao lado de GEN_MAX: a leitura melhora e o label morre.

			function setField(name, value)
				if sheet == nil then return; end;
				if sheet[name] ~= value then sheet[name] = value; end;
			end;

			-- ---- SPEC T492: TEMPORARY instrumentation. It comes OUT before the round closes --
			--
			-- The "before" the round has to have MEASURED (SPEC C), and what T497 reads. It answers
			-- two things the gate cannot: how many times each entry point actually runs on an open,
			-- and whether a description require was ever REACHED (SPEC R92b, R92i, B47, B48).
			--
			-- It lives on the ROOT form because every tab has to reach it and the root <script> is
			-- parsed before any <import> - the same reason the health track lives here.
			--
			-- Log.i needs API 87.3 and the generated module.xml declares 88.2 (SPEC R92i).
			WOD_HITS = {};
			
			function wodTrace(what)
				WOD_HITS[what] = (WOD_HITS[what] or 0) + 1;
				Log.i("WOD", what .. " x" .. WOD_HITS[what]);
			end;

			-- Health track, shared by the Main tab and its mirror on the Combat tab.
			--
			-- It lives on the ROOT form on purpose: this script is parsed before the <import>
			-- of any tab, so both tabs can call into it without depending on which sibling tab
			-- happened to load first. SPEC R.9 / B.9 is the same lesson from the other side -
			-- a tab form cannot reach its siblings, so anything two tabs share belongs here.

			-- The 10 lists are LITERAL from the user (SPEC C, V39). They are NOT derivable:
			-- 6 is 7 minus Bruised and 5 is that minus Hurt, but 4 skips Crippled instead of
			-- continuing to trim from the top. Do not "simplify" this into a loop.
			HEALTH_LEVELS = {
				[1]  = {"Incapacitated"},
				[2]  = {"Injured (-1)", "Incapacitated"},
				[3]  = {"Injured (-1)", "Wounded (-2)", "Incapacitated"},
				[4]  = {"Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Incapacitated"},
				[5]  = {"Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[6]  = {"Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[7]  = {"Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[8]  = {"Bruised", "Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[9]  = {"Bruised", "Bruised", "Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[10] = {"Bruised", "Bruised", "Bruised", "Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
			};

			-- These labels are written by Lua, so they never pass through the WoD20.6 translation
			-- traversal - that routine snapshots the authored English once and would restore a
			-- stale snapshot the moment the track length changed. Same arrangement as the numina
			-- description block (SPEC V31): whoever writes the text owns both languages.
			-- The gate checks this table against localization.lang, like it does the PT map.
			HEALTH_PT = {
				["Bruised"]        = "Escoriado",
				["Hurt (-1)"]      = "Machucado (-1)",
				["Injured (-1)"]   = "Ferido (-1)",
				["Wounded (-2)"]   = "Ferido Gravemente (-2)",
				["Mauled (-2)"]    = " Espancado (-2)",
				["Crippled (-5)"]  = "Aleijado (-5)",
				["Incapacitated"]  = "Incapacitado",
			};

			-- The four damage marks, LITERAL from the user (SPEC C, V41), in cycle order. Mark 1
			-- is a single space, not "": the sheet stores exactly what the box shows.
			HEALTH_MARKS = {" ", "/", "X", "*"};

			-- CLANS (SPEC I17). Dormant data: nothing reads it yet (SPEC V174), and the clan
			-- combo on Main is invisible and disabled (SPEC V173). Frozen by SPEC T430 from the
			-- core and Dark Ages; `open` counts slots the player fills from the whole list.
			local CLANS = {
				-- >>> CLANS_BEGIN (generated - SPEC T434, T430 froze the lists)
				["Assamite"] = { fixed = {"Celerity", "Obfuscate", "Quietus"} },
				["Brujah"] = { fixed = {"Celerity", "Potence", "Presence"} },
				["Followers of Set"] = { fixed = {"Obfuscate", "Presence", "Serpentis"} },
				["Gangrel"] = { fixed = {"Animalism", "Fortitude", "Protean"} },
				["Giovanni"] = { fixed = {"Dominate", "Necromancy", "Potence"} },
				["Lasombra"] = { fixed = {"Dominate", "Obtenebration", "Potence"} },
				["Malkavian"] = { fixed = {"Auspex", "Dementation", "Obfuscate"} },
				["Nosferatu"] = { fixed = {"Animalism", "Obfuscate", "Potence"} },
				["Ravnos"] = { fixed = {"Animalism", "Chimerstry", "Fortitude"} },
				["Toreador"] = { fixed = {"Auspex", "Celerity", "Presence"} },
				["Tremere"] = { fixed = {"Auspex", "Dominate", "Thaumaturgy"} },
				["Tzimisce"] = { fixed = {"Animalism", "Auspex", "Vicissitude"} },
				["Ventrue"] = { fixed = {"Dominate", "Fortitude", "Presence"} },
				["Baali"] = { fixed = {"Daimonion", "Obfuscate", "Presence"} },
				["Blood Brothers"] = { fixed = {"Fortitude", "Potence", "Sanguinus"} },
				["Daughters of Cacophony"] = { fixed = {"Fortitude", "Melpominee", "Presence"} },
				["Harbingers of Skulls"] = { fixed = {"Auspex", "Fortitude", "Necromancy"} },
				["Kiasyd"] = { fixed = {"Dominate", "Mytherceria", "Obtenebration"} },
				["Nagaraja"] = { fixed = {"Auspex", "Dominate", "Necromancy"} },
				["Salubri"] = { fixed = {"Auspex", "Fortitude", "Obeah"} },
				["Samedi"] = { fixed = {"Fortitude", "Obfuscate", "Thanatosis"} },
				["True Brujah"] = { fixed = {"Potence", "Presence", "Temporis"} },
				["Ahrimanes"] = { fixed = {"Animalism", "Presence", "Spiritus"} },
				["Anda"] = { fixed = {"Animalism", "Fortitude", "Protean"} },
				["Cappadocians"] = { fixed = {"Auspex", "Fortitude", "Necromancy"} },
				["Lamia"] = { fixed = {"Fortitude", "Necromancy", "Potence"} },
				["Lhiannan"] = { fixed = {"Animalism", "Ogham", "Presence"} },
				["Noiad"] = { fixed = {"Animalism", "Auspex", "Protean"} },
				["Assamite Antitribu"] = { fixed = {"Celerity", "Obfuscate", "Quietus"} },
				["Brujah Antitribu"] = { fixed = {"Celerity", "Potence", "Presence"} },
				["City Gangrel"] = { fixed = {"Celerity", "Obfuscate", "Protean"} },
				["Country Gangrel"] = { fixed = {"Animalism", "Fortitude", "Protean"} },
				["Malkavian Antitribu"] = { fixed = {"Auspex", "Dementation", "Obfuscate"} },
				["Nosferatu Antitribu"] = { fixed = {"Animalism", "Obfuscate", "Potence"} },
				["Ravnos Antitribu"] = { fixed = {"Animalism", "Chimerstry", "Fortitude"} },
				["Salubri Antitribu"] = { fixed = {"Auspex", "Fortitude", "Valeren"} },
				["Serpents of the Light"] = { fixed = {"Presence", "Obfuscate", "Serpentis"} },
