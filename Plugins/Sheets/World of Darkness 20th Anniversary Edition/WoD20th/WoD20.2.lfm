			</layout>
			<layout name="dragRow_merit_f1" left="20" top="61" width="516" height="25" >
				<MeritPicked sub="flaw" num="f1" lbl="Select Flaw"/>
			</layout>
			<layout name="dragRow_merit_f2" left="20" top="86" width="516" height="25" >
				<MeritPicked sub="flaw" num="f2" lbl="Select Flaw"/>
			</layout>
			<layout name="dragRow_merit_f3" left="20" top="111" width="516" height="25" >
				<MeritPicked sub="flaw" num="f3" lbl="Select Flaw"/>
			</layout>
			<layout name="dragRow_merit_f4" left="20" top="136" width="516" height="25" >
				<MeritPicked sub="flaw" num="f4" lbl="Select Flaw"/>
			</layout>
			<layout name="dragRow_merit_f5" left="20" top="161" width="516" height="25" >
				<MeritPicked sub="flaw" num="f5" lbl="Select Flaw"/>
			</layout>
			<layout name="dragRow_merit_f6" left="20" top="186" width="516" height="25" >
