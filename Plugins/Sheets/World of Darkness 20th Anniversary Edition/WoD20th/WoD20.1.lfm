		<layout left="1015" top="110" width="330" height="426">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="290" height="20" text="KNOWLEDGES" horzTextAlign="center"/>

			<layout left="20" top="36" width="290" height="25" >
				<Ability col="knowledges" num="1" field="academics" nome="Academics"/>
			</layout>
			<layout left="20" top="61" width="290" height="25" >
