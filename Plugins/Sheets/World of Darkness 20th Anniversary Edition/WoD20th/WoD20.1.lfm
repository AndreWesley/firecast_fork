		<!-- Closes on 1345 with the grid, not on the 1680 it kept for the two days SPECIALTIES
		     spent in the grid row (SPEC V375, T862, T908): the header row and the grid share the
		     tab's right edge, and a box standing still while its column moves opens the dead
		     strip V168 was written to see and V375 inherited.

		     ONE number again, not three (SPEC I136e, T908, user 2026-09-02 item 6), and since T919 it T863 put
		     Total and Spent here because the fifth band paid for them; with the band gone the box
		     is 330 wide and only Current fits. Nothing was lost: Progress (WoD20.9.lfm) has had
		     all three the whole time and is where I11 computes them, so this tab gave up the VIEW
		     and not the data.

		     Not one field in the box (SPEC I11): the number is WORKED OUT by xpPaint on the root,
		     and this tab and Progress are two views of the same computation. So the round removes
		     four control names and zero NDB fields, and V1 never sees a second owner.

		     Those four names came OUT of renderXPBoxes in the same commit (SPEC I136f). Both
		     writes were nil-guarded, so the box would have looked right without touching one line
		     of Lua - which is exactly why they had to go: a widget name in a Lua roster with no
		     widget in the XML is the orphan field of V2 one floor up, and it makes no sound
		     (SPEC B111, B123). -->
		<layout left="1015" top="0" width="330" height="105">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="290" height="20" text="EXPERIENCE" horzTextAlign="center"/>

			<edit name="edtCurrentXPMain" left="120" top="57" width="90" height="25" horzTextAlign="center" fontSize="14" onUserChange="xpSetCurrent(self, self.edtCurrentXPMain.text);"/>
		</layout>

		<layout left="0" top="110" width="340" height="296">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="300" height="20" text="ATTRIBUTES" horzTextAlign="center"/>

			<label left="-20" top="63" width="100" height="20" text="Physical" horzTextAlign="center" rotationAngle="270"/>

			<layout left="55" top="36" width="250" height="25" >
				<Attribute field="strength" nome="Strength"/>
			</layout>
			<layout left="55" top="61" width="250" height="25" >
				<Attribute field="dexterity" nome="Dexterity"/>
			</layout>
			<layout left="55" top="86" width="250" height="25" >
				<Attribute field="stamina" nome="Stamina"/>
			</layout>

			<horzLine left="30" top="116" width="280" strokeColor="white"/>

			<label left="-20" top="148" width="100" height="20" text="Social" horzTextAlign="center" rotationAngle="270"/>

			<layout left="55" top="121" width="250" height="25" >
				<Attribute field="charisma" nome="Charisma"/>
			</layout>
			<layout left="55" top="146" width="250" height="25" >
				<Attribute field="manipulation" nome="Manipulation"/>
			</layout>
			<!-- Appearance is the one attribute whose first dot can be switched off, by request
			     (SPEC T95). Every other attribute keeps dot 1 as a fixed <image>. Same x for
			     the first dot as the Attribute template, so the column still lines up (V26). -->
			<layout left="55" top="171" width="250" height="25" >
				<AttributeZeroable field="appearance" nome="Appearance"/>
			</layout>

			<horzLine left="30" top="201" width="280" strokeColor="white"/>

			<label left="-20" top="233" width="100" height="20" text="Mental" horzTextAlign="center" rotationAngle="270"/>

			<layout left="55" top="206" width="250" height="25" >
				<Attribute field="perception" nome="Perception"/>
			</layout>
