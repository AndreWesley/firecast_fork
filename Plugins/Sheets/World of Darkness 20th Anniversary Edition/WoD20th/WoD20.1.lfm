		<!-- Closes on 1680 with SPECIALTIES under it, not on the 1345 it kept while the grid was
		     four bands wide (SPEC V375, T862): the header row and the grid share the tab's right
		     edge, and a box standing still while its column grows opens the dead strip V168 was
		     written to see and V375 inherited.

		     THREE numbers now, not one (SPEC I127, T863, user 2026-08-31 ask 1). The tab used to
		     show Current alone in a 20pt box because 330px had no room for more; the fifth band
		     paid for the other two, and the player stopped having to open Progress to read what a
		     dot cost him. The geometry is the Progress box (WoD20.9.lfm) VERBATIM, every x moved
		     +32: that box is 561 wide with a 521 interior, this one is 665 with 625, and
		     (625-521)/2 is 32. Copying the shape and shifting it beats re-spacing three columns by
		     hand - the two boxes read as ONE design, which is what the ask was.

		     Not one field between them (SPEC I11): the three numbers are WORKED OUT by xpPaint on
		     the root, and this tab and Progress are two views of the same computation. So the
		     round adds four control names and zero NDB fields, and V1 never sees a second owner.

		     bgTotalXPMain / bgSpentXPMain are the darker ground the two LOCKED numbers stand on
		     (SPEC V256): rectangle declared BEFORE the edit so it paints behind, transparent on
		     the edit so its own ground stops covering it, colour with a key in all four palettes.
		     Current gets none - it is the box the player types in, and a lock cue on an unlocked
		     field is decoration (SPEC V241). -->
		<layout left="1015" top="0" width="665" height="115">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="20" width="625" height="20" text="EXPERIENCE" horzTextAlign="center"/>

			<label left="68" top="48" width="141" height="20" text="Total Experience" horzTextAlign="center"/>
			<rectangle name="bgTotalXPMain" left="93" top="70" width="90" height="25" color="#0A0A0A" xradius="6" yradius="6" cornerType="innerRound" hitTest="false"/>
			<edit name="edtTotalXPMain" left="93" top="70" width="90" height="25" readOnly="true" opacity="0.75" horzTextAlign="center" fontSize="14" transparent="true"/>
			<label left="242" top="48" width="141" height="20" text="Spent Experience" horzTextAlign="center"/>
			<rectangle name="bgSpentXPMain" left="267" top="70" width="90" height="25" color="#0A0A0A" xradius="6" yradius="6" cornerType="innerRound" hitTest="false"/>
			<edit name="edtSpentXPMain" left="267" top="70" width="90" height="25" readOnly="true" opacity="0.75" horzTextAlign="center" fontSize="14" transparent="true" onUserChange="xpSetSpent(self, self.edtSpentXPMain.text);"/>
			<label left="416" top="48" width="141" height="20" text="Current Experience" horzTextAlign="center"/>
			<edit name="edtCurrentXPMain" left="441" top="70" width="90" height="25" horzTextAlign="center" fontSize="14" onUserChange="xpSetCurrent(self, self.edtCurrentXPMain.text);"/>
		</layout>

		<layout left="0" top="120" width="340" height="306">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="20" width="300" height="20" text="ATTRIBUTES" horzTextAlign="center"/>

			<label left="-20" top="68" width="100" height="20" text="Physical" horzTextAlign="center" rotationAngle="270"/>

			<layout left="55" top="41" width="250" height="25" >
