			</layout>

			<layout left="20" top="40" width="297" height="25" >
				<HeaderNarrow field="player" nome="Player"/>
			</layout>
			<layout left="326" top="40" width="327" height="25" >
				<HeaderPicker field="demeanor" nome="Demeanor"/>
			</layout>
			<layout left="663" top="40" width="327" height="25" >
