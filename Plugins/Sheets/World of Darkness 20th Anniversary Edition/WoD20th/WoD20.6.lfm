				["Zantosa"] = "Zantosa",
				["1. Encrypt/Decrypt Missive"] = "1. Cifrar/Decifrar Missiva",
				["2. Cure of the Homeland"] = "2. Cura da Terra Natal",
				["2. Hand of Glory"] = "2. Mão da Glória",
				["3. Tempest Shield"] = "3. Escudo de Tempestade",
				["4. Bastone del Diavolo"] = "4. Bastone del Diavolo",
				["5. Escape to a True Haven"] = "5. Fuga para um Refúgio Verdadeiro",
				["Creatio Ignis (The Creation of Fire)"] = "Creatio Ignis (A Criação do Fogo)",
				["Genius Loci"] = "Genius Loci",
				["Potestas Elementorum (The Power of the Elements)"] = "Potestas Elementorum (O Poder dos Elementos)",
				["Potestas Motus (Power of Motion)"] = "Potestas Motus (Poder do Movimento)",
				["Potestas Tempestatum (Power Over Storms)"] = "Potestas Tempestatum (Poder sobre as Tempestades)",
				["Potestas Vitae (The Power of Lifeblood)"] = "Potestas Vitae (O Poder do Sangue Vital)",
				["The Grave’s Decay"] = "A Decomposição da Sepultura",
				["The Path of Ash"] = "A Trilha das Cinzas",
				["The Path of Bone"] = "A Trilha dos Ossos",
				["The Path of Haunting"] = "A Trilha da Assombração",
				["The Path of the Cenotaph"] = "A Trilha do Cenotáfio",
				["The Path of the Corpse in the Monster"] = "A Trilha do Cadáver no Monstro",
				["The Path of the Sepulchre"] = "A Trilha do Sepulcro",
				["The Vitreous Path"] = "A Trilha Vítrea",
				-- <<< VAMPIRE_ITEMS_END
			};

			-- PT is local to this file, but text written by Lua lives on other tabs too - the
			-- health track here, the experience ledger on WoD20.9 (SPEC I10). One exported lookup
			-- keeps ONE map: a second copy in another file is exactly what V28 is written to
			-- catch, and it would drift the first time a term was retranslated.
			function translateSheetText(txt, lang)
				if lang == "pt" then return PT[txt] or txt; end;

				return txt;
			end;

			-- SPEC V21 / B.9: a form's getChildren() returns only its own declared children,
			-- so recursing from this Credits form reached this tab and nothing else. Walk UP
			-- to the sheet root first, then down over everything.
			local function rootOf(ctrl)
				local p = ctrl;

				while true do
					local up = p:getParent();
					if up == nil then return p; end;
					p = up;
				end;
			end;

			local function collect(node, out)
				local children = node:getChildren();

				for i = 1, #children, 1 do
					out[#out + 1] = children[i];
					collect(children[i], out);
				end;
			end;

			-- SPEC V24 / I22: a picker item is its canonical value read through TWO lenses, era
			-- first and language second - `Lure of Flames` shows as `Creatio Ignis (The Creation
			-- of Fire)` in the Dark Ages and then as its [pt] key from there. `values` are never
			-- touched: they are what the sheet SAVES, and that is the whole point (SPEC V194, B23).
			--
			-- ONE function because BOTH switches change what a row reads - applyLanguage calls it
			-- and applyTheme calls it, on the traversal each already runs. A dataLink of its own on
			-- `sheetTheme` would be a second era trigger, which is exactly the thing that falls out
			-- of step (SPEC T469).
			--
			-- Only the `cbo*` pickers: the language combo must not be rewritten with its own
			-- values ("en" / "pt").
			--
			-- The ERA axis is narrower than the language one, and SPEC B44 is why. ERA_NAME is
			-- keyed by the canonical value, and a value does not carry its sense: "Weather
			-- Control" is a Thaumaturgy path on the Vampire tab AND a hedge magic path on WoD20.7.
			-- Renaming every `cbo*` put "Potestas Tempestatum (Power Over Storms)" on the hedge
			-- wizard's row in the Dark Ages. Same lesson as B15 and T472, third time asked: the
			-- rule holds by SENSE, so the era is scoped to the rows that carry that sense
			-- (SPEC V197). The language axis stays sheet-wide - a translation is a translation.
			local VAMP_ROW = {
				clanDisc = true, disc = true, mainPath = true, secPath = true, ritual = true,
			};

			-- The FILTER reaches three of those five, and it is a table of its own rather than
			-- VAMP_ROW reused (SPEC V203). A Discipline is what the player BUYS: filtering its
			-- list by what he already owns would leave a new sheet nineteen empty combos. Same
			-- lesson as the era axis just above, asked a fourth time - the scope holds by SENSE,
			-- not by a prefix that happens to match.
			-- `hedgeRitual` joined them in the 112th round (SPEC I83g, V310f). It goes by ROOT and
			-- not into FILTER_NAME below, and the two tables are not interchangeable: all twelve
			-- picked ritual rows answer to ONE question - is the path on the sheet, at the level -
			-- while only the FIRST numina row is the Affinity Path. Scope by SENSE, the fifth time
			-- this file has had to say it. The five typed rows carry an `edt` and are never asked
			-- (SPEC V248c).
			local FILTER_ROW = {
				mainPath = true, secPath = true, ritual = true, hedgeRitual = true,
			};

			-- A SECOND filter table, keyed by CONTROL NAME instead of by root (SPEC I67, V272a).
			-- Two of them and not one, for the reason V203 has already charged four times: the
			-- scope holds by SENSE. `FILTER_ROW["numina"] = true` would filter all seventeen hedge
			-- rows, and only the FIRST is the Affinity Path (M20 Sorcerer p. 8). `cboHedgeAttr` is
			-- a singleton and rowRoot returns nil for it - it demands a trailing _<n> - so a table
			-- keyed by root could not reach it at all (SPEC I68).
			local FILTER_NAME = {
				cbonumina_1 = true, cboHedgeAttr = true,
			};

			local function rowRoot(nm)
				return string.match(string.sub(nm, 4), "^(%a+)_%d+$");
			end;

			local function isVampireRow(nm)
				local root = rowRoot(nm);

				return root ~= nil and VAMP_ROW[root] == true;
			end;

			local function isFilterRow(nm)
				local root = rowRoot(nm);

				return FILTER_NAME[nm] == true or (root ~= nil and FILTER_ROW[root] == true);
			end;

			-- Which PICKER_LIST key a combo reads (SPEC I27). The control name is "cbo" plus the
			-- field, so the key is the field with its row number taken off. Two spellings have to
			-- survive this: the templates instantiate name="cbo$(field)" and come out lowercase
			-- (cboritual_7 -> ritual), while the hand-named ones are capitalised (cboClan -> clan,
			-- cboSpeciality1 -> speciality) - hence the lower() on the first character, and the
			-- optional underscore in the pattern.
			--
			-- rowRoot above cannot serve here: it demands a trailing _<n> and returns nil for every
			-- SINGLETON picker (cboClan, cboFaith, cboNature, cboDemeanor).
			local function fieldRoot(nm)
				local f = string.gsub(string.sub(nm, 4), "_?%d+$", "");

				return string.lower(string.sub(f, 1, 1)) .. string.sub(f, 2);
			end;

			-- One transformed pair per LIST, not one per control (SPEC T491, B48). Twenty-five
			-- ritual combos read the same 284 authored items and each rebuilt them - eraName and
			-- the PT lookup, item by item - on every one of the three passes an opening makes.
			-- The pair is written to all twenty-five: setValues marshals per handle (SPEC R92c),
			-- so sharing the table costs the widgets nothing.
			--
			-- There is nothing to invalidate here, in the same sense as the level map itself
			-- (SPEC V205): the stamp names everything the answer depends on, so a stale entry is
			-- never SERVED - it is simply never found. discLevels() hands back a FRESH table each
			-- traversal, so the identity test is exactly "a new render started", and the map it
			-- was built under is held right here, which is why no later map can share its
			-- identity. `levels` starts at false rather than nil so a first caller passing nil
			-- still opens a generation of its own.
			-- `hedge` rides the same generation (SPEC I83f, V310e). It is the hedge PATH level map,
			-- and it is built HERE, inside the reset below, rather than handed down like `levels`:
			-- the identity test above is exactly "a new render started", so one build per reset is
			-- one build per render, which is what V205 asks. Built outside the reset it would be
			-- rebuilt once per CONTROL, and read from anywhere the reset cannot reach it would
			-- serve last render's levels with rdk exiting 0 and the gate green - B48's own lesson,
			-- through a third door.
			--
			-- Threading it as a fifth argument to pickerItems was the alternative and it is worse:
			-- the four callers that build `levels` would each have to build this one too, and two
			-- of them - applyLanguage and applyTheme - have no business knowing what a hedge path
			-- is.
			local memo = { stamp = nil, levels = false, hedge = nil, lists = {} };

			-- `levels` is the map discLevels() builds, handed in by the caller so it is built once
			-- per traversal and not once per item (SPEC V205). Callers that filter nothing may
			-- pass nil.
			local function pickerItems(c, lang, era, levels)
				local nm = c:getName();

				if nm == nil or string.sub(nm, 1, 3) ~= "cbo" then return; end;

				local filter = isFilterRow(nm) and levels ~= nil;

				-- The AUTHORED list, and it is a CONSTANT nobody writes (SPEC V201, I27). It used to be
				-- a per-handle snapshot of c.values, taken off the XML attribute; both branches of that
				-- ended at c.values, so the moment the attribute left the XML the snapshot would have
				-- caught an EMPTY list, once and forever, and every dropdown on the sheet would have
				-- come up blank with rdk exiting 0 and the gate green.
				--
				-- The `or c.values` tail is for the pickers that did NOT migrate - cboGame and
				-- cboSheetTheme on this form, and WoD20.3 - which still author their list inline.
				local vals = PICKER_LIST[fieldRoot(nm)] or c.values;

				if vals == nil then return; end;

				local vamp  = isVampireRow(nm);

				-- Which FIELD the control writes, and the two spellings do not share one rule
				-- (SPEC I68, V272c). A ROW carries its number - cbonumina_1 -> numina_1 - and
				-- dropping the "cbo" is the whole of it. A SINGLETON does not: string.sub on
				-- cboHedgeAttr hands back `HedgeAttr` with the capital still on it, sheet[field]
				-- comes out nil, and V200 lets go of the stored value without a symptom anywhere -
				-- no error, rdk exiting 0, gate green. fieldRoot lowercases that first letter,
				-- which is what it was written to do, and it cannot serve the rows in turn: it
				-- strips `_?%d+$` and would answer `numina` for all seventeen.
				local field = nil;

				if filter then
					field = (string.match(nm, "_%d+$") ~= nil) and string.sub(nm, 4) or fieldRoot(nm);
				end;

				-- What the ROW is holding right now. It stays in the list however illegal it has
				-- become (SPEC V200): lowering a Discipline does not clear a row (SPEC V187), and
				-- a comboBox whose value is not among its values renders BLANK, so dropping it
				-- would make the sheet look like it had thrown the data away. It leaves the list
				-- the moment the player picks something else - then it is no longer the value.
				local current = (field ~= nil and sheet ~= nil) and sheet[field] or nil;

				-- The stamp names EVERYTHING the answer depends on (SPEC V205, V272b). The
				-- affiliation joined it in the 94th round with the two filters of I67/I68: without
				-- it, switching affiliation leaves lang and era untouched, the stamp holds, and
				-- every combo is served the list built under the OLD affiliation - the filters
				-- born broken with rdk exiting 0 and the gate green. This is the same memo B48
				-- caught serving a stale list one lesson ago.
				local stamp = tostring(lang) .. "|" .. tostring(era) .. "|" .. tostring(sheet ~= nil and sheet.hedgeAffiliation or "");

				if memo.stamp ~= stamp or memo.levels ~= levels then
					memo.stamp  = stamp;
					memo.levels = levels;
					memo.hedge  = hedgePathLevels();
					memo.lists  = {};
				end;

				-- The key names what the answer depends on and nothing else. The row's own value
				-- only changes the list when the filter would otherwise DROP it (SPEC V200), and
				-- that is the rare case, so it is asked once per control instead of keyed blindly:
				-- keying on the value itself would give twenty-five filled ritual rows twenty-five
				-- keys and share nothing. mainPath is keyed by the CONTROL because its answer
				-- really is per row - one main path per blood sorcery (SPEC V181) means row 1
				-- offers what row 2 must not, so those five never share and must not appear to.
				--
				-- FILTER_NAME is on the same footing and for the same reason (SPEC I67, T605):
				-- cbonumina_1 is the Affinity Path and answers to the affiliation, while
				-- cbonumina_2..17 answer to nothing - yet fieldRoot hands all seventeen the root
				-- `numina`. Sharing one key would let whichever rendered FIRST decide: row 1 first
				-- and the other sixteen inherit its pruned list, rows 2..17 first and row 1 is
				-- served the whole one with its filter silently doing nothing. Neither shows an
				-- error and both survive rdk (SPEC B48, V272).
				local root = fieldRoot(nm);
				local odd  = (current ~= nil and current ~= "" and not pickAllowed(field, current, levels, memo.hedge)) and current or "";
				local per  = (root == "mainPath") and nm or root;
				local key  = (FILTER_NAME[nm] == true and nm or per) .. "|" .. odd;
				local hit  = memo.lists[key];
				local shown = hit ~= nil and hit.shown or nil;
				local kept  = hit ~= nil and hit.kept or nil;

				if hit == nil then
					shown = {};
					kept  = {};

					for k = 1, #vals, 1 do
						local raw = vals[k];
						local ok  = true;

						-- The empty item always passes (SPEC V15), and so does the row's own value.
						if filter and raw ~= "" and raw ~= current then
							ok = pickAllowed(field, raw, levels, memo.hedge);
						end;

						if ok then
							local v = raw;

							if vamp then v = eraName(v, era); end;
							if lang == "pt" then v = PT[v] or v; end;

							kept[#kept + 1]   = raw;
							shown[#shown + 1] = v;
						end;
					end;

					memo.lists[key] = { kept = kept, shown = shown };
				end;

				-- Written as one aligned pair (SPEC V202): same length, same order, so item N
				-- still shows value N. The filter only ever REMOVES a row of the pair - it never
				-- rewrites a value, which is what leaves SPEC V24 untouched.
				--
				-- BOTH are written on every pass, unconditionally. It used to be `if filter then`,
				-- which was right only while the XML authored values=: the eight unfiltered pickers
				-- got their values from the attribute and needed items alone. With the list coming
				-- from PICKER_LIST (SPEC I27) that attribute is gone, so a guarded write would leave
				-- them showing every entry and STORING none.
				c.values = kept;
				c.items = shown;
			end;

			-- Re-filter the pickers of one Vampire area after the Disciplines moved (SPEC I25).
			-- Reached from the dataLinks on WoD20.13 and WoD20.14, which watch the nineteen Discipline
			-- rows and their dots - what the answer actually READS.
			--
			-- The map is built ONCE here and handed to every item (SPEC V205). Controls come from
			-- xpFind walking the root, the one finder this sheet has (SPEC V143): `form.<name>`
			-- does not cross an <import>, and this function lives in WoD20.6 while the combos live
			-- two files away.
			function renderVampPickers(from)
				wodTrace("renderVampPickers");
				if sheet == nil or from == nil then return; end;

				local names = {};

				-- The typed rows are skipped, not just missed (SPEC I45, V248d): they carry an
				-- `edt` and the walk asks for `cbo`, so xpFind would come back empty for them
				-- anyway - naming them here would be asking for a control that cannot exist.
				for i = 1, MAIN_PATH_ROWS, 1 do names["cbomainPath_" .. i] = true; end;
				for i = 1, SEC_PATH_ROWS - SEC_PATH_FREE_ROWS, 1 do names["cbosecPath_" .. i] = true; end;
				for i = 1, RITUAL_ROWS - RITUAL_FREE_ROWS, 1 do names["cboritual_" .. i] = true; end;

				local found  = {};
				local lang   = sheet.language or "en";
				local era    = currentTheme();
				local levels = discLevels();

				xpFind(rootOf(from), names, found);

				for nm, c in pairs(found) do
					pickerItems(c, lang, era, levels);
				end;
			end;

			-- Re-filter the hedge pickers of WoD20.7 (SPEC I67, I68, V272d, I83i). Reached from the
			-- dataLink that watches `hedgeAffiliation` and from the one that watches the seventeen
			-- numina rows AND their eighty-five dots - what the two answers actually READ - and it
			-- is renderVampPickers with fourteen names instead of forty-nine.
			--
			-- FOURTEEN since the 112th round: the twelve picked ritual rows joined the Affinity
			-- Path and the casting attribute here rather than in a renderer of their own. One
			-- function because it is one tab and one xpFind walk; the cost of a numina dot also
			-- refreshing two combos that do not depend on it is two setValues, and the cost of a
			-- second renderer is a second name list to keep in step with FILTER_ROW.
			--
			-- It lives here beside its sister and for the same reason: the combos are drawn in
			-- WoD20.7, `form.<name>` does not cross an <import>, and xpFind is the one finder this
			-- sheet has (SPEC V143, B9).
			--
			-- `levels` is still built and handed in, though none of these read it: filter is
			-- `isFilterRow(nm) and levels ~= nil`, so passing nil would turn every filter OFF and
			-- leave the round doing nothing at all with rdk exiting 0. The hedge path map is NOT
			-- built here - it rides the picker memo's own generation (SPEC I83f).
			function renderHedgePickers(from)
				wodTrace("renderHedgePickers");
				if sheet == nil or from == nil then return; end;

				local names  = { cbonumina_1 = true, cboHedgeAttr = true };

				-- The typed rows are skipped, not just missed (SPEC V248c): they carry an `edt`
				-- and this walk asks for `cbo`, so naming them would be asking for a control that
				-- cannot exist.
				for i = 1, HEDGE_RITUAL_ROWS - HEDGE_RITUAL_FREE_ROWS, 1 do names["cbohedgeRitual_" .. i] = true; end;

				local found  = {};
				local lang   = sheet.language or "en";
				local era    = currentTheme();
				local levels = discLevels();

				xpFind(rootOf(from), names, found);

				for nm, c in pairs(found) do
					pickerItems(c, lang, era, levels);
				end;
			end;

			-- Show the picker or the typed twin, one of each pair at a time (SPEC I71, V274, user
			-- 2026-08-23). The storyteller who runs homebrew needs an affiliation or a clan the
			-- books never printed, and a dropdown cannot offer what nobody wrote down.
			--
			-- ONE function for BOTH pairs, and the two flags are read together: it is reached from
			-- two dataLinks and from two tab events, and either entry has to leave all four
			-- controls agreeing with the two flags - a renderer that only fixed "its" pair would
			-- leave the other one wherever the last event left it.
			--
			-- The flags are fail-closed: nil is not true, so a sheet saved before this round opens
			-- with the pickers showing (SPEC V80, V89, V175).
			--
			-- `visible` AND `enabled`, on the same two lines, for the four of them (SPEC V274d).
			-- Writing only `visible` leaves an invisible control taking Tab focus, which is the bug
			-- that shows up in no screenshot - the same pairing cboClan is authored with.
			--
			-- xpFind from the ROOT and not the tab: the two pairs live in WoD20.7 and WoD20.11,
			-- two tabs apart, and `form.<name>` does not cross an <import> (SPEC V143, B9).
			function renderManualEntry(from)
				wodTrace("renderManualEntry");
				if sheet == nil or from == nil then return; end;

				local names = {
					cboHedgeAffiliation = true, edtHedgeAffiliation = true,
					cboClanFamily = true, edtClanFamily = true,
				};

				local found = {};

				xpFind(rootOf(from), names, found);

				-- Which of the four is the one on show. The picker is the DEFAULT side of each
				-- pair, so it reads the flag negated and the typed twin reads it straight.
				local on = {
					cboHedgeAffiliation = sheet.stManualAffiliation ~= true,
					edtHedgeAffiliation = sheet.stManualAffiliation == true,
					cboClanFamily       = sheet.stManualClanFamily ~= true,
					edtClanFamily       = sheet.stManualClanFamily == true,
				};

				for nm, show in pairs(on) do
					local c = found[nm];

					if c ~= nil then
						c.visible = show;
						c.enabled = show;
					end;
				end;
			end;

			-- A combo of VALUE - cmbHealthLevels, cmbSpecCost, cmbBgCost - translates its own
			-- items, and pickerItems will not do it: that one opens with a cbo* test and returns
			-- (SPEC I52, V257, B57). The .lang keys these strings carry answer to the HOST's
			-- language; this answers to the sheet's own `language` field, which is the one the
			-- player switches, and the two are different axes rather than two copies.
			--
			-- BY PREFIX, never by name (SPEC V257a). Naming cmbSpecCost would have fixed today's
			-- combo and left the next one born mute with nothing measuring it - which is exactly
			-- the shape B57 arrived in.
			--
			-- `values` is READ and never written (SPEC V257b, V22): the item is what the player
			-- sees and the value is what the NDB keeps, so a language switch cannot touch stored
			-- data and running this twice lands in the same place. A numeral has no key and falls
			-- through `or v`, so the two price combos cross this without a map entry each.
			--
			-- Declared here rather than at the top of the script on purpose: PT and the traversal
			-- both live above it, and a local called from above its own declaration compiles to a
			-- GETGLOBAL that finds nil (SPEC V223, B51).
			-- The one cmb* whose item is NOT its value, declared rather than guessed at: the
			-- dominator's generation shows `4th` and stores `4`, and maxDiscLevel reads that
			-- number, so the pair cannot be collapsed without repricing every saved sheet
			-- (SPEC I30, V2). Its items are authored once and translated by nobody - `4th` is
			-- `4th` in both languages - so skipping it costs nothing.
			--
			-- This is a declared EXCEPTION, not a nominal selector: the branch below still
			-- reaches every cmb* by prefix, and the gate holds the list to BOTH directions -
			-- a cmb* whose items differ and is not named here turns red, and a name here whose
			-- items match turns red as a dead exception (SPEC V257c). A combo added later can
			-- neither be born mute nor sit in this list unnoticed.
			local CMB_DISPLAY_MAP = { cmbDominatorGen = true };

			local function cmbItems(c, lang)
				local nm = c:getName();

				if nm == nil or string.sub(nm, 1, 3) ~= "cmb" then return; end;
				if CMB_DISPLAY_MAP[nm] then return; end;

				local vals = c.values;

				if vals == nil then return; end;

				local shown = {};

				for i = 1, #vals, 1 do
					local v = vals[i];

					shown[i] = (lang == "pt") and (PT[v] or v) or v;
				end;

				c.items = shown;
			end;

			-- SPEC V22 / B.8: the authored English is snapshotted once and never overwritten.
			-- The old routine translated label.text in place with no original kept, which is
			-- why it could not switch back and why a second run did nothing.
			local originalText = {};

			local function applyLanguage(lang, from)
				local root = rootOf(from);
				local all = {root};
				collect(root, all);

				-- Built once for the whole traversal, not once per picker (SPEC V205). This walk
				-- is also what filters the vampire lists on LOAD and on a language switch, so the
				-- filter needs no third trigger of its own.
				local levels = discLevels();

				for i = 1, #all, 1 do
					local c = all[i];
					local cls = c:getClassName();

					-- Controls whose text belongs to Lua are named `dyn*` and are skipped here.
					-- SPEC V31 made the same call for the numina description block: this routine
					-- snapshots the authored English ONCE, so a control whose text is rewritten
					-- later (the health track changing length) would be restored to a stale
					-- label. Whoever writes the text owns both languages for it.
					local dynName = c:getName();
					local isDyn = dynName ~= nil and string.sub(dynName, 1, 3) == "dyn";

					if isDyn then
						-- nothing: renderHealthTrack keeps this one in the right language
					elseif cls == "label" or cls == "checkBox" or cls == "button" then
						local h = c.handle;

						if originalText[h] == nil then
							originalText[h] = c.text or "";
						end;

						local orig = originalText[h];

						if orig ~= "" then
							if lang == "pt" then
								c.text = PT[orig] or orig;
							else
								c.text = orig;
							end;
						end;
					elseif cls == "comboBox" then
						pickerItems(c, lang, currentTheme(), levels);
						cmbItems(c, lang);
					end;
				end;
			end;
			-- ---- Era abilities (SPEC I7 / V70 / V72 / V74 / V76, rewritten in the 21st) -
			--
			-- A row on the Main tab is a SLOT: the era says which ability sits there, and the
			-- five dots are rebound to THAT ability's field before they are repainted. A name
			-- owns one field and shares it with nothing (SPEC V74), so switching era can no
			-- longer show one trait's dots under another trait's name (SPEC B24 / B23).
			--
			-- The labels are named dyn* so the language traversal above leaves them alone
			-- (SPEC V31): whoever writes a text owns both languages for it, and here even the
			-- English depends on the era, so it is resolved before translating.
			--
			-- Runs on load and on BOTH switches, era and language (SPEC V72).
			--
			-- What it renders depends on exactly two things, so it remembers the pair and
			-- returns when neither moved (SPEC V124). Both dataLinks below carry a
			-- defaultValue, so BOTH fire when the sheet opens - this ran twice over the whole
			-- control tree, rebinding a hundred and fifty dots each time, before the sheet was
			-- even on screen (SPEC B34).
			local abilityMemo = nil;

			local function renderAbilityLabels(lang, from)
				local era = currentTheme();
				local memo = era .. "|" .. tostring(lang);

				if abilityMemo == memo then return; end;

				abilityMemo = memo;

				local lists = ERA_ABILITIES[era];

				-- field -> name, rebuilt here rather than at load: this file is a tab, and the
				-- root form's tables are not guaranteed to be in place while it parses.
				local nameOf = {};

				for n, f in pairs(ABILITY_FIELD) do nameOf[f] = n; end;

				local function show(c, text)
					local want = text;

					if lang == "pt" then want = PT[text] or text; end;

					if c.text ~= want then c.text = want; end;
				end;

				local root = rootOf(from);
				local all = {root};

				collect(root, all);

				-- Rebinding 150 dots writes 150 fields, and every one of those writes lands on
				-- the experience guard. Left alone that is 300 walks of the ledger before the
				-- sheet is even on screen - twice over, since the language and the theme link
				-- both fire on load - which is what froze it (SPEC B30 / V107). None of these
				-- writes changes a rating, so there is nothing here for the guard to weigh and
				-- nothing to re-render once the batch is done.
				xpQuiet = true;

				for i = 1, #all, 1 do
					local c = all[i];
					local cls = c:getClassName();
					local nm = c:getName();

					if nm == nil then
						-- unnamed control: nothing here addresses it
					elseif cls == "label" and string.sub(nm, 1, 7) == "dynAbil" then
						local col, num = string.match(string.sub(nm, 8), "^(%a+)(%d+)$");

						if col ~= nil and lists[col] ~= nil then
							local name = lists[col][tonumber(num)];

							if name ~= nil then show(c, name); end;
						end;
					elseif cls == "imageCheckBox" and string.sub(nm, 1, 4) == "abil" then
						local col, num, dot = string.match(string.sub(nm, 5), "^(%a+)(%d+)_(%d+)$");

						if col ~= nil and lists[col] ~= nil then
							local name = lists[col][tonumber(num)];
							local field = nil;

							if name ~= nil then field = ABILITY_FIELD[name]; end;

							if field ~= nil then
								-- Rebinding does not repaint by itself, so the state is reloaded
								-- in the same step - otherwise the dot would keep showing what
								-- the PREVIOUS field had (SPEC V76).
								--
								-- Both writes are compared first (SPEC V122). A bound dot writes
								-- its field through the NDB, so putting back the value that is
								-- already there wakes every link watching that trait for nothing.
								-- Most eras differ from the authored list by a couple of rows;
								-- this makes the other twenty-eight cost nothing.
								local full = field .. "_" .. dot;

								if c.field ~= full then c.field = full; end;

								if sheet ~= nil then
									local want = sheet[full] == true;

									if c.checked ~= want then c.checked = want; end;
								end;
							end;
						end;
					elseif cls == "label" and string.sub(nm, 1, 5) == "dynRo" then
						-- The Combat mirror. Its rows are fixed fields except the ranged one,
						-- which is Firearms or Archery depending on the era (SPEC V74).
						local f = string.sub(nm, 6);
						local text = nil;

						if f == "ranged" then
							text = eraRangedName();
						else
							text = nameOf[f];
						end;

						if text == nil then
							-- An attribute row: no era ever renames it, so the authored English
							-- stands, snapshotted once like the translation does (SPEC V22).
							local h = c.handle;

							if originalText[h] == nil then originalText[h] = c.text or ""; end;

							text = originalText[h];
						end;

						if text ~= "" then show(c, text); end;
					end;
				end;

				xpQuiet = false;
			end;

			-- ---- Theme (SPEC I5/I6, 14th round) --------------------------------------
			--
			-- The sheet ships three looks. `Modern` is the sheet exactly as authored; the two
			-- Victorian variants repaint it at runtime. Every property involved has a setter
			-- (SPEC R22), so there is no second .lfm per theme and no field but `sheetTheme`.
			--
			-- Modern deliberately has NO palette below (SPEC V54): going back restores the
			-- snapshot taken before the first repaint, so the "modern" look cannot drift from
			-- what the XML declares. Same reason the translation keeps the authored English
			-- instead of a second table (SPEC V22).
			--
			-- Colour keys are the literals AUTHORED in the nine .lfm files, spelled as they
			-- appear there. The gate greps color=/strokeColor=/fontColor= out of those files
			-- and asserts every literal is a key here (SPEC V53) - a new box painted with a
			-- new colour turns the gate red instead of sitting black in the parchment.
			local THEMES = {
				-- The night the table actually plays in: cool charcoal, graphite rules, one
				-- crimson accent. Named `Modern` since the 16th round, when the palette-less
				-- baseline that used to hold that name was dropped (SPEC C, 16th round).
				["Modern Nights"] = {
					form       = "dark",
					fontFamily = "Segoe UI",
					fill = {
						["black"]     = "#12141A",    -- charcoal, blue cast
						["#0A0A0A"]  = "#0A0B10",    -- charcoal, one step under the box
						["DimGray"]   = "#2A2F3A",
						["#00000000"] = "#00000000",  -- health mark box: the cut-out IS the effect (SPEC V48)
						-- The one-second flash on a newly sorted ritual row (SPEC I47, V253). Alpha,
						-- so the name reads through it, and the period's own accent rather than one
						-- loose colour outside the theme (SPEC V53).
						["#55FFFFFF"] = "#55A83232",  -- crimson, the era's dot art
					},
					stroke = {
						["white"]   = "#3A4150",      -- cold graphite
						["#FFFFFF"] = "#3A4150",
						["black"]   = "#3A4150",
						["#00000000"] = "#00000000",  -- tab-strip floor: the band keeps its fill and loses its 3px outline -- SPEC I74b, V287
					},
					font = {
						["white"] = "#E6E8EC",
						["#C2A14D"] = "#A83232",   -- era accent: the open sub-tab wears it (SPEC I78c, V305d)
					},
					-- Plugin-absolute, NOT the relative form the XML uses. The rdk resolves
					-- src=/checkedImage= at COMPILE time - the generated Lua reads
					-- setImageChecked("/WoD20th/images/prime_on.png") - so a relative
					-- path handed to a setter at runtime resolves to nothing and the art
					-- silently fails to load (SPEC B20 / V60 / R26).
					dotOn  = "/WoD20th/images/prime_on_crimson.png",
					dotOff = "/WoD20th/images/prime_off_slate.png",
					paper  = "/WoD20th/images/paper_present.png",

					-- The tenth and eleventh keys, and they arrive together in the 118th round: the
					-- era gets a frame, and it is drawn FOR the cut corner below rather than in
					-- spite of it (SPEC I90a).
					--
					-- The crimson is the one the palette already carries as the era's accent, the
					-- one the open sub-tab wears (font["#C2A14D"] above). Not a new value: a frame
					-- that introduced a colour of its own would be the loose colour V53 exists to
					-- refuse, and the plate's gold is the VICTORIAN key - the plate says shape,
					-- not colour (user 2026-08-26).
					ornament = "#A83232",
					ornStyle = "corrente",

					-- The twelfth key, OPTIONAL like the two above, and the only one that is
					-- geometry rather than colour (SPEC I89a). ONE table and not two scalars: "a
					-- type with no radius" and "a radius with no type" are then not representable
					-- at all, so there is no invariant left to write - the opposite of what
					-- ornStyle forced V313a to do.
					--
					-- A straight 45 degree cut takes LESS corner than the concave arc of the same
					-- radius, so 18 gives back the weight the bevel loses (user 2026-08-26). The
					-- other three periods declare nothing and fall to the corner the XML authored,
					-- which is the ONLY way back out (SPEC V316c).
					--
					-- The 117th round forbade an `ornament` beside this key outright (V316b). The
					-- 118th REVOKES that and puts AGREEMENT in its place (SPEC V317a): what was
					-- wrong was never the pairing, it was a CONCAVE drawing over a cut corner -
					-- the filigree and the filete arc at ORN_BOXR + ORN_IN = 23 and would cross
					-- the outline they decorate. `corrente` is drawn for the bevel, so the rule is
					-- that the style and the corner AGREE, which also catches the direction the
					-- old ban let through: a bevelled era asking for `filete`.
					boxCorner = { type = "bevel", radius = 18 },
				},

				-- Was "Victorian Era (Dark)" until the 15th round. The suffix went with the
				-- light variant it existed to distinguish; the palette itself is untouched.
				["Victorian Era"] = {
					form       = "dark",
					fontFamily = "Georgia",
					fill = {
						["black"]     = "#1C1310",    -- mahogany
						["#0A0A0A"]  = "#120C0A",    -- mahogany, one step under the box
						["DimGray"]   = "#6B4F2A",
						["#00000000"] = "#00000000",
						["#55FFFFFF"] = "#55C2A14D",  -- aged gold
					},
					stroke = {
						["white"]   = "#C2A14D",      -- aged gold
						["#FFFFFF"] = "#C2A14D",
						["black"]   = "#C2A14D",
						["#00000000"] = "#00000000",
					},
					font = {
						["white"] = "#E8DCC0",        -- cream
						["#C2A14D"] = "#D8BC72",   -- era accent: the open sub-tab wears it (SPEC I78c, V305d)
					},
					dotOn  = "/WoD20th/images/prime_on_gold.png",
					dotOff = "/WoD20th/images/prime_off_gold.png",
					paper  = "/WoD20th/images/paper_victorian.png",
					ornament = "#D8BC72",   -- brighter than the 3px outline, so the filigree reads as applied metal
				},

				-- Europe around 1300: stone and oak by candlelight, now with a silvered rule. The
				-- outline is polished silver over an interior darker than the other three periods
				-- (18th round), and the text is the colour of a tallow candle rather than white.
				["Dark Ages"] = {
					form       = "dark",
					fontFamily = "Book Antiqua",
					fill = {
						["black"]     = "#0E0B09",    -- soot, darker than the candle-lit oak it was
						["#0A0A0A"]  = "#070605",    -- soot, one step under the box
						["DimGray"]   = "#5A4A32",
						["#00000000"] = "#00000000",
						["#55FFFFFF"] = "#55C0C6CC",  -- polished silver
					},
					stroke = {
						["white"]   = "#C0C6CC",      -- polished silver
						["#FFFFFF"] = "#C0C6CC",
						["black"]   = "#C0C6CC",
						["#00000000"] = "#00000000",
					},
					font = {
						["white"] = "#E3D8BE",        -- candle on vellum
						["#C2A14D"] = "#C0C6CC",   -- era accent: the open sub-tab wears it (SPEC I78c, V305d)
					},
					dotOn  = "/WoD20th/images/prime_on_silver.png",
					dotOff = "/WoD20th/images/prime_off_silver.png",
					paper  = "/WoD20th/images/paper_dark_ages.png",

					-- The era's OWN silver, and not a brighter one (user 2026-08-26). The Victorian
					-- key above is lighter than its outline so the filigree reads as applied metal;
					-- here rule and frame are meant to be one family, which is what austerity means
					-- in a drawing whose whole argument is that there is only one line (SPEC I87a).
					ornament = "#C0C6CC",

					-- The tenth key, and it is OPTIONAL like the ninth: an era that declares no
					-- style falls to the default, which is the filigree of I72 - so the Victorian
					-- palette gains nothing and changes nothing. A style with no `ornament` beside
					-- it cannot exist: the colour is what hides the path (V277), so the style would
					-- be a dead key nobody could see was dead (SPEC I87a, V313a).
					ornStyle = "filete",
				},

				-- Rome around 200 BC - the Republic, not the Empire, so laurel gold and a
				-- single note of Tyrian purple rather than gilt everywhere. Times New Roman is
				-- literally a Roman face. The gold dots are the Victorian ones: gold is gold,
				-- and a second pair of near-identical art would earn nothing.
				["Classical Age"] = {
					form       = "dark",
					fontFamily = "Times New Roman",
					fill = {
						["black"]     = "#171218",    -- basalt, faint purple cast
						["#0A0A0A"]  = "#0E0B0F",    -- basalt, one step under the box
						["DimGray"]   = "#6B2A4A",    -- Tyrian purple on the avatar frame
						["#00000000"] = "#00000000",
						["#55FFFFFF"] = "#55BFA05A",  -- laurel gold
					},
					stroke = {
						["white"]   = "#BFA05A",      -- laurel gold
						["#FFFFFF"] = "#BFA05A",
						["black"]   = "#BFA05A",
						["#00000000"] = "#00000000",
					},
					font = {
						["white"] = "#F0EAD9",        -- ivory
						["#C2A14D"] = "#BFA05A",   -- era accent: the open sub-tab wears it (SPEC I78c, V305d)
					},
					dotOn  = "/WoD20th/images/prime_on_gold.png",
					dotOff = "/WoD20th/images/prime_off_gold.png",
					paper  = "/WoD20th/images/paper_classical.png",

					-- The 122nd round: of the four palettes this was the ONLY one declaring no ornament,
					-- so V277 hid its path and the box has been bare outline since the system was written.
					-- The colour is the laurel gold the palette ALREADY carries in stroke["white"] - the
					-- Dark Ages choice, where rule and frame are one family (SPEC I87a), not the Victorian
					-- one a step lighter than the outline. The plate draws in a lighter gold and that does
					-- NOT come in: the plate says FORM, never colour, so no loose colour is born (SPEC V53).
					--
					-- NO boxCorner beside them, and it is not an omission: V317a gives the cut corner only
					-- to a style whose branch RECEIVES ornPath radius, and the merlon does not. This era
					-- falls to the innerRound 14 the XML authors on all 73 boxes (SPEC V68, I94a).
					ornament = "#BFA05A",
					ornStyle = "corona-muralis",
				},
			};

			local NAMED_COLORS = {
				["black"]   = "#FF000000",
				["white"]   = "#FFFFFFFF",
				["dimgray"] = "#FF696969",
			};

			-- The colour getter is native, so it may hand back the literal the XML authored
			-- ("black") or a normalised value ("#FF000000"), and that cannot be settled without
			-- running Firecast (SPEC R25). Canonicalise both sides instead - the palette keys
			-- once at load, every snapshot on the way in - and the question stops mattering.
			local function normColor(v)
				if v == nil then return nil; end;
				if type(v) == "number" then return string.format("#%08X", v); end;

				local s = tostring(v);
				local named = NAMED_COLORS[string.lower(s)];

				if named ~= nil then return named; end;
				if string.sub(s, 1, 1) ~= "#" then return string.upper(s); end;

				local hex = string.upper(string.sub(s, 2));

				if string.len(hex) == 6 then hex = "FF" .. hex; end;

				return "#" .. hex;
			end;

			for _, t in pairs(THEMES) do
				local fill, stroke, font = {}, {}, {};

				for k, v in pairs(t.fill)   do fill[normColor(k)]   = v; end;
				for k, v in pairs(t.stroke) do stroke[normColor(k)] = v; end;
				for k, v in pairs(t.font)   do font[normColor(k)]   = v; end;

				t.fill, t.stroke, t.font = fill, stroke, font;
			end;

			-- Same trick as normColor, same reason: the XML authors "images/prime_on.png" and the
			-- rdk rewrites it to "/WoD20th/images/prime_on.png" at compile time (SPEC R26),
			-- so the getter and the source never agree. Compare the file name and both forms
			-- answer the same question.
			local function normPath(v)
				if v == nil then return nil; end;

				local s = string.lower(tostring(v));
				local cut = string.find(s, "/[^/]*$");

				if cut ~= nil then s = string.sub(s, cut + 1); end;

				return s;
			end;

			-- The dot the first column always shows. It is a plain <image>, not an imageCheckBox
			-- (templates `Attribute` in WoD20.1 and `VirtueMirror` in WoD20.3): an attribute's first dot
			-- cannot be switched off, so nothing owns it as a field.
			--
			-- SPEC B22: the 14th round left it out on the grounds that fixed art was not the
			-- theme's business. Wrong - it is the SAME art a ticked box shows, so it stayed white
			-- next to gold, crimson and blood dots in every period.
			local DOT_ON  = "prime_on.png";
			local DOT_OFF = "prime_off.png";

			-- One outline width for every period (SPEC V67), and it lives here rather than four
			-- times inside THEMES: the requirement is that they MATCH, and four copies that
			-- happen to agree today are four copies that can drift tomorrow. Same reasoning as
			-- HEALTH_MARKS on the root form. 3 was the widest of the four when they were merged.
			--
			-- There is deliberately no corner constant to match it (SPEC V66): the corner detail
			-- - cornerType="innerRound" over a radius - is authored in the XML on 53 boxes, so it
			-- already holds in every period. Three rectangles author a radius of their own (the
			-- health mark box and the avatar frame); a single theme-wide radius would flatten
			-- them. The theme simply stops writing radii.
			local THEME_STROKE = 3;

			local THEME_SHAPES = { rectangle = true };
			local THEME_TEXTS  = { label = true, checkBox = true, button = true, comboBox = true,
			                       edit = true, textEditor = true, radioButton = true };

			-- The ledger: handle -> { prop = the value the XML authored }. A property appears
			-- here only once it has actually been REPAINTED, and it holds the original, not
			-- the current value.
			--
			-- SPEC B21: the first version snapshotted every control at load and wrote the
			-- snapshot straight back under Modern, on the assumption that writing a value
			-- equal to the one just read costs nothing. It does not. Every font setter runs
			-- _gui_prepareForFontColorChange / ...FontFamilyChange BEFORE it writes, and that
			-- step detaches the control from the font it inherits through the form theme. The
			-- whole sheet came back wrong on all three options, Modern included - the one that
			-- had not changed in the XML at all.
			--
			-- Hence the two rules below: never write a property without a mapped target
			-- (SPEC V61), and put back only what was actually painted (SPEC V62). A sheet
			-- opened on Modern that was never repainted writes nothing whatsoever.
			local themePainted = {};

			-- What the control had before any theme touched it. Switching straight from one
			-- Victorian variant to the other must map from the ORIGINAL colour, not from the
			-- one the previous variant left behind.
			local function authored(c, prop)
				local rec = themePainted[c.handle];

				if rec ~= nil and rec[prop] ~= nil then return rec[prop]; end;

				return c[prop];
			end;

			local function paint(c, prop, value, original)
				-- No mapped target: leave it alone. A colour the palettes do not know keeps
				-- its Modern value, and the gate turns red for it statically (SPEC V53).
				if value == nil then return; end;

				-- No original to record: the XML never authored this property, so painting it
				-- would be a change nothing could undo. This is the guard B21 was missing.
				if original == nil then return; end;

				local h = c.handle;
				local rec = themePainted[h];

				if rec == nil then rec = {}; themePainted[h] = rec; end;
				if rec[prop] == nil then rec[prop] = original; end;

				c[prop] = value;
			end;

			-- SPEC V55 / R21 / B9: `findClass`, which the rdk generates into every .lfm, starts
			-- from `self` - it reaches the tab it runs on and nothing else, which is why the
			-- theme and colour pickers on the five base sheets only ever painted their own
			-- Credits tab. Walk up to the sheet root first, exactly like applyLanguage.
			--
			-- Nothing here writes left/top/width/height (SPEC V57): the gate keeps measuring
			-- the static XML for overlap, and no theme can invent a collision at runtime.
			-- ---- Victorian filigree (user 2026-08-24) ---------------------------------------
			--
			-- The era's section boxes get applied gold ornament: a double rule following the box's
			-- own corner, a scroll closing each corner arm, bead courses, and a fleuron at the
			-- middle of the long edges. ONE <path> per box, built from that box's width and height.
			--
			-- Vector and not PNG. The boxes run from 160x101 to 1270x574 and one piece of art
			-- stretched across that range shears its own corners; data built per box keeps every
			-- scroll the size it was drawn at and lets only the straight runs grow. It also adds
			-- nothing to `images/`, so V64 has no new art to police and V58/V60 no new path.
			--
			-- MEASURED before drawing: across the 73 boxes the free margin is 10px top and bottom
			-- and ZERO left and right - children span the full box width. So the ornament stays in
			-- the border band and the density goes where there is actually room, the corners, which
			-- centred content never reaches. Deepest point is 23px, on the diagonal.
			local ORN_BOXR  = 14;      -- the radius V68 authors on every section box
			local ORN_OUT   = 5;       -- outer rule, in from the box edge
			local ORN_IN    = 9;       -- inner rule
			local ORN_ARM   = 40;      -- corner reach along each edge
			local ORN_FLEUR = 150;     -- an edge run shorter than this carries no centre motif
			local ORN_KAPPA = 0.5523;  -- cubic approximation of a quarter arc

			-- ---- Dark Ages filete (user 2026-08-26, plate `Filete e Cruz`) ------------------
			--
			-- A SECOND family of box frame, chosen by the palette (SPEC I87). The plate was the
			-- floor of a series - "if this is still too much, the answer is no frame at all" - and
			-- the user picked the floor: ONE hairline at ORN_IN, unbroken the whole way round, a
			-- minute Greek cross on each run leaving a corner and a slightly larger one at the
			-- middle of the top and of the bottom. No scroll, no bead, no palmette. It is not the
			-- filigree shrunk; it is the other drawing, which is why ornPath DISPATCHES.
			--
			-- Every number here is a RELATION and the gate measures it as one (SPEC V314):
			--   * ORN_CROSS_AT lands on the STRAIGHT run. The corner arc gives out at
			--     sqrt((ORN_BOXR + ORN_IN)^2 - ORN_IN^2) = 21.17 along the edge, so 26 has 4.8px
			--     of straight in front of it; at 21 the cross sits on the CURVE and comes out
			--     crooked, with no error and nothing to grep.
			--   * ORN_CROSS2 is CAPPED at ORN_IN - THEME_STROKE. Centred on a rule 9 in, a
			--     half-arm of h reaches 9 - h outward against the box's own 3px outline (V67):
			--     6 touches it, 5 is the last one that clears. It is a ceiling, not a taste.
			--   * inward it reaches ORN_IN + ORN_CROSS2 = 14 against the 20px margin every box
			--     carries (V280a), so the frame draws OVER the content (I72c) and still crosses
			--     no child - with 6px to spare rather than on the tangent.
			--   * ORN_CROSS < ORN_CROSS2 IS the hierarchy: "one slightly larger in the middle" is
			--     what the plate says, and equal arms lose the centre with nothing to say so.
			local ORN_CROSS    = 3;     -- corner cross, half-arm
			local ORN_CROSS2   = 5;     -- centre cross, half-arm
			local ORN_CROSS_AT = 26;    -- the corner cross, along the run from the corner

			-- The room a run needs before it can hold its crosses: both corner crosses and the
			-- centre one, end to end. ONE floor for all three rather than a tighter one per motif -
			-- one fact, one owner (V49) - and what falls below it is the CROSS, never the rule,
			-- which is V279's doctrine in the letter T613 wrote it (SPEC V314e, B59).
			local ORN_CROSS_ROOM = 2 * (ORN_CROSS_AT + ORN_CROSS + ORN_CROSS2);

			-- The CHAIN's one constant (SPEC I90c). Everything else in that drawing is a relation
			-- of the box's own bevel radius and ORN_IN, so this is the only number the style owns
			-- - and it obeys the two ceilings V314 already wrote for the cross rather than
			-- inventing clearances of its own (SPEC I90f):
			--
			--   * outward the link reaches ORN_IN - ORN_LINK = 5.8 against the 3px outline the
			--     theme paints on every box (V67), so 3.2 sits under the ceiling of
			--     ORN_IN - THEME_STROKE = 6, exactly as ORN_CROSS2 does.
			--   * inward it reaches ORN_IN + ORN_LINK = 12.2 against the 20px margin every box
			--     gives its children (V280a), clear by 7.8.
			local ORN_LINK = 3.2;    -- chain link, half-width across the cut

			-- SPEC R111, I78b, V306. The bar's line work is the MARKER's own motif and not the box frame
			-- shrunk: 2*ORN_ARM is 80 against a marker 30 tall. Three motifs, one per LEVEL, because the
			-- two bars are not the same thing on screen (SPEC I78b): the top bar carries two rules with a
			-- fleuron opening the lower one, a sub-bar carries ONE short rule, and a separator carries the
			-- fleuron alone. MEASURING still decides the shape - a rule inset by d from the foot follows
			-- radius ORN_PILLR + d and meets the concave corner at sqrt((r+d)^2 - d^2), so it stops there.
			--
			-- 1px, and that is the whole reason this is a <path> and not a rectangle: applyTheme writes
			-- THEME_STROKE=3 onto every rectangle it repaints (SPEC V67), and the drawing the user chose
			-- is a hairline. The rectangle underneath is a CARRIER now - transparent both ways (SPEC I78a).
			-- ONE FAMILY PER MOTIF since the 111th round (SPEC I80c, V308). They were one heap until B69:
			-- ORN_MARK was read by the `tab` motif AND the `sub` one, and ORN_MARK_RY by `tab` AND `sep`,
			-- so the 110th round moved the top bar and took the other two levels with it - with nothing in
			-- the code able to say `only the top one`. ORN_PILLR is the declared exception and stays shared:
			-- it is not a drawing choice, it is the arc V228 authors on all 19 buttons (one fact, one owner).
			local ORN_PILLR    = 14;    -- the radius V228 authors on every tab button

			-- motif `tab`: two rules, the lower one opened for a fleuron
			local ORN_MARK     = 5;     -- the lower rule, up from the marker's foot
			local ORN_MARK2    = 9;     -- the upper rule
			local ORN_MARK_RX  = 4;     -- fleuron half-width
			local ORN_MARK_RY  = 3;     -- fleuron half-height
			local ORN_MARK_GAP = 4;     -- clear space each side of the fleuron

			-- motif `sub`: one short rule, where the user approved it in the 109th round (SPEC I80b)
			local ORN_SUB      = 0.18;  -- short: this much of the width in from each end
			local ORN_SUB_MARK = 7;     -- the rule, up from the marker's foot

			-- motif `sep`: the fleuron alone, between two sub-tab words
			local ORN_SEP_RX   = 4;     -- fleuron half-width
			local ORN_SEP_RY   = 3.5;   -- fleuron half-height

			-- ---- Dark Ages filete: the BAR (user 2026-08-26, plate `Abas em Filete e Cruz`) --
			--
			-- A SECOND family of bar drawing, chosen by the same palette key the box frame is
			-- (SPEC I88a, I87a). One hairline and the Greek cross at all three levels: the tab
			-- wears the rule with a cross at each foot, the sub-tab the rule alone, and the
			-- separator the cross alone. No second rule and no fleuron anywhere in it.
			--
			-- OWN constants, per STYLE, for the reason V308 gives per MOTIF (B69): a number that
			-- serves two drawings moves both when only one of them was asked for. Two exceptions,
			-- and they are declared rather than accidental - ORN_PILLR, the arc V228 authors on
			-- all nineteen buttons, and ORN_SUB_MARK, the sub-tab height the user approved in the
			-- 109th round, which is one fact in either style (SPEC I88e, V315b).
			--
			-- THE RELATION, and it is why these two numbers are 6 and 3 (SPEC I88d, V315c): in
			-- the default style the topmost ink IS the upper rule, at h - ORN_MARK2 = 21, and
			-- that is the state the user approved on screen in the 112th round. Here the topmost
			-- ink is the cross's UPPER ARM, so keeping the rule at 21 would put the cross at 18 -
			-- inside the label box, which closes at 20, against a measured clearance of about 2.5
			-- at 21. So ORN_FIL_MARK + ORN_FIL_CROSS = ORN_MARK2 and the highest ink stays
			-- exactly where it already was. The GATE welds that; the code does NOT derive one
			-- from the other, which would be one constant serving two styles all over again.
			local ORN_FIL_MARK  = 6;    -- motif `tab`: the one rule, up from the marker's foot
			local ORN_FIL_CROSS = 3;    -- motif `tab`: half-arm of the cross at each end
			local ORN_FIL_SEP   = 2.5;  -- motif `sep`: half-arm, smaller than the tab's by choice

			-- ---- Modern Nights corrente: the BAR (user 2026-08-27, plate `Sombra`) ---------
			--
			-- The THIRD family of bar drawing, chosen by the same palette key the box frame is
			-- (SPEC I91a). The chain era gets its own bar, and `sombra` - the name the plate
			-- carries in its footer - stays out of the code: one era, one key, two painters.
			-- It REVOKES I90h, which one round ago left this era's bar on the default drawing.
			--
			-- TWO rules at every level, and the hierarchy is INSIDE the marker (SPEC I91b, I91c):
			-- the tab's main rule runs LONGER (a fixed inset of 14 against the sub-tab's foot at
			-- 19.80) and its second rule WIDER (40% of the width against 30%). Equal on either
			-- axis and the two bars become the same drawing, which is I78b's hierarchy lost with
			-- nothing anywhere to say so, so the gate welds both (SPEC V319c).
			--
			-- OWN constants, per STYLE and per MOTIF, for the reason V308 gives (B69): a number
			-- that serves two drawings moves both when only one of them was asked for. That is
			-- why ORN_COR_MARK2 and ORN_COR_SUB2 are two constants holding the same 3 - equal
			-- value is not shared ownership, and it is the only shape in which the second rule of
			-- ONE level can be moved. ORN_SUB_MARK stays the declared exception it already is in
			-- markFilete: the sub-tab height the user approved in the 109th round is one fact.
			--
			-- THE INSET IS LITERAL, and that was measured rather than assumed (SPEC I91b): the
			-- foot of a rule 7 up from the marker's bottom is sqrt((14+7)^2 - 7^2) = 19.80, so 14
			-- puts the ends 5.8 OUTSIDE the concave arc. It is not the crossing I72a forbids -
			-- that one is ink crossing a PAINTED outline, and tabOn<X> is transparent on both
			-- sides (WoD20th.lfm:3826), so there is no silhouette on screen to cross. The 14 is
			-- ORN_PILLR's value and NOT its owner: the pill radius moving must not move a rule.
			local ORN_COR_MARK     = 7;     -- motif `tab`: the main rule, up from the marker's foot
			local ORN_COR_IN       = 14;    -- motif `tab`: fixed inset of the main rule, each end
			local ORN_COR_MARK2    = 3;     -- motif `tab`: the second rule, up from the foot
			local ORN_COR_SPAN     = 0.30;  -- motif `tab`: second rule starts this much of the width in
			local ORN_COR_SUB2     = 3;     -- motif `sub`: the second rule, up from the foot
			local ORN_COR_SUB_SPAN = 0.35;  -- motif `sub`: second rule starts this much of the width in
			local ORN_COR_DOT      = 3.2;   -- motif `sep`: radius of the filled dot
			-- Path data is parsed as SVG, where a comma separates x from y. The C library float
			-- verbs follow LC_NUMERIC, so on a pt-BR host they write a decimal COMMA and every
			-- coordinate parses as two numbers. Build the one decimal by hand instead: integer
			-- tostring carries no locale.
			local function ornNum(x)
				local n = math.floor(x * 10 + 0.5);
				local sign = "";

				if n < 0 then sign = "-"; n = -n; end;

				return sign .. tostring(math.floor(n / 10)) .. "." .. tostring(n % 10);
			end;

			-- Every motif is drawn ONCE, in canonical space - the top-left corner, u to the right
			-- and v into the box - and stamped through `t`, which mirrors and transposes it onto the
			-- other seven positions. One drawing per motif, so four corners cannot drift apart the
			-- way four hand-authored copies would.
			local function ornX(t, u, v)
				if t.swap then return t.ox + t.sx * v; end;
				return t.ox + t.sx * u;
			end;

			local function ornY(t, u, v)
				if t.swap then return t.oy + t.sy * u; end;
				return t.oy + t.sy * v;
			end;

			local function ornMove(o, t, u, v)
				o[#o + 1] = "M" .. ornNum(ornX(t, u, v)) .. "," .. ornNum(ornY(t, u, v));
			end;

			local function ornLine(o, t, u, v)
				o[#o + 1] = "L" .. ornNum(ornX(t, u, v)) .. "," .. ornNum(ornY(t, u, v));
			end;

			local function ornCurve(o, t, u1, v1, u2, v2, u, v)
				o[#o + 1] = "C" .. ornNum(ornX(t, u1, v1)) .. "," .. ornNum(ornY(t, u1, v1))
				         .. " " .. ornNum(ornX(t, u2, v2)) .. "," .. ornNum(ornY(t, u2, v2))
				         .. " " .. ornNum(ornX(t, u,  v))  .. "," .. ornNum(ornY(t, u,  v));
			end;

			-- One cubic across an arc centred on the box corner. The box corner is CONCAVE
			-- (cornerType="innerRound", V68), so insetting it by d rides a LARGER circle, radius
			-- ORN_BOXR + d - offset it the wrong way and the rule crosses the outline it decorates.
			local function ornArc(o, t, r, a1, a2)
				local k = (4 / 3) * math.tan((a2 - a1) / 4);

				ornCurve(o, t,
					r * math.cos(a1) - k * r * math.sin(a1), r * math.sin(a1) + k * r * math.cos(a1),
					r * math.cos(a2) + k * r * math.sin(a2), r * math.sin(a2) - k * r * math.cos(a2),
					r * math.cos(a2),                        r * math.sin(a2));
			end;

			-- A scroll: five quarter turns of a spiral that gives up a fifth of its radius each time.
			-- Cubic quarter-arcs rather than one SVG `A`: nothing in this repo has ever asked this
			-- renderer to parse an arc command, and a curl that failed to parse would take its whole
			-- box's ornament down with it.
			local function ornVolute(o, t, cu, cv, r, a0, turn)
				local ang, rad = a0, r;

				ornMove(o, t, cu + rad * math.cos(ang), cv + rad * math.sin(ang));

				for _ = 1, 5, 1 do
					local nAng = ang + turn * (math.pi / 2);
					local nRad = rad * 0.8;
					local k1 = ORN_KAPPA * rad * turn;
					local k2 = ORN_KAPPA * nRad * turn;

					ornCurve(o, t,
						cu + rad  * math.cos(ang)  - k1 * math.sin(ang),
						cv + rad  * math.sin(ang)  + k1 * math.cos(ang),
						cu + nRad * math.cos(nAng) + k2 * math.sin(nAng),
						cv + nRad * math.sin(nAng) - k2 * math.cos(nAng),
						cu + nRad * math.cos(nAng),
						cv + nRad * math.sin(nAng));

					ang, rad = nAng, nRad;
				end;
			end;

			-- A pointed leaf between two points: out along one bulge and back along its mirror, so
			-- the two cubics close a lens. Unfilled like everything here - the ornament is line work,
			-- and a filled leaf reads as a blot at this size.
			local function ornLeaf(o, t, u1, v1, u2, v2, b)
				local du, dv = u2 - u1, v2 - v1;
				local len = math.sqrt(du * du + dv * dv);

				if len < 0.01 then return; end;

				local nu, nv = -dv / len * b, du / len * b;

				ornMove(o, t, u1, v1);
				ornCurve(o, t, u1 + du * 0.28 + nu, v1 + dv * 0.28 + nv,
				               u1 + du * 0.72 + nu, v1 + dv * 0.72 + nv, u2, v2);
				ornCurve(o, t, u1 + du * 0.72 - nu, v1 + dv * 0.72 - nv,
				               u1 + du * 0.28 - nu, v1 + dv * 0.28 - nv, u1, v1);
			end;

			local function ornDot(o, t, cu, cv, r)
				local k = ORN_KAPPA * r;

				ornMove(o, t, cu + r, cv);
				ornCurve(o, t, cu + r, cv + k, cu + k, cv + r, cu,     cv + r);
				ornCurve(o, t, cu - k, cv + r, cu - r, cv + k, cu - r, cv);
				ornCurve(o, t, cu - r, cv - k, cu - k, cv - r, cu,     cv - r);
				ornCurve(o, t, cu + k, cv - r, cu + r, cv - k, cu + r, cv);
			end;

			-- The corner piece: both rules turning the corner along the box's own arc, a bead course
			-- on the curve, a three-leaf palmette on the diagonal, a scroll closing each arm and
			-- beads running back along it.
			local function ornCorner(o, t, a)
				local runs = { {ORN_OUT, a}, {ORN_IN, a - 7} };

				for i = 1, 2, 1 do
					local d = runs[i][1];
					local tip = runs[i][2];
					local r = ORN_BOXR + d;
					local u0 = math.sqrt(r * r - d * d);
					local a1 = math.atan(d / u0);

					ornMove(o, t, d, tip);
					ornLine(o, t, d, u0);
					ornArc(o, t, r, (math.pi / 2) - a1, a1);
					ornLine(o, t, tip, d);
				end;

				local rMid = ORN_BOXR + (ORN_OUT + ORN_IN) / 2;

				for _, ang in ipairs({ (math.pi / 4) - 0.42, math.pi / 4, (math.pi / 4) + 0.42 }) do
					ornDot(o, t, rMid * math.cos(ang), rMid * math.sin(ang), 1.4);
				end;

				local rIn = ORN_BOXR + ORN_IN;
				local q = math.pi / 4;

				ornLeaf(o, t,
					(rIn + 2.5) * math.cos(q), (rIn + 2.5) * math.sin(q),
					(rIn + 9.5) * math.cos(q), (rIn + 9.5) * math.sin(q), 3.4);

				for _, s in ipairs({ -1, 1 }) do
					ornLeaf(o, t,
						(rIn + 2.5) * math.cos(q + s * 0.34), (rIn + 2.5) * math.sin(q + s * 0.34),
						(rIn + 8.0) * math.cos(q + s * 0.62), (rIn + 8.0) * math.sin(q + s * 0.62), 2.2);
				end;

				ornVolute(o, t, ORN_IN, a - 1, 5, -math.pi / 2, 1);
				ornVolute(o, t, a - 1, ORN_IN, 5, math.pi, -1);

				local mid = (ORN_OUT + ORN_IN) / 2;
				local straight = math.sqrt((ORN_BOXR + ORN_IN) * (ORN_BOXR + ORN_IN) - ORN_IN * ORN_IN) + 2;

				for _, u in ipairs({ a - 11, a - 18, a - 25 }) do
					-- Only where the inner rule has already gone straight. Inside the arc a bead sits
					-- ON the corner instead of beside it, and a short box has no straight run left to
					-- put one on: what a short arm drops is the MOTIF, never the rule (SPEC V279).
					if u >= straight then
						ornDot(o, t, u, mid, 1.3);
						ornDot(o, t, mid, u, 1.3);
					end;
				end;
			end;

			-- One edge, corner to corner. A short run is two plain rules; a long one opens at the
			-- middle for a lozenge astride the outer rule, a leaf either side and a scroll closing
			-- each end.
			local function ornEdge(o, t, span, a)
				local i, j = ORN_OUT, ORN_IN;

				if span - 2 * a <= 0 then return; end;

				-- A run is drawn only where it has positive length. On a short edge the inner rule
				-- would otherwise be emitted BACKWARDS - end before start - which draws a line back
				-- across the corner piece (SPEC V279).
				local function rule(from, to, d)
					if to > from then ornMove(o, t, from, d); ornLine(o, t, to, d); end;
				end;

				if span - 2 * a < ORN_FLEUR then
					rule(a, span - a, i);
					rule(a + 7, span - a - 7, j);
					return;
				end;

				local c = span / 2;

				rule(a, c - 24, i);
				rule(c + 24, span - a, i);
				rule(a + 7, c - 24, j);
				rule(c + 24, span - a - 7, j);

				ornMove(o, t, c - 8, i);
				ornLine(o, t, c, i - 3.5);
				ornLine(o, t, c + 8, i);
				ornLine(o, t, c, i + 3.5);
				ornLine(o, t, c - 8, i);

				ornLeaf(o, t, c + 9, i, c + 17, i, 2.5);
				ornLeaf(o, t, c - 9, i, c - 17, i, 2.5);

				ornVolute(o, t, c + 20, i + 2.5, 3, -math.pi / 2, 1);
				ornVolute(o, t, c - 20, i + 2.5, 3, -math.pi / 2, -1);

				ornDot(o, t, c, j + 2, 1.3);
			end;

			-- The arm SHRINKS to fit; the ornament is never skipped (SPEC V279, B59). A corner
			-- overhangs its own arm by the terminal scroll - reach is a + 4 - so two of them need
			-- 2*(a+4) along the shorter side, and 5 buys that plus a pixel. ORN_ARM stays the
			-- ceiling: a big box is not drawn with a bigger corner than the one it was designed at.
			local function ornArm(w, h)
				return math.min(ORN_ARM, math.floor(math.min(w, h) / 2) - 5);
			end;

			local function ornFiligree(w, h)
				local o = {};
				local a = ornArm(w, h);

				-- The floor is the arc itself: below it there is no straight run for a rule to be a
				-- rule on. Nothing in the sheet reaches it - the shortest box is 76 and resolves to
				-- 33 - and the gate holds that gap open (SPEC V279).
				if a < 12 then return ""; end;

				ornCorner(o, {ox = 0, oy = 0, sx =  1, sy =  1}, a);
				ornCorner(o, {ox = w, oy = 0, sx = -1, sy =  1}, a);
				ornCorner(o, {ox = 0, oy = h, sx =  1, sy = -1}, a);
				ornCorner(o, {ox = w, oy = h, sx = -1, sy = -1}, a);

				ornEdge(o, {ox = 0, oy = 0, sx =  1, sy =  1}, w, a);
				ornEdge(o, {ox = 0, oy = h, sx =  1, sy = -1}, w, a);
				ornEdge(o, {ox = 0, oy = 0, sx =  1, sy =  1, swap = true}, h, a);
				ornEdge(o, {ox = w, oy = 0, sx = -1, sy =  1, swap = true}, h, a);

				return table.concat(o, " ");
			end;

			-- A Greek cross: two strokes of equal arm crossing on the rule. Drawn in canonical
			-- space like every other motif, so the same four stamps put it on all four corners
			-- without four hand-authored copies to drift apart (SPEC I87c).
			local function ornCross(o, t, u, v, r)
				ornMove(o, t, u - r, v);
				ornLine(o, t, u + r, v);
				ornMove(o, t, u, v - r);
				ornLine(o, t, u, v + r);
			end;

			-- Where the rule leaves the box's own concave arc, in from the corner along the edge.
			-- Same relation ornCorner uses, and it is the one ORN_CROSS_AT has to clear.
			local function ornFileteStraight()
				local r = ORN_BOXR + ORN_IN;

				return math.sqrt(r * r - ORN_IN * ORN_IN);
			end;

			-- One corner: the rule turning on the box's own arc, plus the minute cross on EACH of
			-- the two runs leaving it. Two per corner and not one - 26 measured on the DIAGONAL
			-- lands 18.4 deep, off the rule entirely, and the cross has to sit ON the line it marks.
			local function ornFileteCorner(o, t, uSpan, vSpan)
				local d  = ORN_IN;
				local r  = ORN_BOXR + d;
				local u0 = ornFileteStraight();
				local a1 = math.atan(d / u0);

				ornMove(o, t, d, u0);
				ornArc(o, t, r, (math.pi / 2) - a1, a1);

				-- Emitted only where the run can hold them, which is the refusal ornEdge already
				-- makes for its own motifs. What a small box drops is the CROSS, never the rule.
				if uSpan >= ORN_CROSS_ROOM then ornCross(o, t, ORN_CROSS_AT, d, ORN_CROSS); end;
				if vSpan >= ORN_CROSS_ROOM then ornCross(o, t, d, ORN_CROSS_AT, ORN_CROSS); end;
			end;

			-- One edge, arc end to arc end. `centre` is the top and the bottom only: the user chose
			-- the plate's reading, where the two SIDES stay clean (2026-08-26). ornEdge puts its
			-- centre motif on all four; this one does not, and that is a decision, not an omission.
			local function ornFileteEdge(o, t, span, centre)
				local u0 = ornFileteStraight();

				if span - 2 * u0 <= 0 then return; end;

				ornMove(o, t, u0, ORN_IN);
				ornLine(o, t, span - u0, ORN_IN);

				if centre and span >= ORN_CROSS_ROOM then
					ornCross(o, t, span / 2, ORN_IN, ORN_CROSS2);
				end;
			end;

			-- One unbroken rule: the four arcs and the four straight runs meet at the same u0, so
			-- what the eye gets is a single line all the way round. No size refusal of its own -
			-- what a small box loses is the cross (SPEC V314e); a guard that CANNOT fire is the
			-- hole B59 came through, and one that skips the rule is the hole it came through twice.
			local function ornFilete(w, h)
				local o = {};

				ornFileteCorner(o, {ox = 0, oy = 0, sx =  1, sy =  1}, w, h);
				ornFileteCorner(o, {ox = w, oy = 0, sx = -1, sy =  1}, w, h);
				ornFileteCorner(o, {ox = 0, oy = h, sx =  1, sy = -1}, w, h);
				ornFileteCorner(o, {ox = w, oy = h, sx = -1, sy = -1}, w, h);

				ornFileteEdge(o, {ox = 0, oy = 0, sx =  1, sy =  1}, w, true);
				ornFileteEdge(o, {ox = 0, oy = h, sx =  1, sy = -1}, w, true);
				ornFileteEdge(o, {ox = 0, oy = 0, sx =  1, sy =  1, swap = true}, h, false);
				ornFileteEdge(o, {ox = w, oy = 0, sx = -1, sy =  1, swap = true}, h, false);

				return table.concat(o, " ");
			end;

			-- Where the run meets the cut, in from the corner along the edge. The box corner here
			-- is a straight 45 degree BEVEL (SPEC I89a), not the concave arc ornFileteStraight
			-- measures: offsetting the cut inward by d moves it out along both edges by
			-- d * (sqrt(2) - 1), so the run stops at r + that and the cut it leaves behind is
			-- sqrt(2) * r - 2 * d * (sqrt(2) - 1) long - 18.0 for the 18/9 the sheet uses.
			--
			-- The radius is a PARAMETER and never a constant of this file: the 18 lives in the
			-- palette's boxCorner (SPEC I89a) and a second copy here is B69 all over again. It
			-- arrives from c.xradius, which is the era's radius by the time this runs only
			-- because applyTheme writes the corner BEFORE it calls ornament() in the same pass
			-- (SPEC I89c) - swap those two and this draws to the PREVIOUS era's corner, with
			-- rdk -l exiting 0 and nothing to grep (SPEC V317d).
			local function ornCorrenteRun(r)
				return r + ORN_IN * (math.sqrt(2) - 1);
			end;

			-- One corner: three links tiling the cut end to end. The run does not turn here - it
			-- STOPS, and the chain is what crosses (SPEC I90c). Endpoints come from dividing the
			-- cut in three, so the links touch without overlapping: that is the user's reading of
			-- the plate (2026-08-26), against the interlocked one where neighbours share a third.
			--
			-- ornLeaf is the link: two cubics closing a lens, bulge PERPENDICULAR to the line it
			-- spans. It is the filigree's own primitive and reusing it is the point - a second
			-- lens generator for this style is what V67 pays not to have.
			--
			-- No size refusal: the cut is sqrt(2)*r - 2*d*(sqrt(2)-1) whatever the box measures,
			-- so all twelve links are there on the 325x111 as much as on the 1410x574. A guard
			-- that cannot fire is the hole B59 came through (SPEC I90e).
			local function ornCorrenteCorner(o, t, r)
				local d  = ORN_IN;
				local u0 = ornCorrenteRun(r);
				local du = (u0 - d) / 3;

				for i = 0, 2, 1 do
					ornLeaf(o, t,
					        d + du * i,       u0 - du * i,
					        d + du * (i + 1), u0 - du * (i + 1),
					        ORN_LINK);
				end;
			end;

			-- One edge, and it is OPEN at both ends - the run is interrupted where the chain
			-- comes in, which is the whole of what the plate is called (SPEC I90c).
			local function ornCorrenteEdge(o, t, span, r)
				local u0 = ornCorrenteRun(r);

				ornMove(o, t, u0, ORN_IN);
				ornLine(o, t, span - u0, ORN_IN);
			end;

			-- Four open runs and twelve links: 16 subpaths, 24 cubics.
			local function ornCorrente(w, h, r)
				local o = {};

				ornCorrenteCorner(o, {ox = 0, oy = 0, sx =  1, sy =  1}, r);
				ornCorrenteCorner(o, {ox = w, oy = 0, sx = -1, sy =  1}, r);
				ornCorrenteCorner(o, {ox = 0, oy = h, sx =  1, sy = -1}, r);
				ornCorrenteCorner(o, {ox = w, oy = h, sx = -1, sy = -1}, r);

				ornCorrenteEdge(o, {ox = 0, oy = 0, sx =  1, sy =  1}, w, r);
				ornCorrenteEdge(o, {ox = 0, oy = h, sx =  1, sy = -1}, w, r);
				ornCorrenteEdge(o, {ox = 0, oy = 0, sx =  1, sy =  1, swap = true}, h, r);
				ornCorrenteEdge(o, {ox = w, oy = 0, sx = -1, sy =  1, swap = true}, h, r);

				return table.concat(o, " ");
			end;

			-- ONE generator, THREE families, and the PALETTE picks (SPEC I87b, I90b). An era that
			-- declares no style falls to the filigree, so nothing changes for the two that were
			-- here first. A second copy of ornament() per style is what V67 pays not to have with
			-- THEME_STROKE and V308 with the marker's three motifs; the price of getting it wrong
			-- here is 73 boxes wearing two frames at once, and no `rdk -l` that would say so.
			--
			-- `radius` is the box's own corner radius and only the chain reads it: the filigree
			-- and the filete are drawn to the CONCAVE ORN_BOXR, which V317b now solders to the
			-- radius the XML authors. The chain is drawn to the era's BEVEL, which lives in the
			-- palette, so it has to be handed in rather than looked up (SPEC V317d).
			-- ---- Classical Age corona muralis: the BOX frame (user 2026-08-27, plate `Corona Muralis`)
			--
			-- The FOURTH branch of ornPath, and the first that is not born of an era asking for a
			-- drawing - it is born of the era being EMPTY (SPEC C 122nd round, I94). Of the four
			-- palettes the Classical was the only one declaring no `ornament`, so V277 hid its path
			-- and its boxes have been bare outline for as long as the system has existed.
			--
			-- TWO things, and the order between them IS the hierarchy (SPEC I94c): one continuous
			-- RULE following the box own concave corner, and the MERLON course running between
			-- ORN_MUR_OUT and ORN_MUR_OUT + ORN_MUR_RISE - the crenellation of a city wall, which
			-- is what a mural crown is. The rule is what never drops; the merlon is what a box
			-- without room loses (SPEC V314e, V322c, B59).
			--
			-- NO radius parameter, and that is NOT style (SPEC I94b, V322b): the V317a check derives
			-- from the CODE which branch wants a cut corner, by reading which one carries ornPath
			-- radius. A third parameter here would make the gate DEMAND a boxCorner of the Classical
			-- palette - the corner it does not have and, by V317a, cannot have. It reads ORN_BOXR
			-- instead, exactly as ornFilete and ornFiligree do.
			--
			-- OWN constants, per STYLE, for the reason V308 gives per MOTIF (B69): ORN_OUT and
			-- ORN_IN (5 and 9) belong to the filigree and the filete, and one rule serving two
			-- drawings moves both when only one of them was asked for.
			--
			-- MEASURED before drawing (SPEC I94b): deepest ink is the rule on the corner diagonal at
			-- (ORN_BOXR + ORN_MUR_IN) / sqrt(2) = 20.5, against the 23 the filigree already spends,
			-- so this is SHALLOWER than the drawing that already exists and the 20px margin of I73 is
			-- not a new question. The merlon alone reaches 11.
			-- Four corners and four runs, stamped from ONE drawing each, exactly as the filigree and
			-- the filete are: four hand-authored copies are four things that drift apart.
			--
			-- THE WHOLE FAMILY LIVES IN HERE - the four constants and the three helpers - and that
			-- is a CEILING and not taste (SPEC B77, V325c). This chunk holds a measured 105 locals:
			-- the rdk compiler emits its own into it and Lua's limit of 200 is reached in there.
			-- The family cost the chunk SEVEN of those and nothing outside ever read one of them,
			-- so they come in here and the chunk gets seven back. What that buys is a build that
			-- still compiles: at 106 `rdk -l` exits 1 with an EMPTY output, names no file and no
			-- line, and DELETES the .rpk (B19) - which is the whole of why this move is worth a
			-- diff on a drawing nobody asked to change.
			--
			-- Reading only its own family gets STRONGER by it, not weaker (V322d, V308): from in
			-- here ORN_OUT and ORN_IN are still reachable and still unread, and ORN_MUR_* are now
			-- unreachable to everyone else by construction rather than by convention.
			local function ornCoronaMuralis(w, h)
				local ORN_MUR_OUT  = 6;    -- the merlon course, in from the box edge
				local ORN_MUR_IN   = 15;   -- the inner rule
				local ORN_MUR_STEP = 12;   -- one merlon plus one embrasure
				local ORN_MUR_RISE = 5;    -- how far the merlon stands above its course

				-- Where a run at depth d leaves the box own concave arc, in from the corner along the
				-- edge. Same relation ornFileteStraight measures, but taken at the depth ASKED for: the
				-- rule and the merlon course sit at different depths, so they leave the arc at different
				-- feet, and reading one foot for both would push the merlon into the curve.
				local function ornMuralFoot(d)
					local r = ORN_BOXR + d;

					return math.sqrt(r * r - d * d);
				end;

				-- One corner: the rule turning on the box own arc, and nothing else. The crown is spent on
				-- the RUNS - a merlon on the curve would have to shrink to ride it, and the whole reading
				-- of a wall is that every tooth is the same size.
				local function ornMuralCorner(o, t)
					local d  = ORN_MUR_IN;
					local r  = ORN_BOXR + d;
					local u0 = ornMuralFoot(d);
					local a1 = math.atan(d / u0);

					ornMove(o, t, d, u0);
					ornArc(o, t, r, (math.pi / 2) - a1, a1);
				end;

				-- One edge: the rule arc end to arc end, then the crenellation on its own shallower course.
				-- The rule is emitted FIRST and unconditionally, so by the time the merlon can refuse there
				-- is already ink on this edge - a box skipped in silence between ornamented neighbours is
				-- B59 in one line, and what a small box drops is the MERLON (SPEC V322c, V314e).
				local function ornMuralEdge(o, t, span)
					local u0 = ornMuralFoot(ORN_MUR_IN);

					if span - 2 * u0 <= 0 then return; end;

					ornMove(o, t, u0, ORN_MUR_IN);
					ornLine(o, t, span - u0, ORN_MUR_IN);

					-- The course is SHALLOWER than the rule, so it leaves the arc at its own foot.
					local m0  = ornMuralFoot(ORN_MUR_OUT);
					local run = span - 2 * m0;
					local n   = math.floor(run / ORN_MUR_STEP);

					if n < 1 then return; end;

					local half = ORN_MUR_STEP / 2;
					local lo   = ORN_MUR_OUT;
					local hi   = ORN_MUR_OUT + ORN_MUR_RISE;
					local u    = m0 + (run - n * ORN_MUR_STEP) / 2;

					ornMove(o, t, u, lo);

					for _ = 1, n, 1 do
						ornLine(o, t, u + half, lo);
						ornLine(o, t, u + half, hi);
						ornLine(o, t, u + ORN_MUR_STEP, hi);
						ornLine(o, t, u + ORN_MUR_STEP, lo);

						u = u + ORN_MUR_STEP;
					end;
				end;

				local o = {};

				ornMuralCorner(o, {ox = 0, oy = 0, sx =  1, sy =  1});
				ornMuralCorner(o, {ox = w, oy = 0, sx = -1, sy =  1});
				ornMuralCorner(o, {ox = 0, oy = h, sx =  1, sy = -1});
				ornMuralCorner(o, {ox = w, oy = h, sx = -1, sy = -1});

				ornMuralEdge(o, {ox = 0, oy = 0, sx =  1, sy =  1}, w);
				ornMuralEdge(o, {ox = 0, oy = h, sx =  1, sy = -1}, w);
				ornMuralEdge(o, {ox = 0, oy = 0, sx =  1, sy =  1, swap = true}, h);
				ornMuralEdge(o, {ox = w, oy = 0, sx = -1, sy =  1, swap = true}, h);

				return table.concat(o, " ");
			end;

			local function ornPath(w, h, style, radius)
				if style == "corrente" then return ornCorrente(w, h, radius); end;
				if style == "filete" then return ornFilete(w, h); end;
				if style == "corona-muralis" then return ornCoronaMuralis(w, h); end;

				return ornFiligree(w, h);
			end;
			-- The Dark Ages BAR drawing (SPEC I88c, I88e, I88f). The same shape of answer the
			-- box frame got in the 115th round: one hairline and the Greek cross, with the level
			-- said by how much of it is spent rather than by a motif nobody has seen before.
			local function markFilete(w, h, kind)
				-- Where a rule inset by d from the marker's foot dies in the concave corner:
				-- the offset INWARD rides the BIGGER circle, so the run stops where that arc
				-- gives out. It is the same measuring the box frame does, and it is what puts
				-- the two crosses on the ENDS of the rule instead of somewhere along it.
				local function foot(d)
					return math.sqrt((ORN_PILLR + d) * (ORN_PILLR + d) - d * d);
				end;

				-- One cross, centred, as two unfilled strokes. Every decimal through ornNum: a
				-- float verb follows LC_NUMERIC and a pt-BR host writes a COMMA, which splits
				-- each coordinate into two numbers and kills the whole path, silently (I72b).
				local function greek(x, y, a)
					return "M" .. ornNum(x - a) .. "," .. ornNum(y) ..
					       " L" .. ornNum(x + a) .. "," .. ornNum(y) ..
					       " M" .. ornNum(x) .. "," .. ornNum(y - a) ..
					       " L" .. ornNum(x) .. "," .. ornNum(y + a);
				end;

				-- The separator is the cross alone, centred in its 16x30 carrier, and it is
				-- SMALLER than the tab's by choice: the level that says least says it in less
				-- (SPEC I88f, V315d).
				if kind == "sep" then
					return greek(w / 2, h / 2, ORN_FIL_SEP);
				end;

				-- A sub-tab is the rule alone, at the height the user approved in the 109th
				-- round, and it now runs foot to foot instead of a proportional inset (SPEC
				-- I88e). A FIXED inset, so the widest two gain and the narrowest loses - which
				-- is the trade the user took when the plate replaced the short rule.
				if kind == "sub" then
					local i = foot(ORN_SUB_MARK);
					local y = h - ORN_SUB_MARK;

					if w - 2 * i <= 0 then return ""; end;

					return "M" .. ornNum(i) .. "," .. ornNum(y) ..
					       " L" .. ornNum(w - i) .. "," .. ornNum(y);
				end;

				-- The top bar: one rule foot to foot, and a cross marking each foot, which is
				-- what names the model. What falls out for want of room is the CROSS, never the
				-- rule (SPEC I88h, V279), so the two refusals are ORDERED - and neither can fire
				-- today, the narrowest of the nineteen being 79 against floors of 38.2 and 44.2.
				-- A guard that CANNOT fire is B59's hole, which is why the gate measures the
				-- narrowest button against the floor read from HERE rather than against a number
				-- of its own (SPEC V315e).
				local s = foot(ORN_FIL_MARK);
				local y = h - ORN_FIL_MARK;
				local o = {};

				if w - 2 * s <= 0 then return ""; end;

				o[#o + 1] = "M" .. ornNum(s) .. "," .. ornNum(y);
				o[#o + 1] = "L" .. ornNum(w - s) .. "," .. ornNum(y);

				if w - 2 * s > 2 * ORN_FIL_CROSS then
					o[#o + 1] = greek(s, y, ORN_FIL_CROSS);
					o[#o + 1] = greek(w - s, y, ORN_FIL_CROSS);
				end;

				return table.concat(o, " ");
			end;

			-- The Modern Nights BAR drawing (SPEC I91b, I91c, I91d). Two rules at every level,
			-- and a filled dot for the separator - the one place in the whole sheet where ink is
			-- FILLED rather than stroked.
			--
			-- It returns TWO values, and the second is the whole of how the fill is decided: the
			-- DRAWING says whether its own ink is filled and markRule only applies it. The other
			-- two styles return the path alone, so nil is their answer without a line of their
			-- own, and markRule spells no style and no motif of its own (SPEC I91e, V319e).
			local function markCorrente(w, h, kind)
				-- One horizontal run. Every decimal through ornNum: a float verb follows
				-- LC_NUMERIC and a pt-BR host writes a COMMA, which splits each coordinate into
				-- two numbers and kills the whole path, silently (I72b).
				local function rule(a, b, y)
					return "M" .. ornNum(a) .. "," .. ornNum(y) ..
					       " L" .. ornNum(b) .. "," .. ornNum(y);
				end;

				-- The separator: ONE dot, FILLED, centred in the 16x30 carrier (SPEC I78d, I91d)
				-- and the size of the chain link that crosses the box's bevel - by the
				-- RESEMBLANCE the user asked for, never by shared ownership: ORN_COR_DOT belongs
				-- to the bar painter, so moving ORN_LINK moves the boxes and leaves this alone.
				--
				-- Four cubics, because ORN_KAPPA is how a circle is written here and an SVG arc
				-- verb has no precedent anywhere in this sheet. ORN_KAPPA is the third DECLARED
				-- exception to V315b and the only one that is not a drawing choice: it is the
				-- constant of the arc itself, so it carries none of B69's risk.
				if kind == "sep" then
					local x, y = w / 2, h / 2;
					local r    = ORN_COR_DOT;
					local k    = ORN_KAPPA * r;

					return "M" .. ornNum(x + r) .. "," .. ornNum(y) ..
					       " C" .. ornNum(x + r) .. "," .. ornNum(y + k) .. " " .. ornNum(x + k) .. "," .. ornNum(y + r) .. " " .. ornNum(x) .. "," .. ornNum(y + r) ..
					       " C" .. ornNum(x - k) .. "," .. ornNum(y + r) .. " " .. ornNum(x - r) .. "," .. ornNum(y + k) .. " " .. ornNum(x - r) .. "," .. ornNum(y) ..
					       " C" .. ornNum(x - r) .. "," .. ornNum(y - k) .. " " .. ornNum(x - k) .. "," .. ornNum(y - r) .. " " .. ornNum(x) .. "," .. ornNum(y - r) ..
					       " C" .. ornNum(x + k) .. "," .. ornNum(y - r) .. " " .. ornNum(x + r) .. "," .. ornNum(y - k) .. " " .. ornNum(x + r) .. "," .. ornNum(y) .. " Z", true;
				end;

				-- A sub-tab: the main rule foot to foot, at the height the user approved in the
				-- 109th round (SPEC I80b, I91c), and a second rule NARROWER than the tab's. The
				-- foot is where a rule inset by d dies in the concave corner, which is the same
				-- measuring markFilete does - and the only number this style borrows from another
				-- (ORN_PILLR is the arc V228 authors, ORN_SUB_MARK the approved height).
				if kind == "sub" then
					local i = math.sqrt((ORN_PILLR + ORN_SUB_MARK) * (ORN_PILLR + ORN_SUB_MARK) - ORN_SUB_MARK * ORN_SUB_MARK);
					local s = w * ORN_COR_SUB_SPAN;

					if w - 2 * i <= 0 then return ""; end;

					return rule(i, w - i, h - ORN_SUB_MARK) .. " " ..
					       rule(s, w - s, h - ORN_COR_SUB2);
				end;

				-- The top bar: the main rule on a FIXED inset, longer than the sub-tab's, and a
				-- second rule wider than the sub-tab's. BOTH axes, because one alone leaves the
				-- two levels telling themselves apart by a single number (SPEC I91b, V319c).
				--
				-- The refusal is the MAIN rule's alone, and there is no order of falling to write
				-- here: the second rule is PROPORTIONAL, so it cannot run out of room. It cannot
				-- fire today either - the narrowest of the nineteen is 79 against a floor of 28 -
				-- and a guard that CANNOT fire is B59's hole, which is why the gate measures that
				-- width against the floor read from HERE rather than one spelled in the check
				-- (SPEC I91g, V319d, V314e).
				local s = w * ORN_COR_SPAN;

				if w - 2 * ORN_COR_IN <= 0 then return ""; end;

				return rule(ORN_COR_IN, w - ORN_COR_IN, h - ORN_COR_MARK) .. " " ..
				       rule(s, w - s, h - ORN_COR_MARK2);
			end;

			-- Two straight runs per long edge, and NOTHING on the short ones: there is no straight
			-- run there to be a rule on. A run is emitted only where it has positive length, the
			-- same refusal ornEdge makes, so a pill narrower than its own two corners simply gets
			-- less rule rather than a line drawn backwards across itself (SPEC V279, V282).
			-- One motif per level (SPEC I78b). kind comes from markKind, which reads the NAME and the
			-- bar the control sits in - construction the gate can see from disk, not a roster of 24.
			-- The Classical Age BAR drawing (SPEC I95b, I95c, I95d). Three motifs from one
			-- building: the COLUMN carries the level that names the page, and the GUTTA - the peg
			-- that hangs under a Doric triglyph - carries the two below it. Depth is not how this
			-- one says level: WIDTH is, above, and the gutta says it by hanging under the word.
			--
			-- The style keeps its name. `ornStyle` names the ERA and not the drawing - `filete`
			-- already names two drawings that look nothing alike (ornFilete is the box's fillet,
			-- markFilete is a rule and a Greek cross) - so renaming would cost the palette,
			-- ornPath, V322a and V322b to buy nothing (SPEC I95a).
			--
			-- THE EIGHT CONSTANTS LIVE IN HERE, and that is not taste (SPEC I95b, V325c, B77).
			-- This chunk holds a MEASURED ceiling of 105 locals - the rdk compiler emits its own
			-- into the same chunk and Lua's limit of 200 is reached in there - and the file
			-- already spends 97. Eight at chunk level plus this function is 106, and what that
			-- buys is `rdk -l` exiting 1 with an EMPTY output, no file named, and the .rpk
			-- DELETED (B19). Inside the function they cost the chunk one local instead of nine,
			-- and reading only its own family gets STRONGER rather than weaker: from in here
			-- nothing outside can reach them at all, which is what V308 buys by convention.
			local function markCoronaMuralis(w, h, kind)
				local ORN_COL_W     = 12;   -- motif `tab`: capital and base reach, each side
				local ORN_COL_SHAFT = 6;    -- motif `tab`: the shaft, what survives when room runs out
				local ORN_COL_CAP   = 4;    -- motif `tab`: height of capital and of base
				local ORN_COL_PAD   = 2;    -- motif `tab`: clear space at head and foot of the 30
				local ORN_COL_ROOM  = 44;   -- motif `tab`: the width the word itself asks for
				local ORN_GUT_STEP  = 14;   -- motif `sub`: one gutta to the next
				local ORN_GUT_W     = 2;    -- motif `sub`: width of one gutta
				local ORN_GUT_DROP  = 5;    -- motif `sub`: how far a gutta hangs below its rule

				-- Where a rule inset by d from the marker's foot dies in the concave corner. The
				-- carrier is still the pill V228 authors, so the run stops where that arc gives
				-- out - the same measure markFilete makes, and what puts the rule's ends under
				-- the word instead of somewhere past it.
				local function foot(d)
					return math.sqrt((ORN_PILLR + d) * (ORN_PILLR + d) - d * d);
				end;

				-- One filled peg, as a closed sub-path. Every decimal through ornNum: a float verb
				-- follows LC_NUMERIC and a pt-BR host writes a COMMA, which splits each coordinate
				-- into two numbers and kills the whole path, silently (I72b).
				local function gutta(cx, y0, y1)
					local a = ORN_GUT_W / 2;

					return "M" .. ornNum(cx - a) .. "," .. ornNum(y0) ..
					       " L" .. ornNum(cx + a) .. "," .. ornNum(y0) ..
					       " L" .. ornNum(cx + a) .. "," .. ornNum(y1) ..
					       " L" .. ornNum(cx - a) .. "," .. ornNum(y1) .. " Z";
				end;

				-- The separator is ONE gutta, alone, centred in its 16x30 carrier (SPEC I95d): the
				-- level that says least says it in less, exactly as the Dark Ages cross does
				-- (I88f), and it is the sub-tab's OWN ink rather than a third vocabulary. FILLED,
				-- like the guttae it is one of - which is what the second return value says.
				if kind == "sep" then
					local cy = h / 2;

					return gutta(w / 2, cy - ORN_GUT_DROP / 2, cy + ORN_GUT_DROP / 2), true;
				end;

				-- A sub-tab is the rule at the height the user approved in the 109th round, with
				-- the guttae hanging from it at a FIXED step - a frieze's peg spacing does not
				-- stretch with the panel, so the COUNT changes and the step does not.
				--
				-- The rule is emitted FIRST and unconditionally: what falls out for want of room
				-- is the GUTTA, never the rule (SPEC I95c, V314e). A sub-tab skipped in silence
				-- between ornamented neighbours is B59 in one line.
				if kind == "sub" then
					local i = foot(ORN_SUB_MARK);
					local y = h - ORN_SUB_MARK;

					if w - 2 * i <= 0 then return ""; end;

					local o = { "M" .. ornNum(i) .. "," .. ornNum(y) ..
					            " L" .. ornNum(w - i) .. "," .. ornNum(y) };
					local n = math.floor((w - 2 * i) / ORN_GUT_STEP);

					-- Centred as a GROUP, so the pegs sit under the word instead of drifting to
					-- one end as the sub-tab gets wider.
					if n >= 1 then
						local x0 = (w - (n - 1) * ORN_GUT_STEP) / 2;

						for k = 1, n, 1 do
							o[#o + 1] = gutta(x0 + (k - 1) * ORN_GUT_STEP, y, y + ORN_GUT_DROP);
						end;
					end;

					return table.concat(o, " "), true;
				end;

				-- The top bar: a Tuscan column at each edge - capital, shaft, base - and the word
				-- read as the intercolumniation. TRACED and not filled, which is the whole of why
				-- there is no second return value here: markRule paints `color` from the drawing's
				-- own answer, and a filled column is a block of gold where a pair of columns
				-- should be (SPEC I95e, V323c).
				--
				-- What falls out for want of room is the CAPITAL and the BASE, and what survives
				-- is the SHAFT - two levels of degradation, and no marker that ever vanishes (SPEC
				-- I95c). Neither refusal can fire today: the narrowest of the eleven is 79 against
				-- floors of 68 and 56.
				local o    = {};
				local y0   = ORN_COL_PAD;
				local y1   = h - ORN_COL_PAD;
				local wide = w - 2 * ORN_COL_W >= ORN_COL_ROOM;
				local reach;

				if wide then
					reach = ORN_COL_W;
				else
					if w - 2 * ORN_COL_SHAFT < ORN_COL_ROOM then return ""; end;

					reach = ORN_COL_SHAFT;
				end;

				-- Drawn ONCE and stamped twice, mirrored by `s`: one drawing, so the two columns
				-- cannot drift apart - the same reason ornCorner is authored in canonical space.
				local function column(cx, s)
					local half = ORN_COL_SHAFT / 2;
					local a    = cx - s * reach / 2;
					local b    = cx + s * reach / 2;

					if wide then
						o[#o + 1] = "M" .. ornNum(a) .. "," .. ornNum(y0) ..
						            " L" .. ornNum(b) .. "," .. ornNum(y0) ..
						            " M" .. ornNum(a) .. "," .. ornNum(y0 + ORN_COL_CAP) ..
						            " L" .. ornNum(b) .. "," .. ornNum(y0 + ORN_COL_CAP) ..
						            " M" .. ornNum(a) .. "," .. ornNum(y1 - ORN_COL_CAP) ..
						            " L" .. ornNum(b) .. "," .. ornNum(y1 - ORN_COL_CAP) ..
						            " M" .. ornNum(a) .. "," .. ornNum(y1) ..
						            " L" .. ornNum(b) .. "," .. ornNum(y1);
					end;

					o[#o + 1] = "M" .. ornNum(cx - half) .. "," .. ornNum(y0 + ORN_COL_CAP) ..
					            " L" .. ornNum(cx - half) .. "," .. ornNum(y1 - ORN_COL_CAP) ..
					            " M" .. ornNum(cx + half) .. "," .. ornNum(y0 + ORN_COL_CAP) ..
					            " L" .. ornNum(cx + half) .. "," .. ornNum(y1 - ORN_COL_CAP);
				end;

				column(reach, 1);
				column(w - reach, -1);

				return table.concat(o, " ");
			end;

			-- The era's own BAR drawing, picked by the palette exactly as the box frame is (SPEC
			-- I88a). The style arrives as an ARGUMENT and is never read as an upvalue: this
			-- function is declared ABOVE the local that holds the era's style, so reading it
			-- from here compiles to a GETGLOBAL and finds nil, with no error and nothing to
			-- grep (SPEC V223, B51). An era declaring no style falls to the drawing below.
			local function markPath(w, h, kind, style)
				if style == "filete" then return markFilete(w, h, kind); end;
				if style == "corrente" then return markCorrente(w, h, kind); end;
				if style == "corona-muralis" then return markCoronaMuralis(w, h, kind); end;

				local o  = {};
				local cx = w / 2;
				local cy = h / 2;

				-- The separator is the fleuron alone, centred in its 16x30 carrier (SPEC I78d).
				if kind == "sep" then
					o[#o + 1] = "M" .. ornNum(cx) .. "," .. ornNum(cy - ORN_SEP_RY);
					o[#o + 1] = "L" .. ornNum(cx + ORN_SEP_RX) .. "," .. ornNum(cy);
					o[#o + 1] = "L" .. ornNum(cx) .. "," .. ornNum(cy + ORN_SEP_RY);
					o[#o + 1] = "L" .. ornNum(cx - ORN_SEP_RX) .. "," .. ornNum(cy);
					o[#o + 1] = "Z";

					return table.concat(o, " ");
				end;

				-- A sub-tab is marked by ONE short rule (SPEC I78b): the level below says less, and it says
				-- it in less width. Proportional and not a literal inset - the eight sub-tabs run from 90 to
				-- 235 wide and a fixed inset would swallow the narrow ones.
				if kind == "sub" then
					local i = w * ORN_SUB;

					if w - 2 * i <= 0 then return ""; end;

					o[#o + 1] = "M" .. ornNum(i) .. "," .. ornNum(h - ORN_SUB_MARK);
					o[#o + 1] = "L" .. ornNum(w - i) .. "," .. ornNum(h - ORN_SUB_MARK);

					return table.concat(o, " ");
				end;

				-- The top bar: two rules, the lower one opened in the middle for the fleuron.
				local s  = math.sqrt((ORN_PILLR + ORN_MARK) * (ORN_PILLR + ORN_MARK) - ORN_MARK * ORN_MARK);
				local y1 = h - ORN_MARK;
				local y2 = h - ORN_MARK2;
				local g  = ORN_MARK_RX + ORN_MARK_GAP;

				-- No room for both halves of the lower rule: the marker draws nothing rather than a fleuron
				-- sitting on a rule drawn end-before-start. The narrowest button on the top bar is 79 against
				-- a half of 39.5, so this cannot fire today - and one that CANNOT fire is B59's hole (V279).
				if cx - g <= s then return ""; end;

				o[#o + 1] = "M" .. ornNum(s) .. "," .. ornNum(y2);
				o[#o + 1] = "L" .. ornNum(w - s) .. "," .. ornNum(y2);

				o[#o + 1] = "M" .. ornNum(s) .. "," .. ornNum(y1);
				o[#o + 1] = "L" .. ornNum(cx - g) .. "," .. ornNum(y1);
				o[#o + 1] = "M" .. ornNum(cx + g) .. "," .. ornNum(y1);
				o[#o + 1] = "L" .. ornNum(w - s) .. "," .. ornNum(y1);

				-- Line work, unfilled, like everything else here.
				o[#o + 1] = "M" .. ornNum(cx) .. "," .. ornNum(y1 - ORN_MARK_RY);
				o[#o + 1] = "L" .. ornNum(cx + ORN_MARK_RX) .. "," .. ornNum(y1);
				o[#o + 1] = "L" .. ornNum(cx) .. "," .. ornNum(y1 + ORN_MARK_RY);
				o[#o + 1] = "L" .. ornNum(cx - ORN_MARK_RX) .. "," .. ornNum(y1);
				o[#o + 1] = "Z";

				return table.concat(o, " ");
			end;

			-- One <path> per box, made the first time an era asks for it and hidden - never destroyed
			-- - when a plainer era takes over. An era that declares no `ornament` gets none, exactly
			-- as a palette with no `paper` gets no backdrop (V56).
			-- The entry is {p, w, h} and not the path alone: the memo has to tell "already drawn"
			-- from "drawn at THIS size". The HEALTH box is the one section box that resizes at
			-- runtime - renderHealthTrack writes its height from the storyteller's track length
			-- (SPEC V49) - and a memo that only knew the first would keep serving a frame built
			-- for the old measure, with no error and no symptom to grep (SPEC I72d, V284).
			local ornPainted = {};

			-- The era's ornament colour, kept from the last applyTheme so a refresh outside the
			-- traversal does not have to resolve the palette a second time. nil is a real value
			-- here: it is what a plainer era leaves behind, and it hides rather than repaints.
			local ornColour = nil;

			-- The era's DRAWING, kept beside its colour and for the same reason (SPEC I87e):
			-- refreshOrnament runs OUTSIDE the theme traversal and has no palette in hand. Written
			-- from the same `t` the colour is, so which frame the memo believes in and which era
			-- the boxes are wearing can never be two different answers. nil is a real value here -
			-- it is what every palette but the Dark Ages one leaves behind, and it means the
			-- filigree, not "no frame": that question is ornColour's and stays ornColour's.
			--
			-- NOT a sixth parameter on ornament(). V285c counts that signature and demands the
			-- refresh branch use the fourth and fifth by name; a style riding in beside them would
			-- be one more thing the refresh path has to be handed and could silently drop.
			local ornStyleNow = nil;

			-- WHO is a section box, decided by CONSTRUCTION rather than by a roster of names
			-- (SPEC V278): authored black fill PLUS a corner radius of its own. That is what
			-- tells the 73 from the tab-strip floor (black and SQUARE, V229), the 19 pills
			-- (DimGray, and their width is priced for the concave arc, V228), the mark boxes
			-- and the avatar frame.
			--
			-- The fill is the AUTHORED colour and not the painted one: by the time this runs
			-- the box is already mahogany (SPEC V62), so reading the current colour would
			-- match nothing.
			--
			-- Lifted out of ornament() in the 117th round so the frame and the CORNER ask the
			-- same question in ONE place (SPEC I89b, V316d). A second copy of "which
			-- rectangles are the boxes" is what V67 pays not to have, and the cost of getting
			-- it wrong here is the 19 pills beveled with a width priced for the arc.
			--
			-- Declared ABOVE both of its callers on purpose: reached from above it would
			-- compile to a GETGLOBAL and answer nil, silently (SPEC V223, B51).
			-- TWO answers and ONE question (SPEC I92b, V320c): the FIRST is who dresses in the era's
			-- SHAPE - the 73 plus BOTH of the avatar's rectangles - and the SECOND is who receives
			-- the era's DRAWING - the 73 plus the carrier alone. A second copy of which rectangles
			-- are the boxes is what V67 pays not to have, and the pair is the shape markPath already
			-- returns as d, f (SPEC V319e).
			--
			-- The avatar arm is a DECLARED ROSTER of two names and cannot be anything else (SPEC
			-- I92a, V320b): by CONSTRUCTION ornAvatar IS the nineteen tabOn<X> carriers - transparent
			-- both ways, its own radius, hitTest false - so a fill-based arm would bevel the pills,
			-- whose width is priced for the concave arc (V228, V316d). The frame wears and does not
			-- draw: under the image its path lands behind the photo, which is B75 (SPEC I92c).
			local function sectionBox(c, fill)
				local nm = c:getName();

				if nm == "ornAvatar" then return true, false; end;
				if nm == "avatarFrame" then return true, false; end;

				if normColor(fill) ~= "#FF000000" then return; end;

				local rad = c.xradius;

				if rad == nil or rad <= 0 then return; end;

				return true, true;
			end;

			-- `w` and `h` are the caller's measurement and they are OPTIONAL. A caller that has
			-- just written the size passes it; the theme traversal, which writes nothing, leaves
			-- them out and the control is read instead (SPEC I72e, V285c).
			local function ornament(c, fill, colour, w, h)
				local e = ornPainted[c.handle];

				if colour == nil then
					if e ~= nil then e.p.visible = false; end;
					return;
				end;

				if e ~= nil then
					-- The box changed size since the data was built. Rebuilding beats stretching:
					-- `mode` stays "original" because the SDK's stretch would scale the volutes and
					-- beads with the box, and the HEALTH box moves on ONE axis only - the motif
					-- would flatten by about a quarter (SPEC R113).
					--
					-- The HANDED-OVER measurement wins over the control's own. renderHealthTrack
					-- has just written the height, and `getHeight` is _gui_getHeight rather than the
					-- plain property getter `getWidth` uses (rrpgGUI.lua:95, :98) - reading it back
					-- in the same tick can answer with the size the box is LEAVING, which compares
					-- equal and skips the redraw in silence. That was B62 (SPEC V285c).
					local bw = w or c.width;
					local bh = h or c.height;

					--
					-- The THIRD thing the stamp has to carry is the DRAWING (SPEC I87d, V313c).
					-- Switching era on an open sheet moves not one pixel of any box, so the size
					-- comparison above answers "same" and the memo hands back the frame it built
					-- for the era before - the Victorian filigree, repainted silver, on all 73.
					-- rdk -l exits 0, the gate stays green and the defect exists only on screen:
					-- B58 and B62 on a third axis, where the memo knew "already drawn" and "drawn
					-- at THIS size" and had no way to know "drawn in THIS drawing".
					if bw ~= nil and bh ~= nil and (bw ~= e.w or bh ~= e.h or ornStyleNow ~= e.s) then
						local d = ornPath(bw, bh, ornStyleNow, c.xradius);

						if d ~= "" then
							e.p.data = d;
							e.w = bw;
							e.h = bh;
							e.s = ornStyleNow;
						end;
					end;
				end;

				if e == nil then
					-- Section boxes AND the avatar's carrier, and the question is still asked in ONE place:
					-- the corner of I89 reads the FIRST answer, this reads the SECOND (SPEC I92b, V316d,
					-- V320c). The frame wears the era's corner and draws NOTHING - it sits under the image,
					-- so a path hung on it would land behind the photo, which is B75 in one line.
					local _, draws = sectionBox(c, fill);

					if not draws then return; end;

					-- READ, never written - the theme still writes no geometry (V57). A box whose size
					-- the layout has not resolved gets no ornament rather than a frame drawn to a wrong
					-- measure. Size no longer decides WHETHER, only how big the corner comes out.
					local bw, bh = c.width, c.height;

					if bw == nil or bh == nil then return; end;

					-- The ONLY refusal left is a box too small for the arc to straighten out - no box
					-- in the sheet is (SPEC V279). The old guard refused anything under 2*ORN_ARM and
					-- TRUE FAITH, 1270 wide and 76 tall, fell through it silently (SPEC B59).
					local d = ornPath(bw, bh, ornStyleNow, c.xradius);

					if d == "" then return; end;

					local p = gui.newPath();

					-- Child of the LAYOUT holding the box, not of the box itself (SPEC I72c, V283a).
					-- A child draws above its parent and below the parent's LATER siblings, so a path
					-- parented to the rectangle sat under every label and field the box carries - the
					-- user reported exactly that: the boxes you type in were covering the filigree.
					-- Created here, after the authored children already exist, it is the last sibling
					-- and draws over all of them. There is no z-order API to do this instead: bringToFront,
					-- sendToBack and zorder are 0 hits across SDK3 (SPEC R112), so creation order IS the
					-- mechanism. Do NOT "re-raise" with p:setParent(p:getParent()) - setParent returns
					-- early when the parent is unchanged (rrpgObjs.lua:637), so it compiles, runs, exits
					-- 0 and does nothing (SPEC V283b).
					--
					-- Safe only because hitTest stays false below (SPEC V283c): over the fields, but it
					-- never eats a click. And it needs the 20px margin of I73 under it (SPEC V283d) -
					-- at 10px the 5/9px rules would cross the full-width children of 68 of the 73 boxes.
					p:setParent(c.parent);

					p.align = "client";
					p.mode = "original";
					p.hitTest = false;
					p.color = "#00000000";
					p.strokeSize = 1;
					p.data = d;

					e = {p = p, w = bw, h = bh, s = ornStyleNow};

					ornPainted[c.handle] = e;
				end;

				e.p.strokeColor = colour;
				e.p.visible = true;
			end;

			-- The MARKER's line work (SPEC I78, V306). Same contract as ornament(): created once, HIDDEN
			-- by nothing here and never destroyed (SPEC V277).
			--
			-- Who gets one is the NAME and the BAR, not a transparent fill plus a radius. That filter
			-- died with the box: since I77a the button is transparent and carries the same radius as the
			-- marker, so construction alone stopped telling the pair apart. 	abOn and sep are FAMILY
			-- prefixes - the same idiom note<X> and lbl<X> already use - and the parent's name picks the
			-- level between the two 	abOn motifs. One name read, not a roster of 24.
			--
			-- Parented to the CARRIER, which is what makes the open tab need no state of its own: a
			-- child of something invisible does not paint, and applyTabVisibility and renderSubTabs
			-- already write that visible. The separator's carrier never hides, so its fleuron stands.
			local markPainted = {};

			local function markKind(c, nm)
				if nm == nil then return nil; end;
				if string.sub(nm, 1, 3) == "sep" then return "sep"; end;
				if string.sub(nm, 1, 5) ~= "tabOn" then return nil; end;

				local p = c.parent;

				if p ~= nil and p.name == "tabStrip" then return "tab"; end;

				return "sub";
			end;

			local function markRule(c, nm, colour)
				local e = markPainted[c.handle];

				if colour == nil then
					if e ~= nil then e.p.visible = false; end;
					return;
				end;

				if e == nil then
					local kind = markKind(c, nm);

					if kind == nil then return; end;

					-- READ, never written - the theme still writes no geometry (SPEC V57).
					local bw, bh = c.width, c.height;

					if bw == nil or bh == nil then return; end;

					local d, f = markPath(bw, bh, kind, ornStyleNow);

					if d == "" then return; end;

					local p = gui.newPath();

					p:setParent(c);

					p.align = "client";
					p.mode = "original";
					p.hitTest = false;
					-- `color` is NOT nailed shut here any more: the fill changes with the era exactly
					-- as the drawing does, so it is written on every repaint below (SPEC I91f). Nailed
					-- here it would survive a swap on an OPEN sheet and leave the Dark Ages cross
					-- FILLED - rdk -l exit 0, gate green, and only the screen left to tell (B58, B62).
					p.strokeSize = 1;
					p.data = d;

					-- The entry is {p, k, f, s} and not the path alone. The nineteen markers never
					-- change size, so measure is not what this memo has to tell apart - the
					-- DRAWING is. `k` is the kind already resolved, so a restyle does not go
					-- back to the parent to ask which level this is (SPEC I88g, V315f).
					-- `s` stays LAST in the entry on purpose: the gate tells this CREATION stamp from
					-- the rewrite below by the brace that closes right after it (V315f), and its first
					-- draft went green with the stamp deleted for want of exactly that (B7).
					e = {p = p, k = kind, f = f, s = ornStyleNow};

					markPainted[c.handle] = e;
				elseif e.s ~= ornStyleNow then
					-- The era changed under an OPEN sheet. Without this the bar would wear the
					-- PREVIOUS era's drawing repainted in the new colour: nothing here resizes,
					-- so nothing else would ever ask for the path to be rebuilt - exit 0, gate
					-- green, and the defect only on the screen. It is the hole the box memo had
					-- to close one round earlier, on a memo that at least carried a measure
					-- (SPEC I88g, V315f, B58, B62).
					local d, f = markPath(c.width, c.height, e.k, ornStyleNow);

					-- An empty path means no room, and the answer to that is to keep what is
					-- there rather than blank the marker - and to leave `s` alone, so the next
					-- repaint tries again instead of believing the new style was drawn.
					if d ~= "" then
						e.p.data = d;
						e.f = f;
						e.s = ornStyleNow;
					end;
				end;

				-- The FILL, written on EVERY repaint and not once at creation: the dot is filled in
				-- this era and the cross is not in the next (SPEC I91f). The answer comes from the
				-- DRAWING - markRule spells no style and no motif of its own (SPEC I91e, V319e).
				if e.f then e.p.color = colour; else e.p.color = "#00000000"; end;

				e.p.strokeColor = colour;
				e.p.visible = true;
			end;

			-- SPEC I72d / V284. The HEALTH box is resized by renderHealthTrack, which lives on the
			-- root form and has no reach into this chunk's locals - so the refresh is a global, the
			-- same way renderHedgePickers and renderManualEntry already are. Declared BELOW
			-- ornament() because it calls it: the other order compiles to a GETGLOBAL and finds nil
			-- (SPEC V223, B51).
			--
			-- Takes the BOX and finds its own backdrop rather than taking the rectangle, because the
			-- caller holds the layout - `form[prefix .. "box"]` - and nothing else. The backdrop is
			-- the align="client" child, which is how V68 and V278 already tell a section box from
			-- everything else that is black.
			function refreshOrnament(box, w, h)
				if box == nil then return; end;

				local kids = box:getChildren();

				for i = 1, #kids, 1 do
					local k = kids[i];

					-- Found by MEMO, never by reading a property off the control (SPEC V285a).
					-- The first version asked `k.align == "client"`, and `align` had ZERO precedent
					-- as a runtime READ anywhere in the sheet: getClassName is proven by the theme
					-- walk that paints every round, align was proven by nothing. A finder that
					-- matches nothing returns quietly and exits 0 - that was half of B62.
					--
					-- It also sidesteps the order: getChildren walks pairs() of a hash table
					-- (rrpgObjs.lua:577), so which child comes first is undefined.
					--
					-- `fill` goes in as nil on purpose: the memo EXISTS by the test just made, so
					-- the creation branch cannot run and the authored colour is never consulted.
					-- Reading it here would be one more property off the control for nothing.
					if ornPainted[k.handle] ~= nil then
						ornament(k, nil, ornColour, w, h);
						return;
					end;
				end;
			end;

			local function applyTheme(v, from)
				-- Every value the combo offers has a palette since the 16th round, so this never
				-- resolves to nil: a sheet carrying something else - "Present Day" from before
				-- the rename, or plain rubbish - lands on the default rather than on an
				-- unpainted sheet (SPEC V52).
				local t = THEMES[v] or THEMES[THEME_DEFAULT];
				local root = rootOf(from);
				local all = {root};

				-- Kept for refreshOrnament, which runs outside this traversal (SPEC I72d, V284).
				-- Written from the SAME `t` the walk below paints from, so the era the filigree
				-- believes in can never differ from the era the boxes are wearing.
				ornColour = t.ornament;
				ornStyleNow = t.ornStyle;

				-- The bar's accent, read ONCE for the whole repaint (SPEC V205). It is the stroke key the
				-- markers and every framed box already share, so the bar cannot drift from the sheet - and
				-- it exists in all FOUR palettes, which t.ornament does not (SPEC I78e, V304b).
				local accent = t.stroke[normColor("#FFFFFF")];

				collect(root, all);

				-- Once for the whole repaint, not once per picker (SPEC V205).
				local levels = discLevels();

				for i = 1, #all, 1 do
					local c = all[i];
					local cls = c:getClassName();
					local nm = c:getName();

					-- The backdrop exists only for the theme, so it is deliberately OUTSIDE the
					-- ledger: its authored state is "no image, hidden". Matched by PREFIX, like
					-- the `dyn` and `cbo` conventions above, because a control `name` is global
					-- across the sheet's .lfm files - eight tabs sharing one "themePaper" made
					-- the rdk exit 1 with no message at all and delete the .rpk (SPEC B19 / V59).
					if cls == "image" and nm ~= nil and string.sub(nm, 1, 10) == "themePaper" then
						-- An ornament that is not there degrades to no ornament, never to a
						-- half-painted sheet (SPEC V56).
						if t.paper == nil then
							if c.visible then c.visible = false; end;
						else
							c.src = t.paper;
							c.visible = true;
						end;
					elseif cls == "form" then
						paint(c, "theme", t.form, authored(c, "theme"));
					elseif THEME_SHAPES[cls] then
						local fill = authored(c, "color");
						local line = authored(c, "strokeColor");

						paint(c, "color", t.fill[normColor(fill)], fill);
						paint(c, "strokeColor", t.stroke[normColor(line)], line);
						paint(c, "strokeSize", THEME_STROKE, authored(c, "strokeSize"));

						-- The CORNER, and only on the 73 that the SAME selector the ornament uses
						-- says yes to (SPEC I89b, V316d). Without sectionBox this branch runs on
						-- EVERY rectangle the sheet has and would bevel the 19 tab pills along
						-- with the boxes - and their width is priced for the concave arc (V228).
						if sectionBox(c, fill) then
							local bc = t.boxCorner;
							local ct = authored(c, "cornerType");
							local rx = authored(c, "xradius");
							local ry = authored(c, "yradius");

							-- The palette's value OR THE AUTHORED ONE, and that `or` is the whole
							-- way back out (SPEC V316c). paint() returns early on a nil value
							-- (V61), so writing t.boxCorner alone would leave all 73 beveled
							-- FOREVER once Modern Nights had been on: rdk -l exits 0, the gate
							-- stays green and the defect exists only on screen - B58 and B62 on a
							-- fourth axis.
							--
							-- Writing the authored value back is safe HERE and is not B21: that
							-- hazard is the FONT setters, which run _gui_prepareForFontColorChange
							-- and detach the control from the form's theme BEFORE they write. A
							-- geometry setter has no such step.
							--
							-- Before ornament() below, so the box's own shape is settled before
							-- anything measures it.
							paint(c, "cornerType", (bc ~= nil and bc.type) or ct, ct);
							paint(c, "xradius", (bc ~= nil and bc.radius) or rx, rx);
							paint(c, "yradius", (bc ~= nil and bc.radius) or ry, ry);
						end;

						-- The filigree rides the same walk and the same authored value the fill does,
						-- so the frame and the box can never disagree about which era is in force.
						ornament(c, fill, t.ornament);
						markRule(c, nm, accent);
					elseif THEME_TEXTS[cls] then
						local fc = authored(c, "fontColor");

						paint(c, "fontColor", t.font[normColor(fc)], fc);

						-- Only where the control reports a real family. What the getter returns
						-- for a control that never authored a font is unknown (SPEC R27), and a
						-- font property cannot be un-written - the setter detaches it from the
						-- theme for good. If it reports nothing usable, that control keeps its
						-- font and the serif simply does not reach it.
						local ff = authored(c, "fontFamily");

						if type(ff) == "string" and ff ~= "" then
							paint(c, "fontFamily", t.fontFamily, ff);
						end;

						-- The era renames what a picker SHOWS, never what it stores (SPEC I22,
						-- V194). It rides the repaint's own traversal rather than a dataLink of
						-- its own, so the words and the palette can never disagree about which
						-- era is in force (SPEC T469). `v` and not currentTheme(): this walk is
						-- the one being asked for, and an unknown value renames nothing, which
						-- is the same fallback the palette takes above.
						if cls == "comboBox" then
							pickerItems(c, (sheet ~= nil and sheet.language) or "en", v, levels);
						end;
					elseif cls == "imageCheckBox" then
						paint(c, "checkedImage", t.dotOn, authored(c, "checkedImage"));
						paint(c, "uncheckedImage", t.dotOff, authored(c, "uncheckedImage"));
					elseif cls == "image" then
						-- The fixed first dot (SPEC B22 / V65). Keyed on the authored art, exactly
						-- like the colour maps: an <image> showing the base dot follows the same
						-- palette entry the ticked boxes do. The avatar authors no src at all and
						-- falls through untouched - it is the player's picture, not theme art.
						local art = normPath(authored(c, "src"));

						if art == DOT_ON then
							paint(c, "src", t.dotOn, authored(c, "src"));
						elseif art == DOT_OFF then
							paint(c, "src", t.dotOff, authored(c, "src"));
						end;
					end;
				end;
			end;
		]]>
	</script>
	<scrollBox align="client">
		<!--
			Settings tab (ex-Credits, SPEC T73/T74). The sponsor image that used to fill the
			right-hand column is gone for good, so both boxes sit at x=0.

			Options first, credits last (SPEC T141): the settings are what a player opens this
			tab to change; the credits are a signature.
		-->
		<layout left="0" top="0" width="420" height="145">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>

			<label left="20" top="20" width="80" height="20" text="Language" horzTextAlign="center"/>
			<comboBox left="100" top="20" width="300" height="25" field="language" fontColor="white" horzTextAlign="center" items="{'English', 'Português BR'}" values="{'en', 'pt'}"/>
			<dataLink field="language" defaultValue="en">
				<event name="onChange">
					if sheet == nil then return end;
					applyLanguage(sheet.language or "en", self);
					renderAbilityLabels(sheet.language or "en", self);
				</event>
			</dataLink>

			<!-- `Game` says what the table is playing (SPEC C, T75). Nothing reads it - no
			     content is filtered by it, on purpose. Named cbo* so the language switch
			     translates the shown items while `values` stay English (SPEC V24).

			     Three games since the 32nd round, and the box is NOT editable: the value is
			     information, not a choice (SPEC V109). No empty row goes with that - a locked
			     combo carrying a default has nothing to clear - which is the same declared
			     exception to V15 that cboSheetTheme carries. A sheet holding one of the four
			     older, longer names is normalised on load (SPEC V110), because a locked box
			     showing a dead value is one nobody could fix. -->
			<label left="20" top="60" width="80" height="20" text="Game" horzTextAlign="center"/>
			<comboBox left="100" top="60" width="300" height="25" name="cboGame" field="game" enabled="false" fontColor="white" horzTextAlign="center" items="{'Vampire', 'Mortal', 'Mage'}" values="{'Vampire', 'Mortal', 'Mage'}">
			</comboBox>
			<dataLink field="game" defaultValue="Mortal"/>

			<!--
				`Theme` is the era the table plays in and, like `Game`, only stores state today
				(SPEC C, T141). The field is `sheetTheme`, NOT `theme`: sheets saved from the Mage
				plugin still carry theme="Dark", and reusing the name would put that value in a
				combo that never offered it.

				Named cbo* ON PURPOSE: only those combos get their `items` rebuilt when the
				language changes, and without the prefix a [pt] sheet would still read
				"Dark Ages" instead of "Idade das Trevas". `values` stay canonical English
				(SPEC V24). It is the
				one declared exception to V15 - a state combo with a real default has no empty
				first row to clear.

				As of the 14th round this combo PAINTS (SPEC I5/I6): the four values are the
				keys the palette table is looked up by, so changing this list means changing
				THEMES and defaultValue in the same commit (SPEC V12).

				The 16th round dropped the palette-less baseline that used to be called `Modern`
				and gave the name to the contemporary palette. Every value paints now, so there
				is no way back to the sheet as the XML authors it (SPEC C, 16th round).
			-->
			<label left="20" top="100" width="80" height="20" text="Theme" horzTextAlign="center"/>
			<comboBox name="cboSheetTheme" left="100" top="100" width="300" height="25" field="sheetTheme" fontColor="white" horzTextAlign="center" items="{'Modern Nights', 'Victorian Era', 'Dark Ages', 'Classical Age'}" values="{'Modern Nights', 'Victorian Era', 'Dark Ages', 'Classical Age'}"/>
			<dataLink field="sheetTheme" defaultValue="Modern Nights">
				<event name="onChange">
					if sheet == nil then return end;
					applyTheme(sheet.sheetTheme or THEME_DEFAULT, self);
					renderAbilityLabels(sheet.language or "en", self);

					-- Last paint of the load, so the sheet is safe to show (SPEC I15, V167).
					-- It lives at the END of this handler on purpose: everything above it is
					-- what the player would otherwise have watched being applied (SPEC B40).
					sheetReveal(self);
				</event>
			</dataLink>
		</layout>

		<!--
			Credits (SPEC T532). Andre wrote this sheet; it grew out of another author's sheet
			plugin, and the one line under the developer credits them by name. The roll-call
			this box used to carry - a brand heading, three roles and two contributors - came
			out on the user's call (SPEC C, 2026-08-22). V230 holds both ends of what is left:
			the line cannot grow back into a block, and it cannot quietly disappear either.
			Neither the brand nor the author's name is spelled anywhere else in the source,
			comments included - which is why this one talks around both.

			82nd round (user 2026-08-22, items 7 and 8): the box gained the heading it never had
			and the same 14px above the first line as below the last - it was 10 and 5, and the
			lopsided pair is what showed. Both boxes on this tab went 330 -> 380 wide with it.
		-->
		<layout left="0" top="150" width="420" height="170">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>

			<label left="20" top="20" width="380" height="20" text="Credits" horzTextAlign="center"/>

			<label left="20" top="60" width="380" height="20" text="Developer: Andre (Styllern)" horzTextAlign="center"/>

			<label left="20" top="94" width="380" height="20" text="Based on the sheet plugin by Vinny (Ambesek)" horzTextAlign="center" fontSize="12"/>

			<label left="20" top="130" width="380" height="20" text="System: Storyteller" horzTextAlign="center"/>
		</layout>
	</scrollBox>
</form>
