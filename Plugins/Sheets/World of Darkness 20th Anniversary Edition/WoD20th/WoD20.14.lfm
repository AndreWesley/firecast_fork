<?xml version="1.0" encoding="UTF-8"?>
<form name="frmWoD20_14" align="client" theme="dark">
	<script>
		<![CDATA[
			-- Rituals area of the Vampire tab (SPEC I16, I19). Same shape as WoD20.12 and WoD20.13.
			--
			-- Rituals carry NO dots: the user asked for the five-dot scale on disciplines and
			-- blood sorcery paths, not on rituals, so a ritual is picked and that is all - it
			-- costs no experience and writes no ledger line (SPEC C, R52 is the open question).
			--
			-- The book text lives in descRitual_en.lua and descRitual_pt.lua (SPEC T495), at the
			-- plugin root next to module.xml (SPEC I24). The generator markers moved with it
			-- and then to both halves, so the region keeps its shape;
			-- only the file it sits in changed. The require that loads it is INSIDE ritualText,
			-- never here (SPEC V198): this CDATA is copied raw into constructNew_*(), so a
			-- top-level require would parse the whole table on every sheet open and the
			-- deferral would be a silent no-op.

			local NO_SELECTION = {
				en = "Pick the selector next to a ritual to read its description here.",
				pt = "Marque o seletor ao lado de um ritual para ler a descrição dele aqui.",
			};

			local EMPTY_ROW = {
				en = "That row is still empty. Choose a ritual in the list first.",
				pt = "Essa linha ainda está vazia. Escolha um ritual na lista primeiro.",
			};

			local NO_ENTRY = {
				en = "No description on file for: ",
				pt = "Sem descrição registrada para: ",
			};

			-- A typed row the storyteller has not written yet, read by anyone else (SPEC I45,
			-- V250). He sees the empty box: for him it is an input, and a sentence sitting in it
			-- would have to be deleted before he could type.
			local NO_TEXT_YET = {
				en = "The storyteller has not written a description for this one yet.",
				pt = "O narrador ainda não escreveu uma descrição para este.",
			};

			local function pick(tbl, lang)
				return tbl[lang] or tbl.en;
			end;

			-- SPEC T470 / I21: an entry may carry a SECOND body, written from the Dark Ages book,
			-- under daEn/daPt. The two medieval themes read it; the two modern ones never do.
			-- An entry with no medieval body falls back to the core one, so a gap in the Dark
			-- Ages text shows the core text and never an empty box (SPEC V33).
			local function pickEra(entry, lang)
				local era = currentTheme();

				if era == "Dark Ages" or era == "Classical Age" then
					local da = (lang == "pt" and entry.daPt) or entry.daEn;
					if da ~= nil and da ~= "" then return da; end;
				end;

				return pick(entry, lang);
			end;

			local function ritualText(lang)
				wodTrace("ritualText");
				local selected = sheet.ritualSel;

				if selected == nil or selected == "" then
					return pick(NO_SELECTION, lang);
				end;

				-- A TYPED row never reaches the book (SPEC I45, V250): the text is the
				-- storyteller's, one text for both languages and all four eras, and it keeps the
				-- require below out of reach for these rows (SPEC V206) - the biggest of the four
				-- modules at 1.1 MB.
				if isTypedRow(selected) then
					local own = sheet[descFieldOf(selected)];

					if own ~= nil and own ~= "" then return own; end;
					if isStoryteller() then return ""; end;

					return pick(NO_TEXT_YET, lang);
				end;

				local value = sheet[selected];

				if value == nil or value == "" then
					return pick(EMPTY_ROW, lang);
				end;

				-- SPEC V206: the require sits BELOW every early return, so a sheet with no
				-- selection - and a row that never reaches the book - parses nothing. This is the
				-- biggest of the four modules (1.1 MB) and it was the one paid on every open.
				-- SPEC V198 put it inside this body and the gate went green, but onNodeReady
				-- called this function on EVERY open and the deferral was a no-op nobody could
				-- see (SPEC B47): position in the FILE is not reach in the FLOW, and the gate
				-- reads source, not runtime (SPEC B30, B34). `require` still caches in
				-- package.loaded, so the first row that needs the book pays once.
				-- SPEC T495 / V210: the book is one module PER LANGUAGE, so what is parsed
				-- here is the half the reader can actually read - the other half was always
				-- text this session never opens (SPEC R92f). `lang` comes off the NDB, so
				-- anything that is not "pt" falls to the English half rather than requiring
				-- a file that is not there.
				local half = (lang == "pt") and "pt" or "en";
				wodTrace("descRitual.REQUIRE." .. half);
				local DESC = require("descRitual_" .. half .. ".lua");

				local entry = DESC[value];

				-- The name in the message is the one the ROW shows, so it goes through the era
				-- and then through the language exactly as the picker item does (SPEC I22, T469).
				-- Naming it by the raw canonical value would send the player looking for a line
				-- that is not in the list above.
				if entry == nil then
					return pick(NO_ENTRY, lang) .. translateSheetText(eraName(value, currentTheme()), lang);
				end;

				return pickEra(entry, lang);
			end;

			-- SPEC I26 / V206: painting this block costs a parse of the book module, so it
			-- happens when the tab is SHOWN, never when the sheet opens. onShow is the trigger
			-- and this guard is the second leg: whether onShow fires for a form inside an
			-- INACTIVE tab is not measured yet (SPEC R92b), so the fix hangs on two contracts
			-- instead of one - the lesson of SPEC B39.
			--
			-- Tested against `false`, not falsiness: if the host answers nil the block PAINTS,
			-- which is today's behaviour. Failing closed would leave an empty box with nothing
			-- to show for it - the silence SPEC V33 exists to forbid.
			function renderRitualDesc(form)
				if sheet == nil then return; end;
				if form.isShowing == false then return; end;

				-- Text and lock in the SAME step (SPEC V249c): one row's text under another
				-- row's lock is the lie V112 refuses of every runtime lock on this sheet.
				local sel   = sheet.ritualSel;
				local write = isTypedRow(sel) and isStoryteller();

				descQuiet = true;
				form.edtRitualDesc.text = ritualText(sheet.language or "en");
				form.edtRitualDesc.readOnly = not write;
				descQuiet = false;
			end;

			-- ---- The list keeps itself in order (SPEC I47, V252) -------------------------
			--
			-- Level first, then name, over the CANONICAL value and never over what the screen
			-- shows: the era renames what a picker displays (SPEC I22), and sorting by the
			-- display would make switching theme rewrite fields - data churn for a change of
			-- paint. The level is read off the prefix, the one place it is ever read from
			-- (SPEC V184).
			local function ritualRank(v)
				return tonumber(string.match(v, "^(%d+)%. ")) or 0, string.lower(v);
			end;

			-- The flash is a rectangle already sitting on the row, so lighting it writes no
			-- field and moves no geometry (SPEC V57). setTimeout is the SDK's own one-shot
			-- timer, milliseconds, self-dismantling (SPEC R99) - no <timer> in the XML and no
			-- state to keep between two flashes.
			--
			-- xpFind and not form.<name>: it is the sheet's one finder (SPEC V143), and the
			-- name is built at runtime from the field.
			local function flashRitual(form, field)
				local nm    = "hl" .. field;
				local found = xpFind(form, { [nm] = true }, {});
				local rect  = found[nm];

				if rect == nil then return; end;

				rect.visible = true;

				setTimeout(function() rect.visible = false; end, 1000);
			end;

			-- Raised while the sort writes its own slots. Every one of those writes comes back
			-- through the dataLink that called us, and a nested pass would sort a half-written
			-- list and flash a row for a value that is only passing through (SPEC V107, the
			-- shape xpQuiet and descQuiet already use).
			local sortQuiet = false;

			-- SPEC V252: the fifteen PICKED rows are kept in order and the five typed ones are
			-- left exactly where the storyteller wrote them - the sort moves values between
			-- slots, and a typed ritual would leave its description behind (SPEC V249).
			--
			-- Everything is written through setField, so a list already in order writes nothing
			-- and the link cannot bounce (SPEC V122).
			function sortRituals(form, field, value)
				if sortQuiet or sheet == nil then return; end;

				local last = RITUAL_ROWS - RITUAL_FREE_ROWS;
				local list = {};

				for i = 1, last, 1 do
					local v = sheet["ritual_" .. i];

					if v ~= nil and v ~= "" then list[#list + 1] = v; end;
				end;

				table.sort(list, function(a, b)
					local la, na = ritualRank(a);
					local lb, nb = ritualRank(b);

					if la ~= lb then return la < lb; end;

					return na < nb;
				end);

				-- What the marked row is HOLDING, so the mark can follow its ritual to whatever
				-- slot it lands in (SPEC V252d). A typed row is marked by its own field and
				-- never moves, so it is left out of this.
				local sel = sheet.ritualSel;
				local selValue = nil;

				if sel ~= nil and sel ~= "" and not isTypedRow(sel) then selValue = sheet[sel]; end;

				sortQuiet = true;

				for i = 1, last, 1 do
					setField("ritual_" .. i, list[i] or "");
				end;

				sortQuiet = false;

				if selValue ~= nil and selValue ~= "" then
					for i = 1, last, 1 do
						if sheet["ritual_" .. i] == selValue then
							setField("ritualSel", "ritual_" .. i);
							break;
						end;
					end;
				end;

				-- The flash belongs to the row that ENDED UP with the value just written, which
				-- is why it is looked up after the sort and not before (SPEC V253d). Clearing a
				-- row writes an empty value and lights nothing.
				if value ~= nil and value ~= "" then
					for i = 1, last, 1 do
						if sheet["ritual_" .. i] == value then
							flashRitual(form, "ritual_" .. i);
							break;
						end;
					end;
				end;
			end;

			-- The text lands in the field of the MARKED row, read at the moment of the write
			-- (SPEC V249c), and both questions are asked again rather than trusting the readOnly
			-- just written: that flag is a look, the rule is the rule (SPEC V249a, V80).
			--
			-- The typed rows are also the ones the sort leaves alone (SPEC V252a), which is what
			-- keeps this text attached to what it describes: a value that moved slots would have
			-- left its description behind.
			function saveRitualDesc(form)
				if descQuiet or sheet == nil then return; end;

				local sel = sheet.ritualSel;

				if not isTypedRow(sel) or not isStoryteller() then return; end;

				setField(descFieldOf(sel), form.edtRitualDesc.text);
			end;
		]]>
	</script>

	<scrollBox align="client">
		<image name="themePaper14" align="client" style="stretch" hitTest="false" visible="false"/>

		<!--
			No dot column here, so the picker takes the width the dots would have used. The radio
			still sits at x=0 and the picker at x=25, which keeps this row reading like the other
			three areas even though it is the only one that ends there.

			Ritual names arrive prefixed with their level - "3. Name" - so the level is read off
			the item itself and there is no second table to drift from it (SPEC V184, T460).

			The LAST child is the one-second flash a newly added ritual gets once the list has
			reordered itself (SPEC I47, V253). Last, because the host paints in document order
			and this one has to paint OVER the row - the same reason dynXpEmpty closes the log
			box (SPEC I39) - and it carries ALPHA so the name stays readable underneath it.

			hitTest is off: an overlay that ate the click would make the row unusable for the
			second it is up. It is authored hidden, and the only thing that ever writes its
			visible is the pair in flashRitual - lit, then put out by setTimeout.

			Its colour has a key in all four palettes (SPEC V53, I5), so the flash is the
			period's own accent and not one loose colour sitting outside the theme.

			⚠ This paragraph is HERE and not beside the rectangle it describes because an XML
			comment INSIDE a <template> makes rdk -l exit 1 with no message and DELETE the .rpk
			- the same signature as SPEC B19/B49, through a door nobody had opened before: the
			sheet has 26 templates and not one of them contained a comment. MEASURED, both ways:
			the identical text compiles here and kills the build eleven lines lower.
		-->
		<template name="RitualRow">
			<radioButton left="0" top="2" width="20" height="21" field="ritualSel" fieldValue="$(field)" groupName="ritualSel"/>
			<comboBox left="24" top="0" width="430" height="25" fontSize="12" name="cbo$(field)" field="$(field)"/>
			<rectangle name="hl$(field)" left="0" top="0" width="456" height="25" color="#55FFFFFF" xradius="14" yradius="14" cornerType="innerRound" visible="false" hitTest="false"/>
		</template>

		<!--
			The last five rows are TYPED (SPEC I45, V248, user 2026-08-22): same radio, same
			entry x as the picker row above (SPEC V26), `edt` instead of `cbo` so the filter and
			the guard pass them by (SPEC V211a, V248d).

			They also sit OUT of the alphabetical sort (SPEC I47, V252a): the sort moves values
			between slots, and moving a typed ritual would leave the description the storyteller
			wrote for it attached to the row it came from. They stay at the foot of the box,
			each one where it was written.
		-->
		<template name="RitualFreeRow">
			<radioButton left="0" top="2" width="20" height="21" field="ritualSel" fieldValue="$(field)" groupName="ritualSel"/>
			<edit left="24" top="0" width="430" height="25" fontSize="12" name="edt$(field)" field="$(field)"/>
		</template>

		<!-- 20 slots since the 85th round: five came off by request (SPEC I46, V251) and the box
		     came down with them. 10 title gap + 20 title + 20*25 rows + 10 foot = 541 (SPEC V240). -->
		<layout left="0" top="20" width="520" height="561">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="20" width="480" height="20" text="RITUALS" horzTextAlign="center"/>
			<layout left="32" top="41" width="456" height="25">
				<RitualRow field="ritual_1"/>
			</layout>
			<layout left="32" top="66" width="456" height="25">
				<RitualRow field="ritual_2"/>
			</layout>
			<layout left="32" top="91" width="456" height="25">
				<RitualRow field="ritual_3"/>
			</layout>
			<layout left="32" top="116" width="456" height="25">
				<RitualRow field="ritual_4"/>
			</layout>
			<layout left="32" top="141" width="456" height="25">
				<RitualRow field="ritual_5"/>
			</layout>
			<layout left="32" top="166" width="456" height="25">
				<RitualRow field="ritual_6"/>
			</layout>
			<layout left="32" top="191" width="456" height="25">
				<RitualRow field="ritual_7"/>
			</layout>
			<layout left="32" top="216" width="456" height="25">
				<RitualRow field="ritual_8"/>
			</layout>
			<layout left="32" top="241" width="456" height="25">
				<RitualRow field="ritual_9"/>
			</layout>
			<layout left="32" top="266" width="456" height="25">
				<RitualRow field="ritual_10"/>
			</layout>
			<layout left="32" top="291" width="456" height="25">
				<RitualRow field="ritual_11"/>
			</layout>
			<layout left="32" top="316" width="456" height="25">
				<RitualRow field="ritual_12"/>
			</layout>
			<layout left="32" top="341" width="456" height="25">
				<RitualRow field="ritual_13"/>
			</layout>
			<layout left="32" top="366" width="456" height="25">
				<RitualRow field="ritual_14"/>
			</layout>
			<layout left="32" top="391" width="456" height="25">
				<RitualRow field="ritual_15"/>
			</layout>
			<layout left="32" top="416" width="456" height="25">
				<RitualFreeRow field="ritual_16"/>
			</layout>
			<layout left="32" top="441" width="456" height="25">
				<RitualFreeRow field="ritual_17"/>
			</layout>
			<layout left="32" top="466" width="456" height="25">
				<RitualFreeRow field="ritual_18"/>
			</layout>
			<layout left="32" top="491" width="456" height="25">
				<RitualFreeRow field="ritual_19"/>
			</layout>
			<layout left="32" top="516" width="456" height="25">
				<RitualFreeRow field="ritual_20"/>
			</layout>
		</layout>

		<!-- Grows with the column on its left, never on its own (SPEC V193). -->
		<layout left="540" top="20" width="530" height="561">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="20" width="490" height="20" text="DESCRIPTION" horzTextAlign="center"/>
			<textEditor name="edtRitualDesc" left="30" top="41" width="470" height="500" readOnly="true" wordWrap="true" transparent="true" fontSize="12" onChange="saveRitualDesc(self);"/>
		</layout>
	</scrollBox>

	<dataLink fields="{'language', 'sheetTheme', 'ritualSel', 'ritual_1', 'ritual_2', 'ritual_3', 'ritual_4', 'ritual_5', 'ritual_6', 'ritual_7', 'ritual_8', 'ritual_9', 'ritual_10', 'ritual_11', 'ritual_12', 'ritual_13', 'ritual_14', 'ritual_15', 'ritual_16', 'ritual_17', 'ritual_18', 'ritual_19', 'ritual_20'}" onChange="renderRitualDesc(self);"/>

	<!--
		The picker guard (SPEC V185). Same door as WoD20.13: a dataLink, never the comboBox
		onChange (SPEC V186, B36/B38). A ritual asks two questions of its blood sorcery -
		is it on the sheet at all, and is it high enough - and the two refusals are told
		apart, because they are different problems with different fixes.
	-->
	<dataLink fields="{'ritual_1', 'ritual_2', 'ritual_3', 'ritual_4', 'ritual_5', 'ritual_6', 'ritual_7', 'ritual_8', 'ritual_9', 'ritual_10', 'ritual_11', 'ritual_12', 'ritual_13', 'ritual_14', 'ritual_15', 'ritual_16', 'ritual_17', 'ritual_18', 'ritual_19', 'ritual_20'}" onChange="guardPick(field, oldValue, newValue); sortRituals(self, field, newValue); renderVampPickers(self);"/>

	<!--
		What a ritual may BE is decided by the Disciplines (SPEC V185), so the list has to be
		rebuilt whenever one of them moves - which is the nineteen picker slots and the
		ninety-five dots under them, the rating BEING the dots. Same field set, and the same
		reason, as the link WoD20.13 uses to repaint its main path dots (SPEC V123): a link
		watches what its handler actually READS.

		It is a link of its own and not fields bolted onto the description link above: that
		one repaints book prose, and hanging ninety-five dot fields on it would re-render the
		whole description every time anyone bought anything (SPEC B34).

		Lowering a Discipline does NOT clear a row here (SPEC V187): the ritual the row is
		holding stays in its own list, and only its sisters stop offering it (SPEC V200).
	-->
	<dataLink fields="{'clanDisc_1', 'clanDisc_2', 'clanDisc_3', 'clanDisc_4', 'disc_1', 'disc_2', 'disc_3', 'disc_4', 'disc_5', 'disc_6', 'disc_7', 'disc_8', 'disc_9', 'disc_10', 'disc_11', 'disc_12', 'disc_13', 'disc_14', 'disc_15', 'clanDisc_1_1', 'clanDisc_1_2', 'clanDisc_1_3', 'clanDisc_1_4', 'clanDisc_1_5', 'clanDisc_2_1', 'clanDisc_2_2', 'clanDisc_2_3', 'clanDisc_2_4', 'clanDisc_2_5', 'clanDisc_3_1', 'clanDisc_3_2', 'clanDisc_3_3', 'clanDisc_3_4', 'clanDisc_3_5', 'clanDisc_4_1', 'clanDisc_4_2', 'clanDisc_4_3', 'clanDisc_4_4', 'clanDisc_4_5', 'disc_1_1', 'disc_1_2', 'disc_1_3', 'disc_1_4', 'disc_1_5', 'disc_2_1', 'disc_2_2', 'disc_2_3', 'disc_2_4', 'disc_2_5', 'disc_3_1', 'disc_3_2', 'disc_3_3', 'disc_3_4', 'disc_3_5', 'disc_4_1', 'disc_4_2', 'disc_4_3', 'disc_4_4', 'disc_4_5', 'disc_5_1', 'disc_5_2', 'disc_5_3', 'disc_5_4', 'disc_5_5', 'disc_6_1', 'disc_6_2', 'disc_6_3', 'disc_6_4', 'disc_6_5', 'disc_7_1', 'disc_7_2', 'disc_7_3', 'disc_7_4', 'disc_7_5', 'disc_8_1', 'disc_8_2', 'disc_8_3', 'disc_8_4', 'disc_8_5', 'disc_9_1', 'disc_9_2', 'disc_9_3', 'disc_9_4', 'disc_9_5', 'disc_10_1', 'disc_10_2', 'disc_10_3', 'disc_10_4', 'disc_10_5', 'disc_11_1', 'disc_11_2', 'disc_11_3', 'disc_11_4', 'disc_11_5', 'disc_12_1', 'disc_12_2', 'disc_12_3', 'disc_12_4', 'disc_12_5', 'disc_13_1', 'disc_13_2', 'disc_13_3', 'disc_13_4', 'disc_13_5', 'disc_14_1', 'disc_14_2', 'disc_14_3', 'disc_14_4', 'disc_14_5', 'disc_15_1', 'disc_15_2', 'disc_15_3', 'disc_15_4', 'disc_15_5'}" onChange="renderVampPickers(self);"/>

	<!-- The description block paints when the tab is SHOWN (SPEC I26 / V206): onNodeReady fires
	     on every open and dragged the whole 1.1 MB module in with it, the largest of the four
	     (SPEC B47).

	     The picker filter is NOT wired here any more (SPEC V207, T490). renderVampPickers walks
	     from the sheet ROOT and refilters all 45 vampire combos in one pass: the filter belongs
	     to the SHEET, not to this tab (SPEC V203), so one call does the whole job. T484 gave
	     WoD20.13 and WoD20.14 an onNodeReady each because every tab asked for its own without looking
	     at its sibling, and the second pass re-walked 1900 controls for nothing (SPEC B48).
	     The surviving call is WoD20.13's, which already shares its block with renderMainPaths.

	     Dropping THIS one rather than WoD20.13's is safe in both directions. Coverage: the walk
	     starts at the root, so it reaches this tab's ritual combos from a sibling just as well.
	     Ordering: the compiled form builds every control inside one constructNew_ and only
	     THEN registers the onNodeReady listeners, so the ritual combos already exist whichever
	     sibling fires first - the firing order never had to be known. -->
	<event name="onShow">
		wodTrace("WoD20.14.onShow");
		renderRitualDesc(self);
	</event>
</form>
