<?xml version="1.0" encoding="UTF-8"?>
<form name="frmWoD20_16" align="client" theme="dark">
	<script><![CDATA[
		-- Each Magick list item as it is built (81st batch, SPEC I224c, B203): the theme paints by
		-- walking the controls that exist, and a recordList builds its items after that walk - the
		-- seven first Foci, every Add, the lists filling on open. So the tab names, translates and
		-- paints each item itself, through the two functions every other control already goes
		-- through. `nameText` is the list's own word for a name (user 2026-10-07, SPEC Q138.2).
		function magickItemPaint(form, nameText)
			if sheet == nil or form == nil then return; end;

			local lang = sheet.language or "pt";

			if form.dynItemName ~= nil then form.dynItemName.text = translateSheetText(nameText, lang); end;
			if form.dynItemDesc ~= nil then form.dynItemDesc.text = translateSheetText("Description", lang); end;

			form.confirmText = translateSheetText("Remove this item from the list?", lang);

			themeItem(form);
		end;

		-- The language switched: every item already built gets its words again. A change of era
		-- needs nothing here - the whole-sheet walk reaches the items that exist (SPEC R188).
		function magickRelabel(from)
			if from == nil then return; end;

			for _, pair in ipairs({ { from.rclFoci, "Focus" }, { from.rclRotes, "Rote" }, { from.rclWonders, "Name" } }) do
				if pair[1] ~= nil then
					local items = pair[1]:getChildren();

					for i = 1, #items, 1 do magickItemPaint(items[i], pair[2]); end;
				end;
			end;
		end;
	]]></script>

	<scrollBox align="client">
		<!-- Theme backdrop, same arrangement as WoD20.1 (SPEC T158, V56, V57). -->
		<image name="themePaper16" align="client" style="stretch" hitTest="false" visible="false"/>

		<!--
			The Magick tab, a MAGE's alone (user 2026-10-07, SPEC I223g/h, V565): FOCI, ROTES and WONDERS,
			three lists the player grows and shrinks. Each box is 70% of a mage's BACKGROUNDS (509 -> 356)
			wide and, since the 81st batch, as tall as the Main's Avatar + Skills + Arete (236 + 351 + 244 =
			831, SPEC I224a, V566a), 5 between. The list is a recordList - the "delete of a recordList" SPEC C
			has allowed since the first round, after the Mage20th sheet's WONDERS (SPEC R187): the Add
			button appends an item, the item's X asks and deletes itself. All three share one item form,
			frmWoD20_17 (WoD20.17), and the list is 20 wider than it: 16 for the scrollbar and 4 between,
			so the bar never covers an item and an item never runs under the bar. Each list paints the
			item it builds (onItemAdded, magickItemPaint above).
			Since the 85th batch (user 2026-10-07, SPEC I228b, V570b) the cards keep ONE gap, 24, from the
			box's left, from its right and from each other: the list opens at 24, the card is 308 (356 -
			2 x 24), and the 20 of the scrollbar's lane fall inside the right-hand 24, 4 either side of the
			bar. The Add button closes where the cards close (332). Since the 86th batch (SPEC I229b) each
			card's 24 is above it, so the list opens on the title row's foot (35) and the first card sits
			24 under it, like every other gap.
			Seven empty Foci are seeded once per mage by seedFoci (root, SPEC I223j); Rotes and Wonders
			start empty.
		-->
		<layout name="boxFoci" left="0" top="0" width="356" height="831">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="316" height="20" text="FOCI" horzTextAlign="center" hitTest="false"/>
			<button name="btnAddFocus" left="252" top="15" width="80" height="20" text="Add" onClick="self.rclFoci:append();"/>
			<recordList name="rclFoci" left="24" top="35" width="328" height="776" field="magickFoci" templateForm="frmWoD20_17" layout="vertical">
				<event name="onItemAdded">magickItemPaint(form, "Focus");</event>
			</recordList>
		</layout>

		<layout name="boxRotes" left="361" top="0" width="356" height="831">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="316" height="20" text="ROTES" horzTextAlign="center" hitTest="false"/>
			<button name="btnAddRote" left="252" top="15" width="80" height="20" text="Add" onClick="self.rclRotes:append();"/>
			<recordList name="rclRotes" left="24" top="35" width="328" height="776" field="magickRotes" templateForm="frmWoD20_17" layout="vertical">
				<event name="onItemAdded">magickItemPaint(form, "Rote");</event>
			</recordList>
		</layout>

		<layout name="boxWonders" left="722" top="0" width="356" height="831">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="316" height="20" text="WONDERS" horzTextAlign="center" hitTest="false"/>
			<button name="btnAddWonder" left="252" top="15" width="80" height="20" text="Add" onClick="self.rclWonders:append();"/>
			<recordList name="rclWonders" left="24" top="35" width="328" height="776" field="magickWonders" templateForm="frmWoD20_17" layout="vertical">
				<event name="onItemAdded">magickItemPaint(form, "Name");</event>
			</recordList>
		</layout>
	</scrollBox>

	<dataLink field="language" onChange="magickRelabel(self);"/>
</form>
