<?xml version="1.0" encoding="UTF-8"?>
<form name="frmWoD20_9" align="client" theme="dark">
	<script>
		<![CDATA[
			-- The three experience numbers are drawn by renderXPBoxes on the root form (SPEC
			-- I11): the Main tab shows the balance too, so the routine that writes it cannot
			-- live on either tab (SPEC R.9 / B.9). None of the three owns a `field=` any more -
			-- only the total behind them is saved, and Spent and the balance are worked out
			-- from it and the log (SPEC V100).

			-- The log box grows with the rows instead of scrolling four columns apart from
			-- each other: the tab's scrollBox does the scrolling, so line N stays line N in
			-- all four. The XML height is the floor - shrinking would leave a hole in the box.
			local XP_ROW_H    = 20;
			local XP_LOG_MIN_H = 470;
			local XP_LOG_PAD  = 65;

			-- The two state sentences used to live IN the Type column, which was widened to 442 so
			-- it would cover its three empty neighbours. That is what made an empty log read as
			-- something broken instead of as an empty log (SPEC I39, V235, user 2026-08-22): the
			-- columns moved when there was nothing in them. The sentence has a label of its own
			-- now (dynXpEmpty) and no column ever changes width.

			-- ---- Experience log (SPEC I10, 27th round) ---------------------------------
			--
			-- Four columns, all four written from ONE row list, so a line reads across. They
			-- own no `field` (SPEC V84): the log is derived from the saved initial character
			-- and the sheet as it stands, exactly like the total above is derived from the two
			-- numbers beside it. A stored third copy could only drift.
			--
			-- The rows come from xpLedgerRows() on the root form (SPEC I9/I10); this routine
			-- only formats them.
			--
			-- `rows` is optional. A caller that has just built the list hands it over rather
			-- than making this walk the ledger a second time for the same click (SPEC V125) -
			-- that second walk is half of what made the sheet freeze (SPEC B34). Left out, the
			-- list is built here, and a nil coming back out of xpLedgerRows still means what it
			-- always did: no initial character has been saved yet.
			-- The five controls this routine writes. Found by name from whatever node it is
			-- handed (SPEC V143), so the same call works from this tab's own events and from
			-- the root, which is how a purchase made on ANY tab reaches the log without the
			-- tab having registered itself first (SPEC V133, B39).
			local XP_LOG = { dynXpType = true, dynXpTrait = true, dynXpLevel = true, dynXpCost = true, dynXpEmpty = true, xpLogBox = true };

			-- The four columns and the box they sit in grow together or not at all. Declared local
			-- and ABOVE their caller, which is not a matter of reading order: Lua resolves a
			-- non-local name at COMPILE time, so a body written above the declaration compiles a
			-- GETGLOBAL and calls nil (SPEC B51, V223).
			local function xpLogHeight(form, h)
				form.dynXpType.height  = h;
				form.dynXpTrait.height = h;
				form.dynXpLevel.height = h;
				form.dynXpCost.height  = h;
				form.xpLogBox.height   = h + XP_LOG_PAD;
			end;

			-- The two empty states differ by their sentence and by NOTHING else, so they are
			-- written once. Two copies is how one of them keeps a stale height, and that is not
			-- hypothetical: the no-baseline path wrote no height at all, so a box that had grown
			-- to forty rows stayed that tall and empty the moment the baseline came off.
			local function xpEmptyLog(form, why)
				form.dynXpType.text  = "";
				form.dynXpTrait.text = "";
				form.dynXpLevel.text = "";
				form.dynXpCost.text  = "";

				form.dynXpEmpty.text    = why;
				form.dynXpEmpty.visible = true;

				xpLogHeight(form, XP_LOG_MIN_H);
			end;

			function renderXPLedger(node, rows)
				if sheet == nil then return; end;

				local form = xpFind(node, XP_LOG, {});

				-- The tab is not on the sheet yet: nothing to draw on, and nothing to raise
				-- about it either.
				if form.dynXpType == nil then return; end;

				local lang = sheet.language or "en";

				if rows == nil then rows = xpLedgerRows(); end;

				-- SPEC V33 and V98: say WHY it is empty rather than show four blank columns. The two
				-- states differ in the sentence and in nothing else, and neither of them moves a
				-- column: an empty log has the shape of a full one (SPEC V235).
				if rows == nil or #rows == 0 then
					local why = "Nothing bought yet";

					if rows == nil then why = "Initial character not saved yet"; end;

					xpEmptyLog(form, translateSheetText(why, lang));
					return;
				end;

				local kinds, traits, levels, costs = {}, {}, {}, {};

				for i = 1, #rows, 1 do
					local r = rows[i];

					-- Both columns are written by Lua, so they are translated here (SPEC V70,
					-- same arrangement as the era ability labels): whoever writes a text owns
					-- both languages for it.
					kinds[i]  = translateSheetText(r.kind, lang);
					traits[i] = translateSheetText(r.name, lang);
					levels[i] = tostring(r.level);

					-- Just the figure, in every row (SPEC V120): the log prints what the point
					-- cost and nothing else - no word to keep in two languages.
					costs[i] = tostring(r.cost);
				end;

				-- Rows to read: the sentence steps aside and the columns stay exactly where they
				-- are. Nothing here writes a width (SPEC V235a).
				form.dynXpEmpty.visible = false;

				form.dynXpType.text  = table.concat(kinds, "\n");
				form.dynXpTrait.text = table.concat(traits, "\n");
				form.dynXpLevel.text = table.concat(levels, "\n");
				form.dynXpCost.text  = table.concat(costs, "\n");

				local h = XP_LOG_MIN_H;

				if #rows * XP_ROW_H + 12 > h then h = #rows * XP_ROW_H + 12; end;

				xpLogHeight(form, h);
			end;
		]]>
	</script>
	<scrollBox align="client">
		<!-- Theme backdrop, same arrangement as WoD20.1 (SPEC T158, V56, V57). -->
		<image name="themePaper9" align="client" style="stretch" hitTest="false" visible="false"/>
		<!--
			Progress tab (SPEC T106). Current Experience used to be an NDB mirror of the box on
			the Main tab, both owning `field="experience"`. Neither owns a field now (SPEC I11):
			both are written by renderXPBoxes and both hand what the player types to
			xpSetCurrent, so they stay in step through the one number that IS saved.
		-->
		<!--
			The three numbers sit side by side (SPEC T140): one column each, same label width and
			same edit column, so the three edits line up (SPEC V26). The box spans the full tab
			width, which is what the log box below is aligned to.
		-->
		<!--
			Three columns of 336, each holding its label with the number CENTRED UNDER IT rather than
			beside it (SPEC T151). The title sits 10 off the top edge and the data starts 8 under it:
			room above the heading, none wasted between the heading and what it names.

			Stacking costs height - the box went 75 -> 95 - which is why the log below starts at 105
			and still closes the tab on 640.
		-->
		<layout left="0" top="12" width="501" height="95">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="0" top="10" width="501" height="20" text="EXPERIENCE" horzTextAlign="center"/>

			<label left="16" top="38" width="141" height="20" text="Total Experience" horzTextAlign="center"/>
			<!-- The two locked numbers stand on a darker ground than the box (SPEC V256, user
			     2026-08-22). It takes THREE things and any one of them alone does nothing: the
			     rectangle declared BEFORE the edit so it paints behind it, transparent="true" on the
			     edit so its own ground stops covering it, and a colour with a key in all four palettes
			     so the theme owns the shade (SPEC V53). gui.Edit has no background colour of its own -
			     MEASURED in the SDK, its props are textPrompt/transparent/field/frameRegion/type/min/
			     max/decimalPlaces/asNumber - so the rectangle is the only way to say this.

			     Current is NOT given one: it is the box the player types in, and a lock cue on an
			     unlocked field is decoration (SPEC V256 scope, V241). -->
			<rectangle name="bgTotalXP" left="41" top="60" width="90" height="25" color="#0A0A0A" xradius="6" yradius="6" cornerType="innerRound" hitTest="false"/>
			<edit name="edtTotalXP" left="41" top="60" width="90" height="25" readOnly="true" opacity="0.75" horzTextAlign="center" fontSize="14" transparent="true"/>

			<label left="180" top="38" width="141" height="20" text="Spent Experience" horzTextAlign="center"/>
			<!-- Authored LOCKED, and the lock moves at runtime with the storyteller's flag
			     (SPEC I44, V245): the sheet has to read right before any Lua runs, and OFF is
			     what the flag defaults to. Typing here writes a MANUAL line into the log, never
			     a second number beside it (SPEC V246). -->
			<rectangle name="bgSpentXP" left="205" top="60" width="90" height="25" color="#0A0A0A" xradius="6" yradius="6" cornerType="innerRound" hitTest="false"/>
			<edit name="edtSpentXP" left="205" top="60" width="90" height="25" readOnly="true" opacity="0.75" horzTextAlign="center" fontSize="14" transparent="true" onUserChange="xpSetSpent(self, self.edtSpentXP.text);"/>

			<label left="344" top="38" width="141" height="20" text="Current Experience" horzTextAlign="center"/>
			<edit name="edtCurrentXP" left="369" top="60" width="90" height="25" horzTextAlign="center" fontSize="14" onUserChange="xpSetCurrent(self, self.edtCurrentXP.text);"/>
		</layout>

		<!--
			The log is now four columns instead of one free-text box (SPEC I10, 27th round):
			what was raised, which trait, the rating it reached, and what that point cost.
			`xpLog` is gone with the box that owned it and is an ORPHAN from here on (SPEC I3 /
			V91) - the name is never reused, so text typed into the old sheet cannot come back
			up inside a column that means something else.

			The four editors are read-only and carry no `field`: the rows are derived on every
			render (SPEC V83/V84).
		-->
		<layout name="xpLogBox" left="0" top="117" width="501" height="540">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="0" top="10" width="501" height="20" text="EXPERIENCE LOG" horzTextAlign="center"/>

			<!--
				Widths asked for by the user on top of the measured ones (33rd round): Type -30%,
				Trait -20%, Level -10%, Cost -50%. The two text columns read from the left, the two
				short ones are CENTRED - a rating and a price are read as a column of figures, not
				as a sentence.

				What the measurements say has to fit, at the widest of the four theme fonts (Georgia
				and Book Antiqua run wider than Segoe UI at the same size): "FORÇA DE VONTADE" 134px
				at a 12px body and 157px at 14px, "Empatia com Animais" 126/147px, "Grátis" 38/44px.
				Type and Cost are now UNDER their 14px figure - the trim was asked for with the
				sheet on screen, so what renders is the judge; if a kind name or the word Grátis
				comes up cut in the Dark Ages or Classical paper, these two are what to widen.

				85th round: Level went 54 -> 82 to hold the word MANUAL, the one row whose Level
				is a word and not a rating (SPEC I44, V246). Cost moved with it and both boxes
				grew by the same 26, so the four columns keep their gaps and the two boxes still
				close on the same x (SPEC V247) - a column that grows while its box stands still
				is how the log would have started poking out of its own frame.
			-->
			<label left="15" top="35" width="133" height="20" text="Type" horzTextAlign="center"/>
			<label left="158" top="35" width="180" height="20" text="Trait" horzTextAlign="center"/>
			<label left="348" top="35" width="82" height="20" text="Level" horzTextAlign="center"/>
			<label left="440" top="35" width="45" height="20" text="Cost" horzTextAlign="center"/>

			<textEditor name="dynXpType" left="15" top="60" width="133" height="470" readOnly="true" opacity="0.75"/>
			<textEditor name="dynXpTrait" left="158" top="60" width="180" height="470" readOnly="true" opacity="0.75"/>
			<textEditor name="dynXpLevel" left="348" top="60" width="82" height="470" readOnly="true" opacity="0.75" horzTextAlign="center"/>
			<textEditor name="dynXpCost" left="440" top="60" width="45" height="470" readOnly="true" opacity="0.75" horzTextAlign="center"/>

			<!-- Why the log is empty, on a line of its own (SPEC I39, V235). Declared LAST because
			     it sits over the four columns and the host paints in document order - the same
			     reason the Type column used to be last, now carried by the control that actually
			     needs it. Authored hidden: a log with rows never shows it, and the dyn* prefix
			     keeps the language traversal off it (SPEC V31). -->
			<label name="dynXpEmpty" left="0" top="60" width="501" height="20" text="" horzTextAlign="center" opacity="0.75" visible="false"/>

		</layout>
	</scrollBox>

	<!-- Two entry points, as everywhere else on this sheet: the link catches later edits, the
	     onNodeReady catches the sheet being opened (SPEC V19 / V33). -->
	<dataLink field="xpTotal" onChange="renderXPBoxes(self);"/>

	<!-- Every one of these four moves the prices, so the three numbers are rebuilt with the log:
	     free-buy and the backgrounds rule change what a point costs, the snapshot changes what
	     counts as bought at all, and the language changes the two text columns.
	     What the ledger reads directly: the snapshot itself, the rule that prices backgrounds,
	     and the language its two text columns are written in. This tab watches `language`
	     itself rather than being called from WoD20.6, because the four columns are declared here
	     and only this form can address them. The dots are NOT watched from here - there are
	     some four hundred and sixty of them and no list of that size stays correct. What
	     redraws the log when one of them is clicked is the click itself: xpClick already runs
	     on every dot that costs experience and already holds the rows (SPEC V121/V125). -->
	<dataLink fields="{'baseline', 'stBackgroundsXP', 'language'}" onChange="renderXPLedger(self); renderXPBoxes(self);"/>

	<!-- The storyteller's correction and the flag that allows it (SPEC I44, V245/V246). Both
	     are owned on WoD20.10 and watched from here, so a tick or a figure entered by ANOTHER
	     client at the table reaches this tab too - the same reason the clan lock hangs off a
	     dataLink rather than off the checkbox that writes it (SPEC V175, V95).

	     `xpManual` moves a LINE of the log and the Spent box with it; `stEditSpentXP` moves
	     only the lock, but it is painted by the same routine that writes the number, so the
	     two cannot come apart (SPEC V112). -->
	<dataLink fields="{'xpManual', 'stEditSpentXP'}" onChange="renderXPLedger(self); renderXPBoxes(self);"/>

	<!-- The tab is a REPORT, so it is rebuilt every time it comes up (SPEC V97). -->
	<event name="onShow">
		wodTrace("WoD20.9.onShow");
		renderXPBoxes(self);
		renderXPLedger(self);
	</event>

	<event name="onNodeReady">
		renderXPBoxes(self);
		renderXPLedger(self);

		-- Nothing is handed over any more (SPEC V133, 44th round). This tab used to register
		-- itself twice - once for the log and once for the three numbers - and a purchase
		-- reached neither until it had (SPEC B39). xpClick now walks from the sheet root and
		-- finds both by name, so a tab that was never opened costs nothing and a tab that is
		-- open is drawn whether or not it ever announced itself.
		--
		-- What DID have to leave for good is the whole-node ndb.newObserver that sat here
		-- until the 39th round (SPEC V121): it fired on EVERY attribute written - including
		-- the hundreds the sheet writes to itself while loading - and it did not pass through
		-- xpQuiet, so the shield that fixed B30 never covered it. On a sheet with a saved
		-- baseline that was a full walk of the ledger per write, and the sheet froze on open
		-- (SPEC B34).
	</event>
</form>
