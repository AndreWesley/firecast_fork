				["BASE OF OPERATIONS (OTHER)"] = "BASE DE OPERAÇÕES (OUTROS)",

				-- 4th round (SPEC T108): Progress tab, the History renames and the Combat mirror.
				-- The seven health level names are NOT here: renderHealthTrack on the root form
				-- writes those labels itself, in both languages, and the traversal below skips
				-- them (see the `dyn` guard) - HEALTH_PT is their translation table.
				["Progress"] = "Progresso",
				["Goals"] = "Metas",
				["Moral Flaws"] = "Falhas Morais",
				["Fears"] = "Medos",
				["Nationality"] = "Nacionalidade",
				["EXPERIENCE LOG"] = "REGISTRO DE EXPERIÊNCIA",
				["Total Experience"] = "Experiência Total",
				["Spent Experience"] = "Experiência Gasta",
				["Current Experience"] = "Experiência Atual",
				["COMBAT TRAITS"] = "TRAÇOS DE COMBATE",
			};

			-- SPEC V21 / B.9: a form's getChildren() returns only its own declared children,
			-- so recursing from this Credits form reached this tab and nothing else. Walk UP
			-- to the sheet root first, then down over everything.
			local function rootOf(ctrl)
				local p = ctrl;

				while true do
					local up = p:getParent();
					if up == nil then return p; end;
					p = up;
				end;
			end;

			local function collect(node, out)
				local children = node:getChildren();

				for i = 1, #children, 1 do
					out[#out + 1] = children[i];
					collect(children[i], out);
				end;
			end;

			-- SPEC V22 / B.8: the authored English is snapshotted once and never overwritten.
			-- The old routine translated label.text in place with no original kept, which is
			-- why it could not switch back and why a second run did nothing.
			local originalText = {};

			local function applyLanguage(lang, from)
				local root = rootOf(from);
				local all = {root};
				collect(root, all);

				for i = 1, #all, 1 do
					local c = all[i];
					local cls = c:getClassName();

					-- Controls whose text belongs to Lua are named `dyn*` and are skipped here.
					-- SPEC V31 made the same call for the numina description block: this routine
					-- snapshots the authored English ONCE, so a control whose text is rewritten
					-- later (the health track changing length) would be restored to a stale
					-- label. Whoever writes the text owns both languages for it.
					local dynName = c:getName();
					local isDyn = dynName ~= nil and string.sub(dynName, 1, 3) == "dyn";

					if isDyn then
						-- nothing: renderHealthTrack keeps this one in the right language
					elseif cls == "label" or cls == "checkBox" or cls == "button" or cls == "tab" then
						local h = c.handle;

						if originalText[h] == nil then
							originalText[h] = c.text or "";
						end;

						local orig = originalText[h];

						if orig ~= "" then
							if lang == "pt" then
								c.text = PT[orig] or orig;
							else
								c.text = orig;
							end;
						end;
					elseif cls == "comboBox" then
						-- SPEC V24: `values` stay canonical English because that is what gets
						-- saved on the sheet; only the displayed `items` change language.
						-- Only the `cbo*` pickers - the language combo itself must not be
						-- rewritten with its own values ("en"/"pt").
						local nm = c:getName();

						if nm ~= nil and string.sub(nm, 1, 3) == "cbo" then
							local vals = c.values;

							if vals ~= nil then
								local shown = {};

								for k = 1, #vals, 1 do
									local v = vals[k];

									if lang == "pt" then
										shown[k] = PT[v] or v;
									else
										shown[k] = v;
									end;
								end;

								c.items = shown;
							end;
						end;
					end;
				end;
			end;
		]]>
	</script>
	<scrollBox align="client">
		<!-- Settings tab (ex-Credits, SPEC T73/T74). The sponsor image that used to fill the
		     right-hand column is gone for good, so both boxes sit at x=0. -->
		<layout left="0" top="0" width="200" height="275">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="10" width="200" height="20" text="Programmer: Andre (Styllern)" horzTextAlign="center"/>
			<label left="0" top="35" width="200" height="20" text="Programmer: Vinny (Ambesek)" horzTextAlign="center"/>
			<label left="0" top="60" width="200" height="20" text="Art: Nefer (Nefertyne)" horzTextAlign="center"/>
			<label left="0" top="85" width="200" height="20" text="Consultant: Nautilus" horzTextAlign="center" fontSize="13"/>
			<label left="0" top="110" width="200" height="20" text="Sheet made for the table" horzTextAlign="center"/>
			<label left="0" top="135" width="200" height="20" text="System: Storyteller" horzTextAlign="center"/>

			<label left="0" top="185" width="200" height="20" text="Contributors:" horzTextAlign="center"/>
			<label left="0" top="210" width="200" height="20" text="Nautilus" horzTextAlign="center"/>
			<label left="0" top="235" width="200" height="20" text="Gallo" horzTextAlign="center"/>
		</layout>

		<layout left="0" top="285" width="330" height="105">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>

			<label left="0" top="10" width="90" height="20" text="Language" horzTextAlign="center"/>
			<comboBox left="95" top="10" width="220" height="25" field="language" fontColor="white" horzTextAlign="center" items="{'English', 'Português BR'}" values="{'en', 'pt'}"/>
			<dataLink field="language" defaultValue="en">
				<event name="onChange">
					if sheet == nil then return end;
					applyLanguage(sheet.language or "en", self);
				</event>
			</dataLink>

			<!-- `Game` only stores what the table is playing (SPEC C, T75). Nothing reads it
			     yet - no content is filtered by it, on purpose. Named cbo* so the language
			     switch translates the shown items while `values` stay English (SPEC V24). -->
			<label left="0" top="50" width="90" height="20" text="Game" horzTextAlign="center"/>
			<comboBox left="95" top="50" width="220" height="25" name="cboGame" field="game" fontColor="white" horzTextAlign="center" items="{'', 'Vampire: The Masquerade', 'Vampire: Dark Ages', 'Werewolf: The Apocalypse', 'Mage: The Ascension', 'Hunters Hunted'}" values="{'', 'Vampire: The Masquerade', 'Vampire: Dark Ages', 'Werewolf: The Apocalypse', 'Mage: The Ascension', 'Hunters Hunted'}">
			</comboBox>
		</layout>
	</scrollBox>
</form>
