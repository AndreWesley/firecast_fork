	<dataLink fields="{'language', 'ritualSel', 'ritual_1', 'ritual_2', 'ritual_3', 'ritual_4', 'ritual_5', 'ritual_6', 'ritual_7', 'ritual_8', 'ritual_9', 'ritual_10', 'ritual_11', 'ritual_12', 'ritual_13', 'ritual_14', 'ritual_15', 'ritual_16', 'ritual_17', 'ritual_18', 'ritual_19', 'ritual_20', 'ritual_21', 'ritual_22', 'ritual_23', 'ritual_24', 'ritual_25'}" onChange="renderRitualDesc(self);"/>

	<!--
		The picker guard (SPEC V185). Same door as HH.13: a dataLink, never the comboBox
		onChange (SPEC V186, B36/B38). A ritual asks two questions of its blood sorcery -
		is it on the sheet at all, and is it high enough - and the two refusals are told
		apart, because they are different problems with different fixes.
	-->
	<dataLink fields="{'ritual_1', 'ritual_2', 'ritual_3', 'ritual_4', 'ritual_5', 'ritual_6', 'ritual_7', 'ritual_8', 'ritual_9', 'ritual_10', 'ritual_11', 'ritual_12', 'ritual_13', 'ritual_14', 'ritual_15', 'ritual_16', 'ritual_17', 'ritual_18', 'ritual_19', 'ritual_20', 'ritual_21', 'ritual_22', 'ritual_23', 'ritual_24', 'ritual_25'}" onChange="guardPick(field, oldValue, newValue);"/>

	<event name="onNodeReady">
		renderRitualDesc(self);
	</event>
</form>
