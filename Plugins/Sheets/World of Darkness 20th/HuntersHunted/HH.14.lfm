			<layout left="12" top="450" width="485" height="25">
				<RitualRow field="ritual_18"/>
			</layout>
			<layout left="12" top="475" width="485" height="25">
				<RitualRow field="ritual_19"/>
			</layout>
			<layout left="12" top="500" width="485" height="25">
				<RitualRow field="ritual_20"/>
			</layout>
			<layout left="12" top="525" width="485" height="25">
				<RitualRow field="ritual_21"/>
			</layout>
			<layout left="12" top="550" width="485" height="25">
				<RitualRow field="ritual_22"/>
			</layout>
			<layout left="12" top="575" width="485" height="25">
				<RitualRow field="ritual_23"/>
			</layout>
			<layout left="12" top="600" width="485" height="25">
				<RitualRow field="ritual_24"/>
			</layout>
			<layout left="12" top="625" width="485" height="25">
				<RitualRow field="ritual_25"/>
			</layout>
		</layout>

		<!-- Grows with the column on its left, never on its own (SPEC V193). -->
		<layout left="520" top="0" width="850" height="675">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="0" top="4" width="850" height="20" text="DESCRIPTION" horzTextAlign="center"/>
			<textEditor name="edtRitualDesc" left="10" top="25" width="830" height="640" readOnly="true" opacity="0.55" wordWrap="true" transparent="true" fontSize="12"/>
		</layout>
	</scrollBox>

	<dataLink fields="{'language', 'ritualSel', 'ritual_1', 'ritual_2', 'ritual_3', 'ritual_4', 'ritual_5', 'ritual_6', 'ritual_7', 'ritual_8', 'ritual_9', 'ritual_10', 'ritual_11', 'ritual_12', 'ritual_13', 'ritual_14', 'ritual_15', 'ritual_16', 'ritual_17', 'ritual_18', 'ritual_19', 'ritual_20', 'ritual_21', 'ritual_22', 'ritual_23', 'ritual_24', 'ritual_25'}" onChange="renderRitualDesc(self);"/>

	<!--
		The picker guard (SPEC V185). Same door as HH.13: a dataLink, never the comboBox
		onChange (SPEC V186, B36/B38). A ritual asks two questions of its blood sorcery -
		is it on the sheet at all, and is it high enough - and the two refusals are told
		apart, because they are different problems with different fixes.
	-->
	<dataLink fields="{'ritual_1', 'ritual_2', 'ritual_3', 'ritual_4', 'ritual_5', 'ritual_6', 'ritual_7', 'ritual_8', 'ritual_9', 'ritual_10', 'ritual_11', 'ritual_12', 'ritual_13', 'ritual_14', 'ritual_15', 'ritual_16', 'ritual_17', 'ritual_18', 'ritual_19', 'ritual_20', 'ritual_21', 'ritual_22', 'ritual_23', 'ritual_24', 'ritual_25'}" onChange="guardPick(field, oldValue, newValue);"/>

	<event name="onNodeReady">
		renderRitualDesc(self);
	</event>
</form>
