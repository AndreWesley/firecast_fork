<?xml version="1.0" encoding="UTF-8"?>
<form name="frmHH_12" align="client" theme="dark">
	<!--
		Magika tab (SPEC T241, 27th round). EMPTY for the same reason HH.11 is: the window was
		asked for now, the content later, and it only appears when the storyteller ticks
		"Show Magika" (SPEC I8b, V89).

		Spheres, Rotes, Focus and Arete are Mage-only and stay out of a mortal sheet (SPEC C);
		what the 27th round allows in is the WINDOW, not that content. No `field` is declared
		here either (SPEC V90).
	-->
	<scrollBox align="client">
		<image name="themePaper12" align="client" style="stretch" hitTest="false" visible="false"/>

		<layout left="0" top="0" width="1040" height="120">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="0" top="4" width="1040" height="20" text="MAGIKA" horzTextAlign="center"/>
		</layout>
	</scrollBox>
</form>
