<?xml version="1.0" encoding="UTF-8"?>
<form name="frmHuntersHunted" formType="sheetTemplate" dataType="Ambesek.HuntersHunted.20th" title="Hunters Hunted - Mortal" align="client" theme="dark">
	<script>
		<![CDATA[
			-- Health track, shared by the Main tab and its mirror on the Combat tab.
			--
			-- It lives on the ROOT form on purpose: this script is parsed before the <import>
			-- of any tab, so both tabs can call into it without depending on which sibling tab
			-- happened to load first. SPEC R.9 / B.9 is the same lesson from the other side -
			-- a tab form cannot reach its siblings, so anything two tabs share belongs here.

			-- The 10 lists are LITERAL from the user (SPEC C, V39). They are NOT derivable:
			-- 6 is 7 minus Bruised and 5 is that minus Hurt, but 4 skips Crippled instead of
			-- continuing to trim from the top. Do not "simplify" this into a loop.
			HEALTH_LEVELS = {
				[1]  = {"Incapacitated"},
				[2]  = {"Injured (-1)", "Incapacitated"},
				[3]  = {"Injured (-1)", "Wounded (-2)", "Incapacitated"},
				[4]  = {"Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Incapacitated"},
				[5]  = {"Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[6]  = {"Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[7]  = {"Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[8]  = {"Bruised", "Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[9]  = {"Bruised", "Bruised", "Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[10] = {"Bruised", "Bruised", "Bruised", "Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
			};

			-- These labels are written by Lua, so they never pass through the HH.6 translation
			-- traversal - that routine snapshots the authored English once and would restore a
			-- stale snapshot the moment the track length changed. Same arrangement as the numina
			-- description block (SPEC V31): whoever writes the text owns both languages.
			-- The gate checks this table against localization.lang, like it does the PT map.
			HEALTH_PT = {
				["Bruised"]        = "Escoriado",
				["Hurt (-1)"]      = "Machucado (-1)",
				["Injured (-1)"]   = "Ferido (-1)",
				["Wounded (-2)"]   = "Ferido Gravemente (-2)",
				["Mauled (-2)"]    = " Espancado (-2)",
				["Crippled (-5)"]  = "Aleijado (-5)",
				["Incapacitated"]  = "Incapacitado",
			};

			-- The four damage marks, LITERAL from the user (SPEC C, V41), in cycle order. Mark 1
			-- is a single space, not "": the sheet stores exactly what the box shows.
			HEALTH_MARKS = {" ", "/", "X", "*"};

			-- Box geometry, named rather than written into the height sum further down: PITCH is
			-- the distance between two rows in the .lfm files and PAD is the room above the first
			-- row plus the room under the last. The gate measures the real row spacing in the XML
			-- and fails if it stops matching PITCH (SPEC V49) - the same Lua-vs-XML drift that
			-- produced B12 and B16.
			HEALTH_ROW_PITCH = 27;
			HEALTH_BOX_PAD   = 36;

			local function markIndex(v)
				for i = 1, #HEALTH_MARKS, 1 do
					if HEALTH_MARKS[i] == v then return i; end;
				end;

				-- nil, a boolean from a sheet saved before the 6th round, or anything else:
				-- reads as the empty mark, so a click always continues the cycle (SPEC V42).
				return 1;
			end;

			-- The track is always grouped, worst damage first (SPEC V46): every aggravated, then
			-- every lethal, then every bashing, then the empty rows - and never a gap between
			-- two marks. HEALTH_MARKS runs from empty to worst, so walking it backwards IS the
			-- severity order and there is no second list to drift from it (SPEC V47).
			--
			-- This only ever moves marks around: the count of each symbol before and after is
			-- the same, so regrouping is not healing and cannot hide damage.
			function regroupHealthMarks()
				if sheet == nil then return; end;

				local n = tonumber(sheet.healthLevels) or 7;
				local counts = {};

				for m = 1, #HEALTH_MARKS, 1 do counts[m] = 0; end;

				for i = 1, n, 1 do
					local at = markIndex(sheet["health_" .. i]);
					counts[at] = counts[at] + 1;
				end;

				local row = 1;

				for m = #HEALTH_MARKS, 2, -1 do
					for k = 1, counts[m], 1 do
						sheet["health_" .. row] = HEALTH_MARKS[m];
						row = row + 1;
					end;
				end;

				while row <= n do
					sheet["health_" .. row] = HEALTH_MARKS[1];
					row = row + 1;
				end;
			end;

			-- Clearing a mark is HEALING, and healing always comes off the BOTTOM of the track
			-- (SPEC V44): whatever row the player clicks, the last marked row is the one that
			-- empties, and the clicked row keeps what it was showing. Damage goes in anywhere,
			-- healing only ever comes off the end.
			--
			-- Only rows the player can see are eligible (SPEC V45). A mark stranded above the
			-- current track length - marked at 10 levels, then the track shortened to 7 - would
			-- otherwise eat the click and look like nothing happened.
			function healHealthMark()
				if sheet == nil then return; end;

				local n = tonumber(sheet.healthLevels) or 7;

				for i = n, 1, -1 do
					if markIndex(sheet["health_" .. i]) > 1 then
						sheet["health_" .. i] = HEALTH_MARKS[1];
						return;
					end;
				end;
			end;

			-- Both tabs call this. The argument is the row number because the field name is
			-- positional (health_1 .. health_10, SPEC I3) - the row IS the identity.
			function cycleHealthMark(n)
				if sheet == nil then return; end;

				local at = markIndex(sheet["health_" .. n]);

				if at == #HEALTH_MARKS then
					-- Next symbol would be the empty one, so this click is a heal: the clicked
					-- row is left alone and the bottom-most mark goes instead (SPEC V44).
					healHealthMark();
				else
					sheet["health_" .. n] = HEALTH_MARKS[at + 1];
				end;

				-- Upgrading a mark in the middle of the stack, or starting a new one on an empty
				-- row further down, leaves the track out of order - regroup puts the worse
				-- damage back on top (SPEC V46). Healing cannot break the order: dropping the
				-- last mark of a sorted list leaves it sorted.
				regroupHealthMarks();
			end;

			-- `form` is the tab form; `prefix` names its ten rows: the layout `<prefix>rowN`
			-- holds the level label `<prefix>N` and the clickable mark box.
			-- The `dyn` prefix is what tells the HH.6 traversal to leave them alone.
			function renderHealthTrack(form, prefix)
				if sheet == nil then return; end;

				local n = tonumber(sheet.healthLevels) or 7;
				local levels = HEALTH_LEVELS[n];
				local lang = sheet.language or "en";

				-- The black box ends right under the last visible row instead of always being
				-- ten rows tall (SPEC V49). It only ever shrinks: the .lfm declares the ten-row
				-- height, and ten is the top of the combo.
				local box = form[prefix .. "box"];

				if box ~= nil then
					box.height = n * HEALTH_ROW_PITCH + HEALTH_BOX_PAD;
				end;

				for i = 1, 10, 1 do
					-- A sheet saved before the 6th round has a boolean here, which the mark
					-- label would render as "true". Normalise it once, on the first render that
					-- sees it (SPEC V42). Hidden rows are normalised too, so growing the track
					-- later cannot expose a stale value.
					local mark = sheet["health_" .. i];

					if mark ~= nil and mark ~= HEALTH_MARKS[1] and markIndex(mark) == 1 then
						sheet["health_" .. i] = HEALTH_MARKS[1];
					end;
				end;

				-- A sheet marked before the 8th round has its marks in click order, so the first
				-- render groups them (SPEC V46). Normalisation runs first: a leftover boolean
				-- would otherwise be counted as a mark. This only moves marks, never drops one.
				regroupHealthMarks();

				for i = 1, 10, 1 do
					local row = form[prefix .. "row" .. i];
					local text = form[prefix .. i];

					if row ~= nil and text ~= nil then
						local canon = nil;

						if levels ~= nil then canon = levels[i]; end;

						if canon == nil then
							-- Rows past the chosen length, or an out-of-range value: hide the
							-- whole row, label and mark box together.
							row.visible = false;
						else
							row.visible = true;

							if lang == "pt" then
								text.text = HEALTH_PT[canon] or canon;
							else
								text.text = canon;
							end;
						end;
					end;
				end;
			end;
		]]>
	</script>
	<tabControl align="client">
		<tab title="Main">
			<import file="HH.1.lfm"/>
		</tab>
		<tab title="Traits">
			<import file="HH.2.lfm"/>
		</tab>
		<tab title="Powers">
			<import file="HH.7.lfm"/>
		</tab>
		<tab title="Combat">
			<import file="HH.3.lfm"/>
		</tab>
		<tab title="Inventory">
			<import file="HH.8.lfm"/>
		</tab>
		<tab title="Background">
			<import file="HH.4.lfm"/>
		</tab>
		<tab title="Progress">
			<import file="HH.9.lfm"/>
		</tab>
		<tab title="Notes">
			<import file="HH.5.lfm"/>
		</tab>
		<tab title="Settings">
			<import file="HH.6.lfm"/>
		</tab>
	</tabControl>
</form>
