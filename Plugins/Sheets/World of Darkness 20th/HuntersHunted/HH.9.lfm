<?xml version="1.0" encoding="UTF-8"?>
<form name="frmHH_9" align="client" theme="dark">
	<script>
		<![CDATA[
			-- Total is the only computed value on this sheet. SPEC C forbids derived numbers as a
			-- rule - the sheet is paper and the player adds up - and revokes that for this field
			-- only, because the player asked for a running total.
			--
			-- It owns no `field=` (SPEC I3, same arrangement as the numina description block in
			-- V29): a stored third number could drift away from the two that produce it, and it
			-- can always be recomputed from them.
			function renderTotalXP(form)
				if sheet == nil then return; end;

				local spent   = tonumber(sheet.spentXP) or 0;
				local current = tonumber(sheet.experience) or 0;

				form.edtTotalXP.text = tostring(spent + current);
			end;

			-- The log box grows with the rows instead of scrolling four columns apart from
			-- each other: the tab's scrollBox does the scrolling, so line N stays line N in
			-- all four. The XML height is the floor - shrinking would leave a hole in the box.
			local XP_ROW_H    = 20;
			local XP_LOG_MIN_H = 470;
			local XP_LOG_PAD  = 65;

			-- ---- Experience log (SPEC I10, 27th round) ---------------------------------
			--
			-- Four columns, all four written from ONE row list, so a line reads across. They
			-- own no `field` (SPEC V84): the log is derived from the saved initial character
			-- and the sheet as it stands, exactly like the total above is derived from the two
			-- numbers beside it. A stored third copy could only drift.
			--
			-- The rows come from xpLedgerRows() on the root form (SPEC I9/I10); this routine
			-- only formats them.
			function renderXPLedger(form)
				if sheet == nil then return; end;

				local lang = sheet.language or "en";
				local rows = xpLedgerRows();

				if rows == nil then
					-- SPEC V33: say WHY it is empty rather than show four blank columns.
					form.dynXpType.text  = translateSheetText("Initial character not saved yet", lang);
					form.dynXpTrait.text = "";
					form.dynXpLevel.text = "";
					form.dynXpCost.text  = "";
					return;
				end;

				local kinds, traits, levels, costs = {}, {}, {}, {};

				for i = 1, #rows, 1 do
					local r = rows[i];

					-- Both columns are written by Lua, so they are translated here (SPEC V70,
					-- same arrangement as the era ability labels): whoever writes a text owns
					-- both languages for it.
					kinds[i]  = translateSheetText(r.kind, lang);
					traits[i] = translateSheetText(r.name, lang);
					levels[i] = tostring(r.level);
					costs[i]  = tostring(r.cost);
				end;

				-- A saved character nobody has spent on yet. Four blank columns read as a broken
				-- tab, so the first one says why it is empty - the same call V33 makes for the
				-- no-baseline case above (SPEC V98).
				if #rows == 0 then kinds[1] = translateSheetText("Nothing bought yet", lang); end;

				form.dynXpType.text  = table.concat(kinds, "\n");
				form.dynXpTrait.text = table.concat(traits, "\n");
				form.dynXpLevel.text = table.concat(levels, "\n");
				form.dynXpCost.text  = table.concat(costs, "\n");

				local h = XP_LOG_MIN_H;

				if #rows * XP_ROW_H + 12 > h then h = #rows * XP_ROW_H + 12; end;

				form.dynXpType.height  = h;
				form.dynXpTrait.height = h;
				form.dynXpLevel.height = h;
				form.dynXpCost.height  = h;
				form.xpLogBox.height   = h + XP_LOG_PAD;
			end;
		]]>
	</script>
	<scrollBox align="client">
		<!-- Theme backdrop, same arrangement as HH.1 (SPEC T158, V56, V57). -->
		<image name="themePaper9" align="client" style="stretch" hitTest="false" visible="false"/>
		<!--
			Progress tab (SPEC T106). Current Experience is a MIRROR of the box on the Main tab -
			the same `field="experience"`, so the NDB keeps both in step with no Lua (SPEC V36,
			declared under ESPELHOS in I3). SPEC V1 otherwise forbids two owners of one field.
		-->
		<!--
			The three numbers sit side by side (SPEC T140): one column each, same label width and
			same edit column, so the three edits line up (SPEC V26). The box spans the full tab
			width, which is what the log box below is aligned to.
		-->
		<!--
			Three columns of 336, each holding its label with the number CENTRED UNDER IT rather than
			beside it (SPEC T151). The title sits 10 off the top edge and the data starts 8 under it:
			room above the heading, none wasted between the heading and what it names.

			Stacking costs height - the box went 75 -> 95 - which is why the log below starts at 105
			and still closes the tab on 640.
		-->
		<layout left="0" top="0" width="1040" height="95">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="0" top="10" width="1040" height="20" text="EXPERIENCE" horzTextAlign="center"/>

			<label left="15" top="38" width="336" height="20" text="Total Experience" horzTextAlign="center"/>
			<edit name="edtTotalXP" left="138" top="60" width="90" height="25" readOnly="true" horzTextAlign="center" fontSize="14"/>

			<label left="352" top="38" width="336" height="20" text="Spent Experience" horzTextAlign="center"/>
			<edit left="475" top="60" width="90" height="25" field="spentXP" horzTextAlign="center" fontSize="14"/>

			<label left="689" top="38" width="336" height="20" text="Current Experience" horzTextAlign="center"/>
			<edit left="812" top="60" width="90" height="25" field="experience" horzTextAlign="center" fontSize="14"/>
		</layout>

		<!--
			The log is now four columns instead of one free-text box (SPEC I10, 27th round):
			what was raised, which trait, the rating it reached, and what that point cost.
			`xpLog` is gone with the box that owned it and is an ORPHAN from here on (SPEC I3 /
			V91) - the name is never reused, so text typed into the old sheet cannot come back
			up inside a column that means something else.

			The four editors are read-only and carry no `field`: the rows are derived on every
			render (SPEC V83/V84).
		-->
		<layout name="xpLogBox" left="0" top="105" width="1040" height="535">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="0" top="0" width="1040" height="20" text="EXPERIENCE LOG" horzTextAlign="center"/>

			<label left="15" top="25" width="200" height="20" text="Type" horzTextAlign="center"/>
			<label left="225" top="25" width="480" height="20" text="Trait" horzTextAlign="center"/>
			<label left="715" top="25" width="140" height="20" text="Level" horzTextAlign="center"/>
			<label left="865" top="25" width="160" height="20" text="Cost" horzTextAlign="center"/>

			<textEditor name="dynXpType" left="15" top="50" width="200" height="470" readOnly="true"/>
			<textEditor name="dynXpTrait" left="225" top="50" width="480" height="470" readOnly="true"/>
			<textEditor name="dynXpLevel" left="715" top="50" width="140" height="470" readOnly="true"/>
			<textEditor name="dynXpCost" left="865" top="50" width="160" height="470" readOnly="true"/>
		</layout>
	</scrollBox>

	<!-- Two entry points, as everywhere else on this sheet: the link catches later edits, the
	     onNodeReady catches the sheet being opened (SPEC V19 / V33). -->
	<dataLink fields="{'spentXP', 'experience'}" onChange="renderTotalXP(self);"/>

	<!-- What the ledger reads directly: the snapshot itself, the rule that prices backgrounds,
	     and the language its two text columns are written in. This tab watches `language`
	     itself rather than being called from HH.6, because the four columns are declared here
	     and only this form can address them. Dots are watched by the observer below - there
	     are some five hundred of them, and naming every one here would be a list nobody could
	     keep correct. -->
	<dataLink fields="{'baseline', 'stBackgroundsXP', 'language'}" onChange="renderXPLedger(self);"/>

	<!-- The tab is a REPORT, so it is rebuilt every time it comes up (SPEC V97). The dots that
	     feed it live on other tabs and there are some four hundred and sixty of them: the
	     observer below is meant to catch those, but it is an SDK call with no precedent in any
	     sheet in this repo, and while it silently did nothing the log stayed frozen at whatever
	     it showed when the sheet loaded - four blank columns (SPEC B28). Correctness hangs on
	     this event, not on the observer. -->
	<event name="onShow">
		renderTotalXP(self);
		renderXPLedger(self);
	</event>

	<event name="onNodeReady">
		renderTotalXP(self);
		renderXPLedger(self);

		-- One observer for the whole sheet: every dot on every tab feeds this table, so the
		-- log follows the sheet instead of a hand-written list of fields. Kept in a global so
		-- it is not collected while the sheet is open.
		xpLedgerObserver = ndb.newObserver(sheet);
		xpLedgerObserver.onChanged = function(node, attribute, oldValue)
			renderXPLedger(self);
		end;
	</event>
</form>
