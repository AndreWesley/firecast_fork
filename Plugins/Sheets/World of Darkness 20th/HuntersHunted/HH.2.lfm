<?xml version="1.0" encoding="UTF-8"?>
<form name="frmHH_2" align="client" theme="dark">
	<scrollBox align="client">

		<template name="Trait">
			<edit left="0" top="5" width="95" height="20" field="$(field)" fontSize="12"/>
			<imageCheckBox left="100" top="0" width="25" height="25" field="$(field)_1" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
			<imageCheckBox left="125" top="0" width="25" height="25" field="$(field)_2" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
			<imageCheckBox left="150" top="0" width="25" height="25" field="$(field)_3" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
			<imageCheckBox left="175" top="0" width="25" height="25" field="$(field)_4" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
			<imageCheckBox left="200" top="0" width="25" height="25" field="$(field)_5" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
		</template>

		<template name="Merit">
			<edit left="0" top="0" width="200" height="24" field="merit_$(num)"/>
			<edit left="200" top="0" width="100" height="24" field="type_$(num)"/>
			<edit left="300" top="0" width="50" height="24" field="costy_$(num)"/>
		</template>

		<layout left="0" top="0" width="255" height="330">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="5" top="0" width="240" height="20" text="NUMINA &amp; OTHER TRAITS" horzTextAlign="center"/>

			<layout left="15" top="25" width="225" height="25" >
				<Trait field="numina_1"/>
			</layout>
			<layout left="15" top="50" width="225" height="25" >
				<Trait field="numina_2"/>
			</layout>
			<layout left="15" top="75" width="225" height="25" >
				<Trait field="numina_3"/>
			</layout>
			<layout left="15" top="100" width="225" height="25" >
				<Trait field="numina_4"/>
			</layout>
			<layout left="15" top="125" width="225" height="25" >
				<Trait field="numina_5"/>
			</layout>
			<layout left="15" top="150" width="225" height="25" >
				<Trait field="numina_6"/>
			</layout>
			<layout left="15" top="175" width="225" height="25" >
				<Trait field="numina_7"/>
			</layout>
			<layout left="15" top="200" width="225" height="25" >
				<Trait field="numina_8"/>
			</layout>
			<layout left="15" top="225" width="225" height="25" >
				<Trait field="numina_9"/>
			</layout>
			<layout left="15" top="250" width="225" height="25" >
				<Trait field="numina_10"/>
			</layout>
			<layout left="15" top="275" width="225" height="25" >
				<Trait field="numina_11"/>
			</layout>
		</layout>

		<textEditor left="0" top="340" width="255" height="200" field="numinaNotes"/>

		<layout left="0" top="550" width="800" height="270">
			<rectangle align="client" color="#FFFFFF00" strokeColor="black" strokeSize="1" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="800" height="20" text="MERITS AND FLAWS" horzTextAlign="center"/>

			<layout left="15" top="25" width="380" height="240">
				<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
				<label left="15" top="0" width="200" height="20" text="Merit" horzTextAlign="center"/>
				<label left="215" top="0" width="100" height="20" text="Type" horzTextAlign="center"/>
				<label left="315" top="0" width="50" height="20" text="Cost" horzTextAlign="center"/>

				<layout left="15" top="25" width="350" height="25" >
					<Merit num="m1"/>
				</layout>
				<layout left="15" top="50" width="350" height="25" >
					<Merit num="m2"/>
				</layout>
				<layout left="15" top="75" width="350" height="25" >
					<Merit num="m3"/>
				</layout>
				<layout left="15" top="100" width="350" height="25" >
					<Merit num="m4"/>
				</layout>
				<layout left="15" top="125" width="350" height="25" >
					<Merit num="m5"/>
				</layout>
				<layout left="15" top="150" width="350" height="25" >
					<Merit num="m6"/>
				</layout>
				<layout left="15" top="175" width="350" height="25" >
					<Merit num="m7"/>
				</layout>
				<layout left="15" top="200" width="350" height="25" >
					<Merit num="m8"/>
				</layout>
			</layout>

			<layout left="405" top="25" width="380" height="240">
				<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
				<label left="15" top="0" width="200" height="20" text="Flaw" horzTextAlign="center"/>
				<label left="215" top="0" width="100" height="20" text="Type" horzTextAlign="center"/>
				<label left="315" top="0" width="50" height="20" text="Cost" horzTextAlign="center"/>

				<layout left="15" top="25" width="350" height="25" >
					<Merit num="f1"/>
				</layout>
				<layout left="15" top="50" width="350" height="25" >
					<Merit num="f2"/>
				</layout>
				<layout left="15" top="75" width="350" height="25" >
					<Merit num="f3"/>
				</layout>
				<layout left="15" top="100" width="350" height="25" >
					<Merit num="f4"/>
				</layout>
				<layout left="15" top="125" width="350" height="25" >
					<Merit num="f5"/>
				</layout>
				<layout left="15" top="150" width="350" height="25" >
					<Merit num="f6"/>
				</layout>
				<layout left="15" top="175" width="350" height="25" >
					<Merit num="f7"/>
				</layout>
				<layout left="15" top="200" width="350" height="25" >
					<Merit num="f8"/>
				</layout>
			</layout>
		</layout>

		<layout left="1050" top="550" width="230" height="270">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="230" height="20" text="DERANGEMENTS" horzTextAlign="center"/>

			<textEditor left="15" top="25" width="200" height="230" field="derangements"/>
		</layout>

		<layout left="0" top="830" width="240" height="165">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="240" height="20" text="ALLIES" horzTextAlign="center"/>

			<textEditor left="15" top="25" width="200" height="125" field="allies"/>
		</layout>

		<layout left="0" top="1005" width="240" height="165">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="240" height="20" text="MENTOR" horzTextAlign="center"/>

			<textEditor left="15" top="25" width="200" height="125" field="mentor"/>
		</layout>

		<layout left="250" top="830" width="240" height="165">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="240" height="20" text="CONTACTS" horzTextAlign="center"/>

			<textEditor left="15" top="25" width="200" height="125" field="contacts"/>
		</layout>

		<layout left="250" top="1005" width="240" height="165">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="240" height="20" text="RESOURCES" horzTextAlign="center"/>

			<textEditor left="15" top="25" width="200" height="125" field="resources"/>
		</layout>

		<layout left="500" top="830" width="240" height="165">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="240" height="20" text="FAME" horzTextAlign="center"/>

			<textEditor left="15" top="25" width="200" height="125" field="fame"/>
		</layout>

		<layout left="500" top="1005" width="240" height="165">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="240" height="20" text="RETAINERS" horzTextAlign="center"/>

			<textEditor left="15" top="25" width="200" height="125" field="retainers"/>
		</layout>

		<layout left="750" top="1005" width="240" height="165">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="240" height="20" text="STATUS" horzTextAlign="center"/>

			<textEditor left="15" top="25" width="200" height="125" field="status"/>
		</layout>

		<layout left="1000" top="830" width="240" height="165">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="240" height="20" text="INFLUENCE" horzTextAlign="center"/>

			<textEditor left="15" top="25" width="200" height="125" field="influence"/>
		</layout>

		<layout left="1000" top="1005" width="240" height="165">
			<rectangle align="client" color="black" xradius="10" yradius="10" cornerType="innerLine"/>
			<label left="0" top="0" width="240" height="20" text="OTHER" horzTextAlign="center"/>

			<!-- ponytail: the plain "other" field name is already owned by HH.3.lfm sheet-wide; renamed to bgOther per §V1 -->
			<textEditor left="15" top="25" width="200" height="125" field="bgOther"/>
		</layout>

	</scrollBox>
</form>
