<?xml version="1.0" encoding="UTF-8"?>
<form name="frmHH_10" align="client" theme="dark">
	<script>
		<![CDATA[
			-- Storyteller tab (SPEC I8, 27th round). Only the storyteller of the room sees it;
			-- the gate that decides that lives on the root form (SPEC I8a/V79), because HH.6
			-- calls it too.
			--
			-- Saving the initial character is the one irreversible action on this sheet, so it
			-- asks first (SPEC R30) and refuses to run twice (SPEC V81).
			function saveBaseline(form)
				if sheet == nil then return; end;

				-- The button is disabled once a baseline exists, so reaching this with one
				-- already saved means a second client had the tab open when the first saved.
				if sheet.baseline ~= nil and sheet.baseline ~= "" then
					renderBaselineState(form);
					return;
				end;

				local lang = sheet.language or "en";

				Dialogs.confirmOkCancel(
					translateSheetText("Save the initial character? This cannot be undone.", lang),
					function(confirmed)
						if not confirmed then return; end;

						-- Checked again on the way in: the dialog is modal for this client only.
						if sheet.baseline ~= nil and sheet.baseline ~= "" then return; end;

						-- The whole sheet, as it stands, in one field (SPEC R32). `baseline` is
						-- empty at this moment, which is what stops the snapshot from nesting.
						sheet.baseline = ndb.exportXML(sheet);

						renderBaselineState(form);
					end);
			end;

			-- SPEC V82: once saved, the button goes dead and says so. A button that still looks
			-- live but does nothing is the failure V33 exists to stop.
			function renderBaselineState(form)
				if sheet == nil then return; end;

				local saved = sheet.baseline ~= nil and sheet.baseline ~= "";
				local lang  = sheet.language or "en";

				form.btnSaveBaseline.enabled = not saved;

				if saved then
					form.dynBaselineState.text = translateSheetText("Initial character saved", lang);
				else
					form.dynBaselineState.text = translateSheetText("Not saved yet", lang);
				end;
			end;
		]]>
	</script>
	<scrollBox align="client">
		<!-- Theme backdrop, same arrangement as every other tab (SPEC T158, V56, V57). -->
		<image name="themePaper10" align="client" style="stretch" hitTest="false" visible="false"/>

		<layout left="0" top="0" width="520" height="240">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="0" top="4" width="520" height="20" text="STORYTELLER SETTINGS" horzTextAlign="center"/>

			<label left="15" top="45" width="200" height="20" text="Save Initial Character"/>
			<button name="btnSaveBaseline" left="225" top="42" width="100" height="26" text="Save" onClick="saveBaseline(self);"/>
			<!-- dyn*: written by Lua, so the language traversal leaves it alone (SPEC V31). -->
			<label name="dynBaselineState" left="335" top="45" width="170" height="20" text=""/>

			<!-- Backgrounds are free by default: the storyteller opts INTO charging for them
			     (SPEC C, I9). The other three decide which power tabs the table can see. -->
			<checkBox name="chkBackgroundsXP" left="15" top="90" width="490" height="25" field="stBackgroundsXP" text="Can Buy Backgrounds With Experience"/>
			<checkBox name="chkShowNumina" left="15" top="120" width="490" height="25" field="stShowNumina" text="Show Numina"/>
			<checkBox name="chkShowDisciplines" left="15" top="150" width="490" height="25" field="stShowDisciplines" text="Show Disciplines"/>
			<checkBox name="chkShowMagika" left="15" top="180" width="490" height="25" field="stShowMagika" text="Show Magika"/>
		</layout>
	</scrollBox>

	<dataLink field="baseline">
		<event name="onChange">
			renderBaselineState(self);
		</event>
	</dataLink>

	<!--
		The three show-a-tab flags are OWNED here and watched from the root form (SPEC V95,
		28th round). This tab is itself one of the four the switch hides, so it cannot be
		the thing that runs the switch: on a sheet where it never came up, nothing hid the
		other three (SPEC B26). What is left here only renders this tab's own state.
	-->
	<event name="onNodeReady">
		renderBaselineState(self);
	</event>
</form>
