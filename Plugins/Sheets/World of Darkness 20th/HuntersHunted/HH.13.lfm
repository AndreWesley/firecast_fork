				<SecPathRow field="secPath_14"/>
			</layout>
			<layout left="12" top="375" width="500" height="25">
				<SecPathRow field="secPath_15"/>
			</layout>
		</layout>

		<layout left="535" top="0" width="850" height="610">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="0" top="4" width="850" height="20" text="DESCRIPTION" horzTextAlign="center"/>
			<textEditor name="edtPathDesc" left="10" top="25" width="830" height="575" readOnly="true" opacity="0.55" wordWrap="true" transparent="true" fontSize="12"/>
		</layout>
	</scrollBox>

	<dataLink fields="{'language', 'pathSel', 'mainPath_1', 'mainPath_2', 'mainPath_3', 'mainPath_4', 'mainPath_5', 'secPath_1', 'secPath_2', 'secPath_3', 'secPath_4', 'secPath_5', 'secPath_6', 'secPath_7', 'secPath_8', 'secPath_9', 'secPath_10', 'secPath_11', 'secPath_12', 'secPath_13', 'secPath_14', 'secPath_15'}" onChange="renderPathDesc(self);"/>

	<!--
		The five main path dots follow the Discipline, recomputed on every render and stored
		nowhere (SPEC V180), so this link watches what renderMainPaths actually READS and
		nothing else (SPEC V123): the five path slots, the nineteen Discipline slots, and the
		dots of those nineteen - the rating is the dots, so a bought dot has to reach here.

		It is a link of its own rather than fields bolted onto the description link above:
		that one repaints prose from `language` and the picker rows, and hanging ninety-five
		dot fields on it would repaint the description every time anyone bought anything
		(SPEC V123, the mistake B34 records).
	-->
	<dataLink fields="{'mainPath_1', 'mainPath_2', 'mainPath_3', 'mainPath_4', 'mainPath_5', 'clanDisc_1', 'clanDisc_2', 'clanDisc_3', 'clanDisc_4', 'disc_1', 'disc_2', 'disc_3', 'disc_4', 'disc_5', 'disc_6', 'disc_7', 'disc_8', 'disc_9', 'disc_10', 'disc_11', 'disc_12', 'disc_13', 'disc_14', 'disc_15', 'clanDisc_1_1', 'clanDisc_1_2', 'clanDisc_1_3', 'clanDisc_1_4', 'clanDisc_1_5', 'clanDisc_2_1', 'clanDisc_2_2', 'clanDisc_2_3', 'clanDisc_2_4', 'clanDisc_2_5', 'clanDisc_3_1', 'clanDisc_3_2', 'clanDisc_3_3', 'clanDisc_3_4', 'clanDisc_3_5', 'clanDisc_4_1', 'clanDisc_4_2', 'clanDisc_4_3', 'clanDisc_4_4', 'clanDisc_4_5', 'disc_1_1', 'disc_1_2', 'disc_1_3', 'disc_1_4', 'disc_1_5', 'disc_2_1', 'disc_2_2', 'disc_2_3', 'disc_2_4', 'disc_2_5', 'disc_3_1', 'disc_3_2', 'disc_3_3', 'disc_3_4', 'disc_3_5', 'disc_4_1', 'disc_4_2', 'disc_4_3', 'disc_4_4', 'disc_4_5', 'disc_5_1', 'disc_5_2', 'disc_5_3', 'disc_5_4', 'disc_5_5', 'disc_6_1', 'disc_6_2', 'disc_6_3', 'disc_6_4', 'disc_6_5', 'disc_7_1', 'disc_7_2', 'disc_7_3', 'disc_7_4', 'disc_7_5', 'disc_8_1', 'disc_8_2', 'disc_8_3', 'disc_8_4', 'disc_8_5', 'disc_9_1', 'disc_9_2', 'disc_9_3', 'disc_9_4', 'disc_9_5', 'disc_10_1', 'disc_10_2', 'disc_10_3', 'disc_10_4', 'disc_10_5', 'disc_11_1', 'disc_11_2', 'disc_11_3', 'disc_11_4', 'disc_11_5', 'disc_12_1', 'disc_12_2', 'disc_12_3', 'disc_12_4', 'disc_12_5', 'disc_13_1', 'disc_13_2', 'disc_13_3', 'disc_13_4', 'disc_13_5', 'disc_14_1', 'disc_14_2', 'disc_14_3', 'disc_14_4', 'disc_14_5', 'disc_15_1', 'disc_15_2', 'disc_15_3', 'disc_15_4', 'disc_15_5'}" onChange="renderMainPaths(self);"/>

	<!--
		The picker guard (SPEC V181/V182/V185). It hangs off a dataLink and NOT off the
		comboBox onChange, because a write made inside a control's own dispatch does not
		survive it - that is how B36 and B38 both let a refusal be ignored (SPEC V186).

		Only the twenty picker fields are watched. Taking a Discipline OFF the sheet does
		not come through here on purpose: it would clear rows the player already filled,
		and the main path dots going dark already show that something is missing (V180).
	-->
	<dataLink fields="{'mainPath_1', 'mainPath_2', 'mainPath_3', 'mainPath_4', 'mainPath_5', 'secPath_1', 'secPath_2', 'secPath_3', 'secPath_4', 'secPath_5', 'secPath_6', 'secPath_7', 'secPath_8', 'secPath_9', 'secPath_10', 'secPath_11', 'secPath_12', 'secPath_13', 'secPath_14', 'secPath_15'}" onChange="guardPick(field, oldValue, newValue);"/>

	<event name="onNodeReady">
		renderPathDesc(self);
		renderMainPaths(self);
	</event>
</form>
